cmake_minimum_required(VERSION 3.14)

if(NOT DEFINED ASSET_COOK_EXE OR NOT DEFINED SOURCE_ROOT OR NOT DEFINED SMOKE_DIR)
    message(FATAL_ERROR "AssetCookTerrainSmoke requires ASSET_COOK_EXE, SOURCE_ROOT and SMOKE_DIR")
endif()

file(REMOVE_RECURSE "${SMOKE_DIR}")
file(MAKE_DIRECTORY "${SMOKE_DIR}/Spec" "${SMOKE_DIR}/Cooked")
configure_file(
    "${SOURCE_ROOT}/Test/Core/Asset/Fixtures/Terrain/height_formula_33x33_16bit.png"
    "${SMOKE_DIR}/Spec/height_formula_33x33_16bit.png"
    COPYONLY)
file(WRITE "${SMOKE_DIR}/Spec/terrain.json" [=[{
  "version": 1,
  "height_source": { "path": "height_formula_33x33_16bit.png", "format": "png16", "flip_z": false },
  "height_mapping": { "min_m": 0.0, "max_m": 65.535 },
  "cell_size_m": 1.0, "tile_cells": 16, "fit": "error", "require_bit_depth": 16, "seed": 1, "recipe": {}
}
]=])

set(cook_args
    --input "${SMOKE_DIR}/Spec/terrain.json"
    --out "${SMOKE_DIR}/Cooked/Smoke.nvpkg"
    --manifest "${SMOKE_DIR}/manifest.json"
    --logical Terrain/Smoke/Smoke.nvtrn
    --kind world
    --entry Terrain/Smoke/Smoke.nvtrn
    --format nvtrn.v0.height16)
execute_process(
    COMMAND "${ASSET_COOK_EXE}" ${cook_args} --entry-type Trn0
    RESULT_VARIABLE cook_result
    OUTPUT_VARIABLE cook_output
    ERROR_VARIABLE cook_error)
file(WRITE "${SMOKE_DIR}/cook-stderr.txt" "${cook_error}")
if(NOT cook_result EQUAL 0)
    message(FATAL_ERROR "terrain cook failed (${cook_result}): ${cook_output}${cook_error}")
endif()
foreach(expected IN ITEMS "AssetCook wrote world" "tiles=2x2")
    string(FIND "${cook_error}" "${expected}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "terrain cook stderr is missing ${expected}: ${cook_error}")
    endif()
endforeach()

file(READ "${SMOKE_DIR}/manifest.json" manifest)
foreach(field_and_value IN ITEMS
        "kind;world"
        "entry_type;Trn0"
        "format;nvtrn.v0.height16")
    list(GET field_and_value 0 field)
    list(GET field_and_value 1 value)
    string(REPLACE "." "\\." value_regex "${value}")
    string(REGEX MATCH "\"${field}\"[ \t\r\n]*:[ \t\r\n]*\"${value_regex}\"" match "${manifest}")
    if(NOT match)
        message(FATAL_ERROR "terrain manifest is missing ${field}=${value}: ${manifest}")
    endif()
endforeach()
foreach(field IN ITEMS cooked_hash source_hash)
    string(REGEX MATCH "\"${field}\"[ \t\r\n]*:[ \t\r\n]*\"([0-9a-fA-F]+)\"" match "${manifest}")
    set(hash "${CMAKE_MATCH_1}")
    string(LENGTH "${hash}" hash_length)
    if(NOT match OR NOT hash_length EQUAL 16)
        message(FATAL_ERROR "terrain manifest ${field} must be 16 hexadecimal digits: ${manifest}")
    endif()
endforeach()

execute_process(
    COMMAND "${ASSET_COOK_EXE}" ${cook_args} --entry-type Raw
    RESULT_VARIABLE invalid_result
    OUTPUT_VARIABLE invalid_output
    ERROR_VARIABLE invalid_error)
if(invalid_result EQUAL 0)
    message(FATAL_ERROR "terrain cook accepted --entry-type Raw")
endif()
string(FIND "${invalid_error}" "--kind world requires --entry-type Trn0" invalid_position)
if(invalid_position EQUAL -1)
    message(FATAL_ERROR "terrain cook rejected Raw for an unexpected reason: ${invalid_output}${invalid_error}")
endif()

# 同じ地形 spec の先頭と最後の区画を NVMESH に焼き、出力と manifest を確かめる。
function(cook_nvtrn_tile case_name input_path tile expected_tiles)
    set(package "${SMOKE_DIR}/Cooked/${case_name}.nvpkg")
    set(manifest_path "${SMOKE_DIR}/${case_name}.manifest.json")
    execute_process(
        COMMAND "${ASSET_COOK_EXE}"
            --input "${input_path}"
            --out "${package}"
            --manifest "${manifest_path}"
            --logical Terrain/Smoke/Tile.nvmesh
            --kind model
            --entry Terrain/Smoke/Tile.nvmesh
            --entry-type Msh0
            --format nvmesh.v1.mesh3d.pnt.u32.lodgraph
            --variant default
            --generate "terrain-tile:nvtrn:${tile}"
        RESULT_VARIABLE result
        OUTPUT_VARIABLE stdout
        ERROR_VARIABLE stderr)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "地形区画 ${case_name} の cook が失敗しました (${result}): ${stdout}${stderr}")
    endif()
    string(FIND "${stdout}" "TERRAIN_NVTRN_TILE tile=${tile} tiles=${expected_tiles} vertices=289 triangles=512" summary_position)
    if(summary_position EQUAL -1)
        message(FATAL_ERROR "地形区画 ${case_name} の要約がありません: ${stdout}${stderr}")
    endif()
    if(NOT EXISTS "${package}" OR NOT EXISTS "${manifest_path}")
        message(FATAL_ERROR "地形区画 ${case_name} のパッケージか manifest がありません")
    endif()
    file(SIZE "${package}" package_size)
    if(package_size EQUAL 0)
        message(FATAL_ERROR "地形区画 ${case_name} のパッケージが空です")
    endif()
    file(READ "${manifest_path}" tile_manifest)
    string(REGEX MATCH "\"kind\"[ \t\r\n]*:[ \t\r\n]*\"model\"" kind_match "${tile_manifest}")
    if(NOT kind_match)
        message(FATAL_ERROR "地形区画 ${case_name} の manifest は kind=model ではありません: ${tile_manifest}")
    endif()
    string(REGEX MATCH "\"source_hash\"[ \t\r\n]*:[ \t\r\n]*\"([0-9a-fA-F]+)\"" hash_match "${tile_manifest}")
    if(NOT hash_match)
        message(FATAL_ERROR "地形区画 ${case_name} の manifest に source hash がありません: ${tile_manifest}")
    endif()
    set("${case_name}_source_hash" "${CMAKE_MATCH_1}" PARENT_SCOPE)
    message(STATUS "地形区画 ${case_name}: ${stdout}")
endfunction()

cook_nvtrn_tile(tile_first "${SMOKE_DIR}/Spec/terrain.json" "0,0" "2x2")
cook_nvtrn_tile(tile_last "${SMOKE_DIR}/Spec/terrain.json" "1,1" "2x2")

# world のパッケージから NVTRN を取り出し、生の NVTRN と spec の両方を通す。
set(extract_script "${SMOKE_DIR}/extract-terrain.ps1")
string(ASCII 239 187 191 utf8_bom)
file(WRITE "${extract_script}" "${utf8_bom}" [=[
param([string]$PackagePath, [string]$TerrainPath, [string]$BrokenPath, [string]$GridPath)
$ErrorActionPreference = 'Stop'
$bytes = [System.IO.File]::ReadAllBytes($PackagePath)
if ($bytes.Length -lt 96 -or [BitConverter]::ToUInt32($bytes, 32) -ne 1) { throw '地形パッケージが不正です' }
$table = [int][BitConverter]::ToUInt64($bytes, 40)
if ($table -lt 0 -or $table + 64 -gt $bytes.Length) { throw 'エントリ表が不正です' }
$offset = [int][BitConverter]::ToUInt64($bytes, $table + 24)
$size = [int][BitConverter]::ToUInt64($bytes, $table + 32)
if ($offset -lt 0 -or $size -lt 8 -or $offset -gt $bytes.Length - $size) { throw '地形データが不正です' }
$terrain = New-Object byte[] $size
[Array]::Copy($bytes, $offset, $terrain, 0, $size)
[System.IO.File]::WriteAllBytes($TerrainPath, $terrain)
$terrain[$size - 1] = $terrain[$size - 1] -bxor 1
[System.IO.File]::WriteAllBytes($BrokenPath, $terrain)
$grid = New-Object byte[] (49 * 33 * 2)
for ($i = 0; $i -lt 49 * 33; ++$i)
{
    $grid[2 * $i] = [byte]($i -band 0xff)
    $grid[2 * $i + 1] = [byte](($i -shr 8) -band 0xff)
}
[System.IO.File]::WriteAllBytes($GridPath, $grid)
]=])
execute_process(
    COMMAND powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "${extract_script}"
        "${SMOKE_DIR}/Cooked/Smoke.nvpkg" "${SMOKE_DIR}/terrain.nvtrn" "${SMOKE_DIR}/broken.nvtrn"
        "${SMOKE_DIR}/Spec/fractional.raw"
    RESULT_VARIABLE extract_result
    OUTPUT_VARIABLE extract_output
    ERROR_VARIABLE extract_error)
if(NOT "${extract_result}" STREQUAL "0")
    message(FATAL_ERROR "地形の取り出しに失敗しました (${extract_result}): ${extract_output}${extract_error}")
endif()
cook_nvtrn_tile(tile_raw "${SMOKE_DIR}/terrain.nvtrn" "0,0" "2x2")

# 0.1 m 間隔の 3 区画の端は float への丸めで格子の外へ出る。
file(WRITE "${SMOKE_DIR}/Spec/fractional.json" [=[{
  "version": 1,
  "height_source": { "path": "fractional.raw", "format": "raw16", "width": 49, "height": 33, "endian": "little" },
  "height_mapping": { "min_m": 0.0, "max_m": 65.535 },
  "cell_size_m": 0.1, "tile_cells": 16, "fit": "error", "require_bit_depth": 16, "seed": 1, "recipe": {}
}
]=])
cook_nvtrn_tile(tile_fractional "${SMOKE_DIR}/Spec/fractional.json" "2,1" "3x2")
file(SHA256 "${SMOKE_DIR}/Cooked/tile_first.nvpkg" spec_package_hash)
file(SHA256 "${SMOKE_DIR}/Cooked/tile_raw.nvpkg" raw_package_hash)
if(NOT spec_package_hash STREQUAL raw_package_hash OR NOT tile_first_source_hash STREQUAL tile_raw_source_hash)
    message(FATAL_ERROR "地形 spec と NVTRN のメッシュまたは source hash が一致しません")
endif()

function(expect_nvtrn_tile_failure case_name input_path tile expected)
    execute_process(
        COMMAND "${ASSET_COOK_EXE}"
            --input "${input_path}"
            --out "${SMOKE_DIR}/Cooked/${case_name}.nvpkg"
            --manifest "${SMOKE_DIR}/${case_name}.manifest.json"
            --logical Terrain/Smoke/Tile.nvmesh
            --kind model
            --entry Terrain/Smoke/Tile.nvmesh
            --entry-type Msh0
            --format nvmesh.v1.mesh3d.pnt.u32.lodgraph
            --variant default
            --generate "terrain-tile:nvtrn:${tile}"
        RESULT_VARIABLE result
        OUTPUT_VARIABLE stdout
        ERROR_VARIABLE stderr)
    if("${result}" STREQUAL "0" OR NOT "${result}" MATCHES "^[0-9]+$")
        message(FATAL_ERROR "地形区画 ${case_name} が正常に拒否されませんでした (${result}): ${stdout}${stderr}")
    endif()
    string(FIND "${stdout}${stderr}" "${expected}" diagnostic_position)
    if(diagnostic_position EQUAL -1)
        message(FATAL_ERROR "地形区画 ${case_name} の拒否理由が想定と違います: ${stdout}${stderr}")
    endif()
    message(STATUS "地形区画 ${case_name} を終了コード ${result} で拒否しました")
endfunction()

expect_nvtrn_tile_failure(tile_out_of_range "${SMOKE_DIR}/Spec/terrain.json" "2,0" "tiles=2x2")
expect_nvtrn_tile_failure(tile_broken "${SMOKE_DIR}/broken.nvtrn" "0,0" "NVTRN")

# 地形 manifest と同じ cooked_hash を記録した散布を焼く。
string(REGEX MATCH "\"cooked_hash\"[ \t\r\n]*:[ \t\r\n]*\"([0-9a-fA-F]+)\"" terrain_hash_match "${manifest}")
set(terrain_hash "${CMAKE_MATCH_1}")
set(scatter_spec "{\"version\":0,\"terrain\":{\"path\":\"terrain.json\",\"cooked_hash\":\"${terrain_hash}\"},
\"chunk_size_m\":16,\"seed\":12345,\"species\":[{\"name\":\"rock\",\"render_path\":\"mega\",\"lods\":[\"Meshes/Rock\"],
\"mesh_radius_m\":0.6,\"density\":{\"source\":\"constant\",\"value\":1},\"base_density_per_m2\":0.01,
\"scale_range\":[0.7,1.4],\"slope_follow\":0.8,\"brightness_variation\":0.1}]}")
file(WRITE "${SMOKE_DIR}/Spec/scatter.json" "${scatter_spec}")
set(scatter_args
    --input "${SMOKE_DIR}/Spec/scatter.json"
    --out "${SMOKE_DIR}/Cooked/Scatter.nvpkg"
    --manifest "${SMOKE_DIR}/scatter.manifest.json"
    --logical Scatter/Smoke.nvsct --kind world --entry Scatter/Smoke.nvsct --format nvsct.v0.inst16)
execute_process(COMMAND "${ASSET_COOK_EXE}" ${scatter_args} --entry-type Sct0
    RESULT_VARIABLE scatter_result OUTPUT_VARIABLE scatter_output ERROR_VARIABLE scatter_error)
if(NOT "${scatter_result}" STREQUAL "0")
    message(FATAL_ERROR "散布の cook が失敗しました (${scatter_result}): ${scatter_output}${scatter_error}")
endif()
string(FIND "${scatter_output}" "SCATTER_COOKED chunks=4 species=1 instances=" summary_position)
if(summary_position EQUAL -1)
    message(FATAL_ERROR "散布の cook の要約がありません: ${scatter_output}")
endif()
file(SIZE "${SMOKE_DIR}/Cooked/Scatter.nvpkg" scatter_size)
if(scatter_size EQUAL 0)
    message(FATAL_ERROR "散布のパッケージが空です")
endif()
file(READ "${SMOKE_DIR}/scatter.manifest.json" scatter_manifest)
foreach(field_and_value IN ITEMS "kind;world" "entry_type;Sct0" "format;nvsct.v0.inst16")
    list(GET field_and_value 0 field)
    list(GET field_and_value 1 value)
    string(REPLACE "." "\\." value_regex "${value}")
    string(REGEX MATCH "\"${field}\"[ \t\r\n]*:[ \t\r\n]*\"${value_regex}\"" match "${scatter_manifest}")
    if(NOT match)
        message(FATAL_ERROR "散布の manifest に ${field}=${value} がありません: ${scatter_manifest}")
    endif()
endforeach()
foreach(field IN ITEMS cooked_hash source_hash)
    string(REGEX MATCH "\"${field}\"[ \t\r\n]*:[ \t\r\n]*\"([0-9a-fA-F]+)\"" match "${scatter_manifest}")
    string(LENGTH "${CMAKE_MATCH_1}" hash_length)
    if(NOT match OR NOT hash_length EQUAL 16)
        message(FATAL_ERROR "散布の manifest の ${field} が16桁の16進数ではありません: ${scatter_manifest}")
    endif()
endforeach()
execute_process(COMMAND "${ASSET_COOK_EXE}" ${scatter_args} --entry-type Trn0
    RESULT_VARIABLE invalid_scatter_result OUTPUT_VARIABLE invalid_scatter_output ERROR_VARIABLE invalid_scatter_error)
if(NOT "${invalid_scatter_result}" MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "散布が不正な entry type を拒否しませんでした: ${invalid_scatter_output}${invalid_scatter_error}")
endif()
string(FIND "${invalid_scatter_error}" "--entry-type Sct0" type_position)
if(type_position EQUAL -1)
    message(FATAL_ERROR "散布の entry type の拒否理由が想定と違います: ${invalid_scatter_error}")
endif()
string(SUBSTRING "${terrain_hash}" 0 1 first_digit)
string(SUBSTRING "${terrain_hash}" 1 15 hash_tail)
if(first_digit STREQUAL "0")
    set(wrong_hash "1${hash_tail}")
else()
    set(wrong_hash "0${hash_tail}")
endif()
string(REPLACE "${terrain_hash}" "${wrong_hash}" stale_spec "${scatter_spec}")
file(WRITE "${SMOKE_DIR}/Spec/scatter.json" "${stale_spec}")
execute_process(COMMAND "${ASSET_COOK_EXE}" ${scatter_args} --entry-type Sct0
    RESULT_VARIABLE stale_result OUTPUT_VARIABLE stale_output ERROR_VARIABLE stale_error)
if(NOT "${stale_result}" MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "散布が食い違う地形の cooked_hash を拒否しませんでした: ${stale_output}${stale_error}")
endif()
foreach(expected IN ITEMS "${terrain_hash}" "${wrong_hash}")
    string(FIND "${stale_error}" "${expected}" mismatch_position)
    if(mismatch_position EQUAL -1)
        message(FATAL_ERROR "散布の拒否理由に cooked_hash ${expected} がありません: ${stale_error}")
    endif()
endforeach()
message(STATUS "散布の cook・manifest・地形ハッシュと entry type の拒否を確認しました")
