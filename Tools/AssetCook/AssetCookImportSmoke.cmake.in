cmake_minimum_required(VERSION 3.14)
if(NOT DEFINED ASSET_COOK_EXE OR NOT DEFINED SOURCE_ROOT OR NOT DEFINED SMOKE_DIR)
    message(FATAL_ERROR "AssetCookImportSmoke requires ASSET_COOK_EXE, SOURCE_ROOT and SMOKE_DIR")
endif()
set(RUN_DIR "${SMOKE_DIR}/ImportSettings")
file(REMOVE_RECURSE "${RUN_DIR}")
file(MAKE_DIRECTORY "${RUN_DIR}/Cooked")
set(MODEL "${RUN_DIR}/model.glb")
set(SIDECAR "${MODEL}.import.json")
set(OVERRIDE "${RUN_DIR}/explicit settings.json")
set(PACKAGE "${RUN_DIR}/Cooked/model.nvpkg")
set(MANIFEST "${RUN_DIR}/manifest.json")
configure_file("${SOURCE_ROOT}/Test/Core/Asset/Fixtures/AssetCook/embedded_tri.glb" "${MODEL}" COPYONLY)
function(cook_import expected reason)
    execute_process(COMMAND "${ASSET_COOK_EXE}"
        --input "${MODEL}" --out "${PACKAGE}" --manifest "${MANIFEST}"
        --logical "Models/import.glb" --kind model --entry "__mesh__" --entry-type Msh0
        --format nvmesh.v0.mesh3d.pnt.u32.clustered --variant default ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(expected)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "import cook failed: ${error}")
        endif()
    else()
        string(FIND "${error}" "${reason}" reason_index)
        if(result EQUAL 0 OR reason_index EQUAL -1)
            message(FATAL_ERROR "expected import rejection '${reason}': ${output} ${error}")
        endif()
        file(SHA256 "${PACKAGE}" after_package)
        file(SHA256 "${MANIFEST}" after_manifest)
        if(NOT saved_package STREQUAL after_package OR NOT saved_manifest STREQUAL after_manifest)
            message(FATAL_ERROR "rejected import modified existing model/manifest")
        endif()
    endif()
endfunction()
function(save_output)
    file(SHA256 "${PACKAGE}" value)
    set(saved_package "${value}" PARENT_SCOPE)
    file(SHA256 "${MANIFEST}" value)
    set(saved_manifest "${value}" PARENT_SCOPE)
endfunction()
cook_import(TRUE "")
save_output()
set(baseline_package "${saved_package}")
set(baseline_manifest "${saved_manifest}")
cook_import(FALSE "import settings rejected:" --require-sidecar)
file(WRITE "${SIDECAR}" "invalid json")
cook_import(FALSE "import settings rejected:" --require-sidecar)
cook_import(TRUE "" --no-sidecar)
save_output()
if(NOT saved_package STREQUAL baseline_package OR NOT saved_manifest STREQUAL baseline_manifest)
    message(FATAL_ERROR "--no-sidecar changed no-settings output")
endif()
file(WRITE "${OVERRIDE}" "{\"version\":1,\"units\":{\"scale\":2}}")
cook_import(TRUE "" --import-settings "${OVERRIDE}" --require-sidecar)
save_output()
if(saved_package STREQUAL baseline_package OR saved_manifest STREQUAL baseline_manifest)
    message(FATAL_ERROR "explicit import settings did not affect cook")
endif()
file(REMOVE "${SIDECAR}")
cook_import(TRUE "" "--import-settings=${OVERRIDE}")
file(SHA256 "${PACKAGE}" equals_package)
file(SHA256 "${MANIFEST}" equals_manifest)
if(NOT equals_package STREQUAL saved_package OR NOT equals_manifest STREQUAL saved_manifest)
    message(FATAL_ERROR "import argument spelling changed output")
endif()
cook_import(FALSE "import settings rejected:" --import-settings "${RUN_DIR}/missing.json")
cook_import(FALSE "--no-sidecar conflicts" --no-sidecar --require-sidecar)
cook_import(FALSE "--no-sidecar conflicts" --import-settings "${OVERRIDE}" --no-sidecar)
cook_import(FALSE "requires a nonempty file path" --import-settings=)
cook_import(FALSE "duplicate import option" --require-sidecar --require-sidecar)
cook_import(FALSE "duplicate import option" --no-sidecar=false)
cook_import(FALSE "import settings options require --kind model" --kind raw --format raw.v0 --no-sidecar)
# 明示設定にも既存の出力alias guardを適用する。
file(SHA256 "${OVERRIDE}" override_before)
cook_import(FALSE "output must not alias import settings" --import-settings "${OVERRIDE}" --out "${OVERRIDE}")
file(SHA256 "${OVERRIDE}" override_after)
if(NOT override_before STREQUAL override_after)
    message(FATAL_ERROR "explicit settings were overwritten")
endif()
message(STATUS "AssetCookImportSmoke passed")
