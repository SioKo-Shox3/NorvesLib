#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

// ========================================
// 太陽の仮想シャドウマップ（VSM）の展開: 影の塊 × ページのインスタンスを作る
//
// 1 ワークグループ（64 スレッド）= 1 塊。塊の番号は、ホストが書いた塊（手続きメッシュ・スキニング。binding 1）が 0 〜 counts.x - 1、
// それに続いて MegaGeometry のクラスタの記録（vsm_mega_chunks.comp が書く。binding 6）が counts.x から並ぶ。クラスタの記録の数は GPU が決める
// （カリングの一覧の件数 binding 7 の語 0 を、容量 counts.w で頭打ちにした数）。件数より後ろの塊のワークグループは何もしない。
// 塊のワールドの境界のライト空間の矩形が覆うページのうち、段ごとに
// 「範囲の中で、割り当て済みで dirty のもの」を数え（1 回目）、インスタンスの確保の位置（draws の頭の語 0 への atomicAdd）から
// 連続した範囲を取り、同じ走査でインスタンス（塊の番号・段・絶対のページ・物理ページ）を書き（2 回目）、
// 塊ごとの間接描画の引数（頂点数 = 三角形の数 × 3、instanceCount = ページの数、firstInstance = 範囲の先頭）を作る。
// ページの表はここで引き、描画は物理ページへ直接書く。
// 正射影のスライス（太陽の段）の覆うページは、境界のライト空間の矩形から決める。透視のスライス（点光源の面。投影の種類が透視）は、
// 塊の境界球（AABB の中心と半径）が光源の Range の内側で面の錐台と交わるときだけ、球を面へ透視で写した矩形（球が近い平面 z ≤ near を
// またぐときは面全体）が覆うページを数える。光源から見て全部が近い平面より手前にある球・Range の外・錐台の外の球は、何も覆わない。
// スライス（段）は、塊の記録の levelMask（CPU が境界から決めたスライスの集合）に入るものだけを処理する。levelMask は 32 スライスずつの組の印で、
// 記録の reserved が組の番号 g（スライス / 32）。ビット b が スライス g × 32 + b。複数の組にまたがる投影物は、組ごとの塊に分かれている。
// インスタンスの y は スライス（下位 8 ビット）| 物理ページ << 8。
//
// 覆うページが 2 つ以上（1024 以下）のスライスでは、塊の三角形を描画と同じ変換でページの座標へ写し、どの三角形も触れないページには
// インスタンスを作らない（境界球の矩形は三角形の広がりより広く、ページの端の三角形の無い所にもインスタンスができて、
// 三角形ぶんの頂点とプリミティブの処理が無駄になるため）。触れるページの印は共有メモリに持ち、スライスごとに作る
// （スライスが 1 つの塊は 1 回目に作った印を 2 回目も使う）。近い平面をまたぐ三角形・投影を決められない頂点・覆うページが多い三角形があれば、
// そのスライスは判定を使わない（従来どおり範囲の全ページ）。
// 容量（インスタンスの数）を超える塊は、ページを 1 つも描かず（instanceCount 0）、溢れとして数える。
// 描けなかった塊の範囲の、割り当て済みで dirty のページには再描画の印（VSM_PAGE_ENTRY_RETRY）を付ける。
// 次フレームの引き継ぎ（vsm_allocate.comp）が dirty を付け直すので、そのページは欠けたまま持ち越されず、描き直される。
// 統計（stats）の語: 5 = 描く塊の数（1 つ以上のインスタンスがある）、6 = 書いたインスタンスの数、7 = 溢れて書かなかったインスタンスの数。
// 統計・間接描画の引数の頭は、呼ぶ前に 0 にしておくこと。
// ========================================

#include "Common/VisibilityBuffer.glsl"
#include "Common/VirtualShadowMapChunk.glsl"
#include "Common/VisibilityTriangleFetch.glsl"
// binding 8: スライスの表（ページの一辺・範囲の原点・ページの表の先頭）
#define VSM_SLICE_BINDING 8
#include "Common/VirtualShadowMapSlice.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// std140。VirtualShadowMapRaster.cpp の GPURasterParams と同じ並び
layout(std140, set = 0, binding = 0) uniform VsmRasterParams
{
    vec4 lightRight;
    vec4 lightUp;
    vec4 lightDirection;
    // x: 深度の原点（ライト空間の深度）、y: 1 / (2 × 深度の範囲)
    vec4 depth;
    // x: ホストが書いた塊の数、y: スライスの数、z: インスタンスの容量、w: MegaGeometry のクラスタの記録の容量（0 なら無し）
    uvec4 counts;
} params;

layout(std430, set = 0, binding = 1) readonly buffer VsmChunks
{
    VsmShadowChunk chunks[];
};

// 溢れた塊の範囲のページへ再描画の印を atomicOr で書くので、読み取り専用ではない（割り当て済み・dirty・物理ページの番号の欄は変えない）
layout(std430, set = 0, binding = 2) buffer VsmPageTable
{
    uint pageTable[];
};

layout(std430, set = 0, binding = 3) buffer VsmDraws
{
    uint draws[];
};

layout(std430, set = 0, binding = 4) buffer VsmInstances
{
    uvec4 instances[];
};

layout(std430, set = 0, binding = 5) buffer VsmStats
{
    uint stats[];
};

// MegaGeometry のクラスタの影の塊の記録（vsm_mega_chunks.comp が書く）と、カリングの一覧の頭（語 0 = 選んだクラスタの数）
layout(std430, set = 0, binding = 6) readonly buffer VsmMegaChunks
{
    VsmShadowChunk megaChunks[];
};

layout(std430, set = 0, binding = 7) readonly buffer VsmMegaListHeader
{
    uint megaListSelected;
};

const uint STAT_RASTER_CHUNKS = 5u;
const uint STAT_RASTER_INSTANCES = 6u;
const uint STAT_RASTER_OVERFLOW = 7u;

shared uint sharedCount;
shared uint sharedCursor;
shared uint sharedBase;
shared uint sharedOk;
shared uint sharedRetry;
// 三角形が触れるページの印（範囲の中の位置 index がビット index。覆うページが TOUCH_MAX_PAGES 以下のスライスだけが使う）と、判定を使わない印
const uint TOUCH_MAX_PAGES = 1024u;
const uint TOUCH_MAX_CELLS_PER_TRIANGLE = 64u;
// 三角形の広がりへ足す余裕（ページ単位。1/4 texel）。変換の丸めの差で端のページを落とさない
const float TOUCH_MARGIN = 0.002;
shared uint sharedTouched[TOUCH_MAX_PAGES / 32u];
shared uint sharedTouchAll;

// スライス level の、塊が覆うページの範囲（絶対のページの番号。範囲の外は切り捨てる）。覆わなければ幅・高さが 0。
// 正射影のスライスは境界のライト空間の矩形（lightMin・lightMax）、透視のスライスは境界球（center・radius）から決める
void PageRange(uint level, vec2 lightMin, vec2 lightMax, vec3 center, float radius, out ivec2 pageMin, out uvec2 size)
{
    const VsmSlice slice = vsmSlices[level];
    if (slice.extra.z == int(VSM_SLICE_PROJECTION_PERSPECTIVE))
    {
        VsmPerspectivePageRange(slice, center, radius, pageMin, size);
        return;
    }
    const float pageMeters = slice.info.x;
    const ivec2 origin = slice.origin.xy;
    const ivec2 count = ivec2(slice.origin.w);
    const ivec2 low = max(ivec2(floor(lightMin / pageMeters)), origin);
    const ivec2 high = min(ivec2(floor(lightMax / pageMeters)), origin + count - ivec2(1));
    pageMin = low;
    size = uvec2(max(high - low + ivec2(1), ivec2(0)));
}

// スライス level のページ (pageX, pageY) の表の欄（スライスの先頭 + トーラスの番地）
// 別のワークグループが同じ欄へ再描画の印を atomicOr するので、読み取りも原子的にしてデータ競合を避ける
uint PageEntryIndex(uint level, int pageX, int pageY)
{
    return VsmSliceEntryIndex(vsmSlices[level], pageX, pageY);
}

uint PageEntry(uint level, int pageX, int pageY)
{
    return atomicOr(pageTable[PageEntryIndex(level, pageX, pageY)], 0u);
}

bool IsDrawable(uint entry)
{
    return (entry & VSM_PAGE_ENTRY_ALLOCATED) != 0u && (entry & VSM_PAGE_ENTRY_DIRTY) != 0u;
}

// 溢れて描けなかった塊の範囲の、割り当て済みで dirty のページに再描画の印を付ける（1 回目と同じ走査）
void MarkRetry(uint levelMask, uint levelBase, vec2 lightMin, vec2 lightMax, vec3 center, float radius, uint thread)
{
    for (uint remaining = levelMask; remaining != 0u; remaining &= remaining - 1u)
    {
        const uint level = levelBase + uint(findLSB(remaining));
        if (level >= params.counts.y)
        {
            break;
        }
        ivec2 pageMin;
        uvec2 size;
        PageRange(level, lightMin, lightMax, center, radius, pageMin, size);
        const uint total = size.x * size.y;
        for (uint index = thread; index < total; index += 64u)
        {
            const int pageX = pageMin.x + int(index % size.x);
            const int pageY = pageMin.y + int(index / size.x);
            if (IsDrawable(PageEntry(level, pageX, pageY)))
            {
                atomicOr(pageTable[PageEntryIndex(level, pageX, pageY)], VSM_PAGE_ENTRY_RETRY);
            }
        }
    }
}

// 塊の三角形が触れるページの印を作る（スライス level。範囲は pageMin・size）。全スレッドが呼び、終わりに barrier を張る。
// ページの座標は描画（vsm_draw.vert）と同じ式: 透視は (面の NDC + 1) / pageMeters、正射影は ライト空間の座標 / pageMeters
void BuildTouchedPages(VisibilityDrawRecord record, vec4 world0, vec4 world1, vec4 world2,
                       uint level, ivec2 pageMin, uvec2 size, uint triangles, uint thread)
{
    const VsmSlice slice = vsmSlices[level];
    const bool bPerspective = slice.extra.z == int(VSM_SLICE_PROJECTION_PERSPECTIVE);
    const float pageMeters = slice.info.x;
    const float nearPlane = slice.info.w;
    const ivec2 sizeI = ivec2(size);
    for (uint triangle = thread; triangle < triangles; triangle += 64u)
    {
        vec3 localPosition[3];
        if (!VisLoadTrianglePositions(record, triangle, localPosition))
        {
            continue;
        }
        vec2 low = vec2(1.0e30);
        vec2 high = vec2(-1.0e30);
        bool bAll = false;
        for (uint corner = 0u; corner < 3u; ++corner)
        {
            const vec4 local = vec4(localPosition[corner], 1.0);
            const vec3 world = vec3(dot(world0, local), dot(world1, local), dot(world2, local));
            vec2 page;
            if (bPerspective)
            {
                const vec3 face = vec3(dot(world, slice.axisX.xyz) + slice.axisX.w,
                                       dot(world, slice.axisY.xyz) + slice.axisY.w,
                                       dot(world, slice.axisZ.xyz) + slice.axisZ.w);
                // 近い平面より手前（光源の後ろ側）の頂点を持つ三角形は、近い平面のクリップで形が変わるので範囲の全ページ
                if (!(face.z > nearPlane))
                {
                    bAll = true;
                    break;
                }
                page = (face.xy / face.z + vec2(1.0)) / pageMeters;
            }
            else
            {
                page = vec2(dot(world, slice.axisX.xyz), dot(world, slice.axisY.xyz)) / pageMeters;
            }
            if (!(abs(page.x) < 1.0e6) || !(abs(page.y) < 1.0e6))
            {
                bAll = true;
                break;
            }
            low = min(low, page);
            high = max(high, page);
        }
        if (bAll)
        {
            atomicOr(sharedTouchAll, 1u);
            continue;
        }
        // 範囲の中の位置（左下を 0）へ直し、範囲で切る
        const ivec2 cellLow = max(ivec2(floor(low - vec2(TOUCH_MARGIN))) - pageMin, ivec2(0));
        const ivec2 cellHigh = min(ivec2(floor(high + vec2(TOUCH_MARGIN))) - pageMin, sizeI - ivec2(1));
        if (cellHigh.x < cellLow.x || cellHigh.y < cellLow.y)
        {
            continue;
        }
        const uint cells = uint(cellHigh.x - cellLow.x + 1) * uint(cellHigh.y - cellLow.y + 1);
        if (cells > TOUCH_MAX_CELLS_PER_TRIANGLE)
        {
            atomicOr(sharedTouchAll, 1u);
            continue;
        }
        for (int y = cellLow.y; y <= cellHigh.y; ++y)
        {
            for (int x = cellLow.x; x <= cellHigh.x; ++x)
            {
                const uint index = uint(y) * size.x + uint(x);
                atomicOr(sharedTouched[index >> 5u], 1u << (index & 31u));
            }
        }
    }
    barrier();
}

// スライス level で三角形の判定を使うか（使うとき sharedTouched・sharedTouchAll が level のものになる）。
// builtLevel・bBuiltFilter は直前に作ったスライスとその結果で、同じスライスなら作り直さない（全スレッドで同じ値。呼び出しはワークグループで揃っている）
bool PrepareTouched(inout uint builtLevel, inout bool bBuiltFilter, VisibilityDrawRecord record, vec4 world0, vec4 world1, vec4 world2,
                    uint level, ivec2 pageMin, uvec2 size, uint triangles, uint thread)
{
    if (builtLevel == level)
    {
        return bBuiltFilter;
    }
    const uint total = size.x * size.y;
    const bool bFilter = total >= 2u && total <= TOUCH_MAX_PAGES && triangles != 0u && VisRecordHasAddresses(record);
    if (bFilter)
    {
        // 前のスライスの印の読み手が終わってから消す
        barrier();
        if (thread < TOUCH_MAX_PAGES / 32u)
        {
            sharedTouched[thread] = 0u;
        }
        if (thread == 0u)
        {
            sharedTouchAll = 0u;
        }
        barrier();
        BuildTouchedPages(record, world0, world1, world2, level, pageMin, size, triangles, thread);
    }
    builtLevel = level;
    bBuiltFilter = bFilter;
    return bFilter;
}

bool IsTouched(bool bFilter, uint index)
{
    return !bFilter || sharedTouchAll != 0u || ((sharedTouched[index >> 5u] >> (index & 31u)) & 1u) != 0u;
}

void main()
{
    const uint chunkIndex = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    // counts.x 以降は MegaGeometry のクラスタの記録（件数は GPU が決める）。ワークグループ全体で同じ値なので、barrier の前の早い戻りでよい
    const bool bMega = chunkIndex >= params.counts.x;
    const uint megaIndex = chunkIndex - params.counts.x;
    if (bMega && (params.counts.w == 0u || megaIndex >= min(megaListSelected, params.counts.w)))
    {
        return;
    }
    const uint thread = gl_LocalInvocationID.x;

    // ワールドの境界（AABB）、展開するスライスの集合（組 levelGroup の印）、三角形の数
    vec3 boundsMin;
    vec3 boundsMax;
    uint levelMask;
    uint levelGroup;
    uint recordTriangles;
    VisibilityDrawRecord chunkRecord;
    vec4 chunkWorld0;
    vec4 chunkWorld1;
    vec4 chunkWorld2;
    if (bMega)
    {
        boundsMin = megaChunks[megaIndex].boundsMin;
        boundsMax = megaChunks[megaIndex].boundsMax;
        levelMask = megaChunks[megaIndex].levelMask;
        levelGroup = megaChunks[megaIndex].reserved;
        recordTriangles = VisRecordTriangleCount(megaChunks[megaIndex].record);
        chunkRecord = megaChunks[megaIndex].record;
        chunkWorld0 = megaChunks[megaIndex].world0;
        chunkWorld1 = megaChunks[megaIndex].world1;
        chunkWorld2 = megaChunks[megaIndex].world2;
    }
    else
    {
        boundsMin = chunks[chunkIndex].boundsMin;
        boundsMax = chunks[chunkIndex].boundsMax;
        // CPU が境界から決めたスライスの集合。外のスライスは範囲を見ずに飛ばす
        levelMask = chunks[chunkIndex].levelMask;
        levelGroup = chunks[chunkIndex].reserved;
        recordTriangles = VisRecordTriangleCount(chunks[chunkIndex].record);
        chunkRecord = chunks[chunkIndex].record;
        chunkWorld0 = chunks[chunkIndex].world0;
        chunkWorld1 = chunks[chunkIndex].world1;
        chunkWorld2 = chunks[chunkIndex].world2;
    }
    const vec3 center = 0.5 * (boundsMin + boundsMax);
    const vec3 extent = 0.5 * (boundsMax - boundsMin);
    const vec2 lightCenter = vec2(dot(center, params.lightRight.xyz), dot(center, params.lightUp.xyz));
    const vec2 lightExtent = vec2(dot(extent, abs(params.lightRight.xyz)), dot(extent, abs(params.lightUp.xyz)));
    const vec2 lightMin = lightCenter - lightExtent;
    const vec2 lightMax = lightCenter + lightExtent;
    // 透視のスライス（点光源の面）が使う境界球の半径（中心は center）
    const float boundsRadius = length(extent);
    // 組 levelGroup の先頭のスライスの番号（組の番号が大きすぎるときは、どのスライスにも当たらない）
    const uint levelBase = levelGroup * 32u;
    const uint touchTriangles = min(recordTriangles, VIS_MAX_TRIANGLES_PER_RECORD);
    // 三角形が触れるページの印を最後に作ったスライス（無ければ ~0）と、その結果
    uint builtLevel = ~0u;
    bool bBuiltFilter = false;

    if (thread == 0u)
    {
        sharedCount = 0u;
        sharedCursor = 0u;
    }
    barrier();

    // 1 回目: 描くページの数
    for (uint remaining = levelMask; remaining != 0u; remaining &= remaining - 1u)
    {
        const uint level = levelBase + uint(findLSB(remaining));
        if (level >= params.counts.y)
        {
            break;
        }
        ivec2 pageMin;
        uvec2 size;
        PageRange(level, lightMin, lightMax, center, boundsRadius, pageMin, size);
        const uint total = size.x * size.y;
        const bool bFilter = PrepareTouched(builtLevel, bBuiltFilter, chunkRecord, chunkWorld0, chunkWorld1, chunkWorld2,
                                            level, pageMin, size, touchTriangles, thread);
        for (uint index = thread; index < total; index += 64u)
        {
            const int pageX = pageMin.x + int(index % size.x);
            const int pageY = pageMin.y + int(index / size.x);
            if (IsTouched(bFilter, index) && IsDrawable(PageEntry(level, pageX, pageY)))
            {
                atomicAdd(sharedCount, 1u);
            }
        }
    }
    barrier();

    if (thread == 0u)
    {
        const uint total = sharedCount;
        const uint triangles = min(recordTriangles, VIS_MAX_TRIANGLES_PER_RECORD);
        uint base = 0u;
        bool bOk = false;
        if (total != 0u && triangles != 0u)
        {
            base = atomicAdd(draws[0], total);
            bOk = base + total <= params.counts.z && base + total >= base;
            if (bOk)
            {
                atomicAdd(stats[STAT_RASTER_CHUNKS], 1u);
                atomicAdd(stats[STAT_RASTER_INSTANCES], total);
            }
            else
            {
                atomicAdd(stats[STAT_RASTER_OVERFLOW], total);
            }
        }
        const uint command = VSM_DRAWS_HEADER_WORDS + chunkIndex * VSM_DRAW_COMMAND_WORDS;
        draws[command + 0u] = triangles * 3u;
        draws[command + 1u] = bOk ? total : 0u;
        draws[command + 2u] = 0u;
        draws[command + 3u] = 0u;
        draws[command + 4u] = bOk ? base : 0u;
        sharedBase = base;
        sharedOk = bOk ? 1u : 0u;
        // 描くページがあり三角形もあるのに、容量が足りなかった塊: そのページは次フレームに描き直す
        sharedRetry = (total != 0u && triangles != 0u && !bOk) ? 1u : 0u;
    }
    barrier();

    if (sharedOk == 0u)
    {
        if (sharedRetry != 0u)
        {
            MarkRetry(levelMask, levelBase, lightMin, lightMax, center, boundsRadius, thread);
        }
        return;
    }

    // 2 回目: インスタンスを書く
    for (uint remaining = levelMask; remaining != 0u; remaining &= remaining - 1u)
    {
        const uint level = levelBase + uint(findLSB(remaining));
        if (level >= params.counts.y)
        {
            break;
        }
        ivec2 pageMin;
        uvec2 size;
        PageRange(level, lightMin, lightMax, center, boundsRadius, pageMin, size);
        const uint total = size.x * size.y;
        const bool bFilter = PrepareTouched(builtLevel, bBuiltFilter, chunkRecord, chunkWorld0, chunkWorld1, chunkWorld2,
                                            level, pageMin, size, touchTriangles, thread);
        for (uint index = thread; index < total; index += 64u)
        {
            if (!IsTouched(bFilter, index))
            {
                continue;
            }
            const int pageX = pageMin.x + int(index % size.x);
            const int pageY = pageMin.y + int(index / size.x);
            const uint entry = PageEntry(level, pageX, pageY);
            if (IsDrawable(entry))
            {
                const uint slot = atomicAdd(sharedCursor, 1u);
                const uint physical = entry & VSM_PAGE_INDEX_MASK;
                instances[sharedBase + slot] = uvec4(chunkIndex, level | (physical << 8u), uint(pageX), uint(pageY));
            }
        }
    }
}
