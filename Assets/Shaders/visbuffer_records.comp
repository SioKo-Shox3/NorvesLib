#version 450

// ========================================
// ビジビリティバッファ: MegaGeometry のクラスタの描画の記録を書くコンピュートシェーダー
//
// MegaGeometryPass のカリングが積んだ IndirectDraw コマンド 1 つにつき、記録の表の「1 + コマンドの通しの位置」番へ
// 記録を 1 行書く（visbuffer_mega.vert が同じ番号を ID に使う）。積まれたコマンドの数は区間ごとのカウンタ
// （区間のコマンドの最大数で頭打ち）で、それより後ろの位置は書かない。
// 1 スレッドが 1 コマンドを受け持つ。ワークグループは積まれたコマンドの数だけを、全区間をまたいで 1 本の列に並べて走る
// （visbuffer_records_args.comp が列の長さと区間ごとの先頭を書く）。グループの番号から区間の表の添え字（パス × 区間）
// を二分探索で引き、区間の中の位置を求める。
// ========================================

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std140, set = 0, binding = 0) uniform RecordParams
{
    // x: 区間の数（パスによらない）, y: 区間の表の要素数（パスの数 × 区間の数）
    uvec4 counts;
} params;

struct DrawIndexedIndirectCommand
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(std430, set = 0, binding = 1) readonly buffer IndirectDrawBuffer
{
    DrawIndexedIndirectCommand drawCommands[];
};

layout(std430, set = 0, binding = 2) readonly buffer DrawCountBuffer
{
    uint sectionCounts[];
};

layout(std430, set = 0, binding = 3) readonly buffer SectionBuffer
{
    uvec2 sections[];
};

layout(std430, set = 0, binding = 4) readonly buffer DrawInfoBuffer
{
    uvec2 drawInfos[];
};

// 区間ごとの頂点・インデックスの先頭のアドレス（xy = 頂点、zw = インデックス。下位・上位の順。BDA が無ければ 0）
layout(std430, set = 0, binding = 5) readonly buffer SectionAddressBuffer
{
    uvec4 sectionAddresses[];
};

#include "Common/VisibilityBuffer.glsl"

layout(std430, set = 0, binding = 6) writeonly buffer RecordTableOut
{
    VisibilityDrawRecord records[];
};

// 区間ごとの、フレームの材質の表（VisibilityMaterialTable）の番号。同じ材質の区間は同じ番号
layout(std430, set = 0, binding = 7) readonly buffer SectionMaterialBuffer
{
    uint sectionMaterials[];
};

// 間接 dispatch の引数（visbuffer_records_args.comp が書く）。[3] = ワークグループの総数、
// [4 + s] = 区間の表の添え字 s の先頭のワークグループの番号
layout(std430, set = 0, binding = 8) readonly buffer RecordArgsBuffer
{
    uint recordArgs[];
};

// visbuffer_records_args.comp の MAX_GROUPS_X と一致させる（x を超える分は y へ折り返す）
const uint MAX_GROUPS_X = 65535u;

void main()
{
    const uint groupIndex = gl_WorkGroupID.y * MAX_GROUPS_X + gl_WorkGroupID.x;
    if (groupIndex >= recordArgs[3])
    {
        return;
    }

    // 先頭の番号が groupIndex 以下の最後の区間（空の区間は次の区間と先頭が同じなので、後ろの方が選ばれる）
    uint low = 0u;
    uint high = params.counts.y - 1u;
    while (low < high)
    {
        const uint middle = (low + high + 1u) >> 1u;
        if (recordArgs[4u + middle] <= groupIndex)
        {
            low = middle;
        }
        else
        {
            high = middle - 1u;
        }
    }
    const uint sectionSlot = low;

    const uvec2 section = sections[sectionSlot];
    const uint drawnCount = min(sectionCounts[sectionSlot], section.y);
    const uint localIndex = (groupIndex - recordArgs[4u + sectionSlot]) * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
    if (localIndex >= drawnCount)
    {
        return;
    }

    const uint commandIndex = section.x + localIndex;
    const DrawIndexedIndirectCommand command = drawCommands[commandIndex];
    const uint sectionIndex = sectionSlot % params.counts.x;
    const uvec4 addresses = sectionAddresses[sectionIndex];

    VisibilityDrawRecord record;
    record.header = uvec4(VIS_KIND_MEGA_CLUSTER,
                          drawInfos[commandIndex].x,
                          sectionMaterials[sectionIndex],
                          min(command.indexCount / 3u, VIS_MAX_TRIANGLES_PER_RECORD));
    record.source = uvec4(command.firstIndex, uint(command.vertexOffset), VIS_NO_PREVIOUS_TRANSFORM, 0u);
    record.address = addresses;
    // 材質の解決が、変位した球の法線の補正に使う LOD の段（描画番号の payload）
    record.previous = uvec4(0u, 0u, drawInfos[commandIndex].y, 0u);
    records[commandIndex + 1u] = record;
}
