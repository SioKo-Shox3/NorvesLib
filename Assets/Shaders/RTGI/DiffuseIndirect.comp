// 拡散2バウンスまでのdiffuse indirect radianceをray queryで生成する。
#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT sceneTopLevel;

layout(set = 0, binding = 1, std140) uniform RTGIComputeParameters
{
    mat4 invViewProjection;
    vec4 cameraPosition;
    uvec4 imageAndSceneCounts; // xy=画像寸法、z=インスタンス数、w=ライト数
    vec4 rayLimits; // x=最小距離、y=最大距離、z=pre-exposure、w=環境強度
    uvec4 temporalState; // x=履歴有効、y=ライトrevision差、z=weight制限、w=age上限
    // x=試料系列の番号（RTGIのdispatchごとに1進む）、y=発光instance数、z=発光三角形数、
    // w=当たりの統計（開発ビルドだけ。0は数えない。それ以外はMegaGeometryの先頭のcustom index + 1）
    uvec4 sampleState;
    vec4 previousCameraPosition; // xyz=履歴を書いた前フレームのカメラ位置、w=履歴に掛ける露出の比
    // x=静的HDR環境の放射輝度の上限（倍率を掛ける前。0は上限なし）、y=当たりの色に掛ける倍率（照り返しを切ると 0）、
    // z=遮蔽の診断（1/0）、w=拡散の光線が影を落とさない不透明物体にも当たるか（1/0）
    vec4 environmentParameters;
    // 地形の当たりの色（LightingPass.cpp の RTGIComputeParameters と同じ並び）
    vec4 terrainMask;    // x,y=地表の分類の地図の外縁の X・Z の最小、z,w=X・Z の広さの逆数（z が 0 なら地図なし）
    vec4 terrainMaskMix; // x=礫を土へ回す割合、y=外縁の帯の幅（m）、z=アルベドを sRGB から戻すビット、w=有効（1/0）
    vec4 terrainSlope;   // x,y=土へ移る傾斜の始まり・終わり、z,w=岩肌へ移る傾斜の始まり・終わり（ラジアン）
    vec4 terrainHeight;  // x,y=土へ寄せる高さの始まり・終わり（m）、z=寄せの最大（ラジアン）
    vec4 foliageOcclusion; // x=株の冠の数（RTGIFoliageCrowns の行の数の半分。0 なら遮らない）
} parameters;

layout(set = 0, binding = 2) uniform sampler2D gbufferNormal;
layout(set = 0, binding = 3) uniform sampler2D gbufferDepth;
layout(set = 0, binding = 4) uniform sampler2D gbufferAlbedo;
layout(set = 0, binding = 5) uniform sampler2D gbufferMaterial;
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D diffuseIndirect;

struct RTGIInstanceData
{
    uint64_t vertexAddress;
    uint64_t indexAddress;
    vec4 baseColor;
    vec4 emissiveChromaticityAndLuminance;
    uvec4 geometry; // x=stride、y=vertex count、z=index count、w=custom index
    vec4 transform0;
    vec4 transform1;
    vec4 transform2;
    vec4 rayProxy; // x=光線に見せる形のずれの上限（世界の長さ。MegaGeometry の影の段がラスタより粗い分）、
                   // y=地形の混ぜ合わせの材質（1/0）、z=影を落とさない不透明物体（1/0）
};

struct LightData
{
    vec4 position;
    vec4 direction;
    vec4 chromaticityAndIntensity;
    vec4 attenuation;
};

layout(set = 0, binding = 7, std430) readonly buffer RTGIInstances
{
    RTGIInstanceData values[];
} instances;

layout(set = 0, binding = 8, std430) readonly buffer RTGILights
{
    LightData values[];
} lights;

layout(set = 0, binding = 9) uniform sampler2D environmentRadiance;
layout(set = 0, binding = 10) uniform sampler2D gbufferVelocity;
layout(set = 0, binding = 11) uniform sampler2D historyRadiance;
layout(set = 0, binding = 12) uniform sampler2D historyAge;
layout(set = 0, binding = 13) uniform sampler2D historyConfidence;
layout(set = 0, binding = 14) uniform sampler2D historyDepth;
layout(set = 0, binding = 15) uniform sampler2D historyNormal;
layout(set = 0, binding = 16) uniform sampler2D historyMaterial;
layout(set = 0, binding = 17, rgba16f) uniform writeonly image2D historyRadianceOutput;
layout(set = 0, binding = 18, r16f) uniform writeonly image2D historyAgeOutput;
layout(set = 0, binding = 19, r16f) uniform writeonly image2D historyConfidenceOutput;
layout(set = 0, binding = 20, rgba16f) uniform writeonly image2D historyDepthOutput;
layout(set = 0, binding = 21, rgba16f) uniform writeonly image2D historyNormalOutput;
layout(set = 0, binding = 22, rgba16f) uniform writeonly image2D historyMaterialOutput;
// 発光instanceの表。x=instance表の番号、y=三角形数、z=先頭の通し番号。
layout(set = 0, binding = 23, std430) readonly buffer RTGIEmitters
{
    uvec4 values[];
} emitters;

// 1回目の拡散光線の当たりの統計（開発ビルドだけ書く）。[0]=光線の数、[1]=当たった数、[2]=MegaGeometryに当たった数
layout(set = 0, binding = 24, std430) buffer RTGIHitStats
{
    uint values[4];
} hitStats;

// 地形の当たりの色: 地表の分類の地図（R = 露岩・G = 崖錐・B = 地表（細粒）・A = 地表（礫））と砂・土・岩肌のアルベド。
// アルベドは最も粗いミップ（素材の平均の色）だけを読む
layout(set = 0, binding = 25) uniform sampler2D terrainSurfaceMask;
layout(set = 0, binding = 26) uniform sampler2D terrainSandAlbedo;
layout(set = 0, binding = 27) uniform sampler2D terrainDirtAlbedo;
layout(set = 0, binding = 28) uniform sampler2D terrainRockAlbedo;
// 株の冠の楕円体（LightingPass.cpp の RTGIFoliageCrown。1 つの冠が 2 行: 中心の xyz と中心を通る光線の光学的な厚さ、
// 半径の逆数の xyz）。拡散の光線が通る冠の弦の長さで透過を掛け、株の根元の空の光を遮る
layout(set = 0, binding = 29, std430) readonly buffer RTGIFoliageCrowns
{
    vec4 foliageCrowns[];
};

shared uint sharedHitStats[3];

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer RTGIVertexData
{
    float values[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer RTGIIndexData
{
    uint values[];
};

#include "Common/PbrMaterialEvaluation.glsl"
#include "Common/RayTracingInstanceMask.glsl"
const float RAY_ORIGIN_OFFSET = 0.002;
// 鏡面の光線の当たりを画面の面と同じと見なす位置の差（m と、カメラからの距離に対する割合の大きい方）
const float RTGI_SCREEN_INDIRECT_POSITION_TOLERANCE = 0.05;
const float RTGI_SCREEN_INDIRECT_RELATIVE_TOLERANCE = 0.01;
// 1 次面からの光線が、当てた instance の光線の形のずれ（rayProxy.x）より低い所で当たったときに読み飛ばす回数の上限
const uint RTGI_PROXY_SELF_HIT_SKIPS = 4u;
// 読み飛ばす高さの上限（近く）。遠くの大きな区画のフォールバックは誤差が数百 m になり、そのまま使うと本物の遮りまで抜ける
const float RTGI_PROXY_SELF_HIT_HEIGHT_MAX = 0.5;
// 遠くの面は深度から戻した位置の誤差とラスタの段の粗さがカメラからの距離に比例して大きくなるので、
// 読み飛ばす高さの上限も距離に比例して広げる
const float RTGI_PROXY_SELF_HIT_HEIGHT_PER_METER = 5e-4;
// 読み飛ばすのは光線の形の内側から外へ出る当たりだけで、光線の形のずれが正の instance なら、ずれの大きさに依らない。
// 焼いた階層の常駐のフォールバックのように、ずれが地面の起伏の大きさになる物で自分の面への当たりが空を遮るほか、数 cm〜
// 十数 cm のずれの模型でも、石積みの目地のくぼみ（粗い形の下に沈んだ 1 次面）から出た光線が粗い形の壁に裏から当たり、
// 陰の壁の目地の照り返しと空の光がほぼ 0 になる（SCN-WL-PROP-AO）。外から入る当たりは小物の接地の影なので当てる
// 光線の形の内側から外へ出る当たりの読み飛ばす高さの上限に掛ける倍率（ProxySelfHitHeightLimit に対して）
const float RTGI_PROXY_EXIT_HEIGHT_SCALE = 4.0;

// 1 次面からの光線で、光線の形がラスタと違う instance（rayProxy.x が正）への当たりを読み飛ばす高さの上限
float ProxySelfHitHeightLimit(float viewDistance)
{
    return max(RTGI_PROXY_SELF_HIT_HEIGHT_MAX, RTGI_PROXY_SELF_HIT_HEIGHT_PER_METER * viewDistance);
}

// 遮蔽の診断（開発ビルドの --capture-aov だけ。environmentParameters.z が 1）。1 次面の光線が読み飛ばした自分の面への
// 当たりの 1 次面からの高さの最大（読み飛ばしが無ければ負）。TraceDiffuseRay が書き、ShadeDiffuseIndirect が分類して出力の a へ詰める
float gOcclusionDiagSkippedHeight = -1.0;
// 読み飛ばした高さの分類の境目（m）。0.1〜2 m は岩の下・株の根元・溝の奥の小さな遮蔽の大きさ
const float RTGI_OCCLUSION_DIAG_SMALL_HEIGHT = 0.1;
const float RTGI_OCCLUSION_DIAG_LARGE_HEIGHT = 2.0;

bool IsOcclusionDiagnosticEnabled()
{
    return parameters.environmentParameters.z > 0.5;
}
// 画素ごとの履歴の年齢の上限（静止が続いたとき）。フレームごとの上限はtemporalState.wで、視点・光源・
// シーンが動いているフレームでは8になる。重みは累積平均の 1-1/(年齢+1) で、上限は256/257。
const uint RTGI_HISTORY_MAXIMUM_AGE = 256u;
const float RTGI_HISTORY_MAXIMUM_WEIGHT = 256.0 / 257.0;
// 視点・光源・シーンが動いているフレームの年齢の上限（RTGIHistoryMaximumAge）。temporalState.wがこれを
// 超えるフレームは静止が続いている。
const uint RTGI_HISTORY_DYNAMIC_MAXIMUM_AGE = 8u;
const float RTGI_HISTORY_LIGHT_WEIGHT_LIMIT = 0.25;
const float RTGI_HISTORY_INITIAL_CONFIDENCE = 0.25;
const float RTGI_HISTORY_NORMAL_REJECTION_DOT = 0.9;
const float RTGI_HISTORY_DEPTH_REJECTION_THRESHOLD = 0.02;
const float RTGI_HISTORY_MATERIAL_REJECTION_THRESHOLD = 0.05;
// 2×2の履歴の画素のうち同じ表面と認めた画素のバイリニアの重みの和の下限。
const float RTGI_HISTORY_MINIMUM_TAP_WEIGHT = 0.01;
// 近傍の同じ面の法線・材質のばらつきに掛ける余裕（ジッタの位置は近傍の画素の間のどこにでも来るため）。
const float RTGI_HISTORY_SURFACE_SPREAD_SCALE = 2.0;

bool IsFiniteVector(vec3 value)
{
    return !any(isnan(value)) && !any(isinf(value));
}

bool IsFiniteScalar(float value)
{
    return !isnan(value) && !isinf(value);
}

vec3 SanitizeRadiance(vec3 value)
{
    if (!IsFiniteVector(value))
    {
        return vec3(0.0);
    }
    return clamp(value, vec3(0.0), vec3(65504.0));
}

// pre-exposureを掛ける前の物理単位の中間値。非有限と負を0にし、上限では切り詰めない
// （半精度の上限は露出後の出力にだけ掛ける）。
vec3 SanitizeUnexposedRadiance(vec3 value)
{
    if (!IsFiniteVector(value))
    {
        return vec3(0.0);
    }
    return max(value, vec3(0.0));
}

// 静的HDR環境の色の最大の成分が上限を超えたら、色相を保ったまま上限まで縮める（0は上限なし）。
vec3 LimitStaticEnvironmentRadiance(vec3 radiance)
{
    float maximumRadiance = parameters.environmentParameters.x;
    float peak = max(radiance.r, max(radiance.g, radiance.b));
    if (maximumRadiance > 0.0 && peak > maximumRadiance)
    {
        radiance *= maximumRadiance / peak;
    }
    return radiance;
}

// 1本の光線が運ぶ放射輝度の上限（露出を掛けた後の値。1が表示の白）。命中点の光源標本は、強い発光体（電球）の
// すぐ近くの面に当たる稀な光線だけが桁違いに大きな値を持ち、少ない光線ではその光線が粒（ホタル）として画素に残る。
// 白の4倍は、発光体から離れた面の照り返し（露出後でおおむね白以下）を削らず、この稀な値だけを縮める境目として
// 夜の見本の球の暗い側の粒の数で選んだ（2で0、4で2、8で8、16で18、32で33、上限なしで32）。露出を掛けた後で
// 比べるので、昼・夜の自動露出の違いで境目が動かない。
const float RTGI_RAY_RADIANCE_DISPLAY_LIMIT = 4.0;

// 光線1本の放射輝度の最大の成分が上限を超えたら、色相を保ったまま上限まで縮める。
vec3 LimitRayRadiance(vec3 radiance)
{
    float preExposure = IsFiniteScalar(parameters.rayLimits.z) && parameters.rayLimits.z > 0.0
                            ? clamp(parameters.rayLimits.z, 1.0e-6, 1.0e6)
                            : 1.0;
    float maximumRadiance = RTGI_RAY_RADIANCE_DISPLAY_LIMIT / preExposure;
    float peak = max(radiance.r, max(radiance.g, radiance.b));
    if (peak > maximumRadiance)
    {
        radiance *= maximumRadiance / peak;
    }
    return radiance;
}

vec2 EquirectangularUV(vec3 direction)
{
    vec2 uv = vec2(atan(direction.z, direction.x),
                   asin(clamp(-direction.y, -1.0, 1.0)));
    return uv * vec2(0.15915494, 0.31830989) + 0.5;
}

vec3 ReconstructWorldPosition(vec2 uv, float depth)
{
    vec4 clipPosition = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPosition = parameters.invViewProjection * clipPosition;
    if (!IsFiniteVector(worldPosition.xyz) ||
        !IsFiniteScalar(worldPosition.w) || abs(worldPosition.w) <= 1.0e-8)
    {
        return vec3(0.0);
    }
    return worldPosition.xyz / worldPosition.w;
}

uint Hash32(uvec2 value)
{
    uint result = value.x * 1664525u + value.y * 1013904223u + 374761393u;
    result = (result ^ (result >> 16u)) * 2246822519u;
    result = (result ^ (result >> 13u)) * 3266489917u;
    return result ^ (result >> 16u);
}

float HashToUnit(uint value)
{
    return (float(value & 0x00FFFFFFu) + 0.5) / 16777216.0;
}

void BuildOrthonormalBasis(vec3 normal, out vec3 tangent, out vec3 bitangent)
{
    vec3 helper = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0)
                                       : vec3(0.0, 1.0, 0.0);
    tangent = normalize(cross(helper, normal));
    bitangent = cross(normal, tangent);
}

vec3 CosineWeightedDirectionFromUnit(vec3 normal, vec2 xi);

vec3 CosineWeightedDirection(vec3 normal, uvec2 pixel, uint frameIndex)
{
    // 画素ごとの回転を加えたR2列を試料系列の番号で進め、静止中も毎フレーム別の方向を引く。
    // 同じ画素・同じ番号からは常に同じ方向になる。R2の刻みは0.32固定小数点で
    // 整数のまま進め、大きなフレーム番号でもfloatの桁落ちを起こさない。
    uvec2 r2Phase = uvec2(frameIndex * 3242174889u, frameIndex * 2447445414u);
    vec2 rotation = vec2(HashToUnit(Hash32(pixel)),
                         HashToUnit(Hash32(pixel.yx + uvec2(17u, 43u))));
    vec2 xi = fract(rotation + vec2(r2Phase >> 8u) * (1.0 / 16777216.0));
    return CosineWeightedDirectionFromUnit(normal, xi);
}

// 一様乱数の組xiから、法線まわりのコサイン分布の方向を作る。
vec3 CosineWeightedDirectionFromUnit(vec3 normal, vec2 xi)
{
    float xi0 = max(xi.x, 1.0e-6);
    float xi1 = xi.y;
    float radius = sqrt(xi0);
    float angle = 2.0 * PI * xi1;
    vec3 tangent;
    vec3 bitangent;
    BuildOrthonormalBasis(normal, tangent, bitangent);
    return normalize(tangent * (radius * cos(angle)) +
                     bitangent * (radius * sin(angle)) +
                     normal * sqrt(max(0.0, 1.0 - xi0)));
}

bool TryGetInstanceData(uint customIndex, out RTGIInstanceData instanceData)
{
    uint low = 0u;
    uint high = parameters.imageAndSceneCounts.z;
    while (low < high)
    {
        uint middle = low + (high - low) / 2u;
        uint candidateIndex = instances.values[middle].geometry.w;
        if (candidateIndex < customIndex)
        {
            low = middle + 1u;
        }
        else
        {
            high = middle;
        }
    }

    if (low >= parameters.imageAndSceneCounts.z ||
        instances.values[low].geometry.w != customIndex)
    {
        return false;
    }
    instanceData = instances.values[low];
    return true;
}

bool TryGetWorldTriangleNormal(rayQueryEXT query,
                               uint primitiveIndex,
                               RTGIInstanceData instanceData,
                               out vec3 worldNormal)
{
    uint vertexStrideBytes = instanceData.geometry.x;
    uint vertexCount = instanceData.geometry.y;
    uint indexCount = instanceData.geometry.z;
    if (vertexStrideBytes < 12u || (vertexStrideBytes & 3u) != 0u ||
        primitiveIndex >= indexCount / 3u)
    {
        return false;
    }

    RTGIIndexData indexBuffer = RTGIIndexData(instanceData.indexAddress);
    uint primitiveOffset = primitiveIndex * 3u;
    uvec3 vertexIndices = uvec3(indexBuffer.values[primitiveOffset],
                                indexBuffer.values[primitiveOffset + 1u],
                                indexBuffer.values[primitiveOffset + 2u]);
    if (vertexIndices.x >= vertexCount || vertexIndices.y >= vertexCount ||
        vertexIndices.z >= vertexCount)
    {
        return false;
    }

    RTGIVertexData vertexBuffer = RTGIVertexData(instanceData.vertexAddress);
    uint stride = vertexStrideBytes / 4u;
    uint vertex0Offset = vertexIndices.x * stride;
    uint vertex1Offset = vertexIndices.y * stride;
    uint vertex2Offset = vertexIndices.z * stride;
    vec3 vertex0 = vec3(vertexBuffer.values[vertex0Offset],
                        vertexBuffer.values[vertex0Offset + 1u],
                        vertexBuffer.values[vertex0Offset + 2u]);
    vec3 vertex1 = vec3(vertexBuffer.values[vertex1Offset],
                        vertexBuffer.values[vertex1Offset + 1u],
                        vertexBuffer.values[vertex1Offset + 2u]);
    vec3 vertex2 = vec3(vertexBuffer.values[vertex2Offset],
                        vertexBuffer.values[vertex2Offset + 1u],
                        vertexBuffer.values[vertex2Offset + 2u]);
    if (!IsFiniteVector(vertex0) || !IsFiniteVector(vertex1) ||
        !IsFiniteVector(vertex2))
    {
        return false;
    }

    vec3 objectNormal = cross(vertex1 - vertex0, vertex2 - vertex0);
    float normalLengthSquared = dot(objectNormal, objectNormal);
    if (!IsFiniteScalar(normalLengthSquared) || normalLengthSquared <= 1.0e-12)
    {
        return false;
    }

    mat4x3 worldToObject = rayQueryGetIntersectionWorldToObjectEXT(query, true);
    worldNormal = normalize(transpose(mat3(worldToObject)) * normalize(objectNormal));
    return IsFiniteVector(worldNormal);
}

float CalculateInverseSquareAttenuation(float distanceToLight)
{
    return 1.0 / max(distanceToLight * distanceToLight, 0.0001);
}

float CalculateRangeWindow(float distanceToLight, float range)
{
    float safeRange = max(range, 0.0001);
    float window = max(1.0 - pow(distanceToLight / safeRange, 4.0), 0.0);
    return window * window;
}

bool IsOccluded(vec3 worldPosition,
                vec3 normal,
                vec3 lightDirection,
                float maximumDistance)
{
    if (maximumDistance <= parameters.rayLimits.x)
    {
        return false;
    }

    rayQueryEXT shadowQuery;
    rayQueryInitializeEXT(shadowQuery,
                          sceneTopLevel,
                          gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
                          RayTracingInstanceMaskShadowCaster,
                          worldPosition + normal * RAY_ORIGIN_OFFSET,
                          parameters.rayLimits.x,
                          lightDirection,
                          maximumDistance);
    while (rayQueryProceedEXT(shadowQuery))
    {
    }
    return rayQueryGetIntersectionTypeEXT(shadowQuery, true) ==
           gl_RayQueryCommittedIntersectionTriangleEXT;
}

// 光源標本の乱数。画素・試料系列の番号・次元ごとに独立した値を引く。
float EmitterRandom(uvec2 pixel, uint frameIndex, uint dimension)
{
    return HashToUnit(Hash32(uvec2(Hash32(pixel + uvec2(dimension * 7919u, dimension * 104729u)),
                                   frameIndex)));
}

// instanceの三角形のワールド座標の頂点。変換はinstance表の物体→ワールド行列（行優先3x4）。
bool TryReadWorldTriangle(RTGIInstanceData instanceData,
                          uint primitiveIndex,
                          out vec3 vertex0,
                          out vec3 vertex1,
                          out vec3 vertex2)
{
    vertex0 = vec3(0.0);
    vertex1 = vec3(0.0);
    vertex2 = vec3(0.0);
    uint vertexStrideBytes = instanceData.geometry.x;
    uint vertexCount = instanceData.geometry.y;
    uint indexCount = instanceData.geometry.z;
    if (vertexStrideBytes < 12u || (vertexStrideBytes & 3u) != 0u ||
        primitiveIndex >= indexCount / 3u)
    {
        return false;
    }
    RTGIIndexData indexBuffer = RTGIIndexData(instanceData.indexAddress);
    uvec3 vertexIndices = uvec3(indexBuffer.values[primitiveIndex * 3u],
                                indexBuffer.values[primitiveIndex * 3u + 1u],
                                indexBuffer.values[primitiveIndex * 3u + 2u]);
    if (vertexIndices.x >= vertexCount || vertexIndices.y >= vertexCount ||
        vertexIndices.z >= vertexCount)
    {
        return false;
    }
    RTGIVertexData vertexBuffer = RTGIVertexData(instanceData.vertexAddress);
    uint stride = vertexStrideBytes / 4u;
    vec3 objectVertices[3];
    for (uint corner = 0u; corner < 3u; ++corner)
    {
        uint offset = vertexIndices[corner] * stride;
        objectVertices[corner] = vec3(vertexBuffer.values[offset],
                                      vertexBuffer.values[offset + 1u],
                                      vertexBuffer.values[offset + 2u]);
    }
    vertex0 = vec3(dot(instanceData.transform0, vec4(objectVertices[0], 1.0)),
                   dot(instanceData.transform1, vec4(objectVertices[0], 1.0)),
                   dot(instanceData.transform2, vec4(objectVertices[0], 1.0)));
    vertex1 = vec3(dot(instanceData.transform0, vec4(objectVertices[1], 1.0)),
                   dot(instanceData.transform1, vec4(objectVertices[1], 1.0)),
                   dot(instanceData.transform2, vec4(objectVertices[1], 1.0)));
    vertex2 = vec3(dot(instanceData.transform0, vec4(objectVertices[2], 1.0)),
                   dot(instanceData.transform1, vec4(objectVertices[2], 1.0)),
                   dot(instanceData.transform2, vec4(objectVertices[2], 1.0)));
    return IsFiniteVector(vertex0) && IsFiniteVector(vertex1) && IsFiniteVector(vertex2);
}

// 浮かせた始点から発光面上の目標点までに遮蔽物があるか。方向と距離を浮かせた始点から測り直す
// （面上の点から測った方向のままだと、浅い角度で始点のずれが光線方向へ伸び、目標の発光面を
// 手前で横切って自分で遮る）。目標点の少し先まで最も近い命中を求め、それが標本の発光三角形
// 自身か、目標点より先（影を落とさない発光体の奥にある面）なら遮蔽なしとする。距離を割合で
// 縮めないので、発光面の直前にある遮蔽物も見落とさない（パストレーサーと同じ判定）。
bool IsEmitterSegmentOccluded(vec3 origin,
                              vec3 target,
                              uint emitterCustomIndex,
                              uint emitterPrimitiveIndex)
{
    vec3 toTarget = target - origin;
    float targetDistance = length(toTarget);
    if (!IsFiniteScalar(targetDistance) || targetDistance <= parameters.rayLimits.x)
    {
        return false;
    }
    rayQueryEXT shadowQuery;
    rayQueryInitializeEXT(shadowQuery,
                          sceneTopLevel,
                          gl_RayFlagsOpaqueEXT,
                          RayTracingInstanceMaskShadowCaster,
                          origin,
                          parameters.rayLimits.x,
                          toTarget / targetDistance,
                          targetDistance * 1.001 + 0.001);
    while (rayQueryProceedEXT(shadowQuery))
    {
    }
    if (rayQueryGetIntersectionTypeEXT(shadowQuery, true) !=
        gl_RayQueryCommittedIntersectionTriangleEXT)
    {
        return false;
    }
    if (uint(rayQueryGetIntersectionInstanceCustomIndexEXT(shadowQuery, true)) ==
            emitterCustomIndex &&
        uint(rayQueryGetIntersectionPrimitiveIndexEXT(shadowQuery, true)) ==
            emitterPrimitiveIndex)
    {
        return false;
    }
    return rayQueryGetIntersectionTEXT(shadowQuery, true) < targetDistance;
}

// 発光三角形の光源標本。三角形を通し番号で一様に選び、面上を一様に標本化した直接照度Eを、
// コサイン標本の1本と同じ単位（反射率を掛ける前の入射放射輝度の推定 E/π）で返す。
// 発光は両面（パストレーサーと同じ）。
vec3 SampleEmitterIrradiance(vec3 worldPosition, vec3 normal, uvec2 pixel, uint dimension)
{
    uint entryCount = parameters.sampleState.y;
    uint triangleTotal = parameters.sampleState.z;
    if (entryCount == 0u || triangleTotal == 0u)
    {
        return vec3(0.0);
    }
    uint frameIndex = parameters.sampleState.x;
    float u0 = EmitterRandom(pixel, frameIndex, dimension);
    float u1 = EmitterRandom(pixel, frameIndex, dimension + 1u);
    float u2 = EmitterRandom(pixel, frameIndex, dimension + 2u);
    uint triangleNumber = min(uint(u0 * float(triangleTotal)), triangleTotal - 1u);
    // 先頭の通し番号がtriangleNumber以下の最後の行を探す。
    uint low = 0u;
    uint high = entryCount - 1u;
    while (low < high)
    {
        uint middle = (low + high + 1u) / 2u;
        if (emitters.values[middle].z <= triangleNumber)
        {
            low = middle;
        }
        else
        {
            high = middle - 1u;
        }
    }
    uvec4 entry = emitters.values[low];
    if (entry.x >= parameters.imageAndSceneCounts.z || triangleNumber < entry.z ||
        triangleNumber - entry.z >= entry.y)
    {
        return vec3(0.0);
    }
    RTGIInstanceData emitter = instances.values[entry.x];
    uint emitterPrimitiveIndex = triangleNumber - entry.z;
    vec3 vertex0;
    vec3 vertex1;
    vec3 vertex2;
    if (!TryReadWorldTriangle(emitter, emitterPrimitiveIndex, vertex0, vertex1, vertex2))
    {
        return vec3(0.0);
    }
    vec3 edgeCross = cross(vertex1 - vertex0, vertex2 - vertex0);
    float twiceArea = length(edgeCross);
    if (!IsFiniteScalar(twiceArea) || twiceArea <= 1.0e-12)
    {
        return vec3(0.0);
    }
    float squareRoot = sqrt(u1);
    vec3 lightPoint = vertex0 * (1.0 - squareRoot) + vertex1 * (squareRoot * (1.0 - u2)) +
                      vertex2 * (squareRoot * u2);
    vec3 toLight = lightPoint - worldPosition;
    float distanceSquared = dot(toLight, toLight);
    if (!IsFiniteScalar(distanceSquared) || distanceSquared <= 1.0e-12)
    {
        return vec3(0.0);
    }
    float distanceToLight = sqrt(distanceSquared);
    vec3 lightDirection = toLight / distanceToLight;
    float surfaceCosine = dot(normal, lightDirection);
    float lightCosine = abs(dot(edgeCross / twiceArea, lightDirection));
    if (surfaceCosine <= 0.0 || lightCosine <= 1.0e-6 ||
        IsEmitterSegmentOccluded(worldPosition + normal * RAY_ORIGIN_OFFSET,
                                 lightPoint,
                                 emitter.geometry.w,
                                 emitterPrimitiveIndex))
    {
        return vec3(0.0);
    }
    vec3 emission = emitter.emissiveChromaticityAndLuminance.rgb *
                    emitter.emissiveChromaticityAndLuminance.a;
    // 面積の確率密度は1/(三角形数×面積)。E = Le·cosS·cosL/d²/pdf。
    return SanitizeUnexposedRadiance(emission *
                                     (surfaceCosine * lightCosine * 0.5 * twiceArea *
                                      float(triangleTotal) / (PI * distanceSquared)));
}

// 当たりの面の誘電体の鏡面（F0 0.04 の GGX）。地形の当たりだけに足す（Cycles の参照の Principled BSDF と同じ層）。
// 粗さは荒野の砂・土・岩肌の素材の粗さの平均（0.77〜0.96）の代表
const float RTGI_HIT_SPECULAR_F0 = 0.04;
const float RTGI_TERRAIN_HIT_ROUGHNESS = 0.87;

// 当たりの面の鏡面が viewCosine の向きへ返す割合（粗さを含めた Schlick の方向の反射率の近似）。拡散は鏡面の層の下にあり、
// この分だけ減る
float TerrainHitSpecularAlbedo(float viewCosine)
{
    return RTGI_HIT_SPECULAR_F0 +
        (max(1.0 - RTGI_TERRAIN_HIT_ROUGHNESS, RTGI_HIT_SPECULAR_F0) - RTGI_HIT_SPECULAR_F0) *
        pow(1.0 - min(viewCosine, 1.0), 5.0);
}

// 当たりの面の鏡面の BRDF（GGX）。viewDirection・lightDirection は面から外へ向き、viewCosine・lightCosine は正
vec3 EvaluateTerrainHitSpecularBRDF(vec3 normal,
                                    vec3 viewDirection,
                                    vec3 lightDirection,
                                    float viewCosine,
                                    float lightCosine)
{
    vec3 halfVector = normalize(viewDirection + lightDirection);
    float D = DistributionGGX(normal, halfVector, RTGI_TERRAIN_HIT_ROUGHNESS);
    float G = GeometrySmithDirect(normal, viewDirection, lightDirection, RTGI_TERRAIN_HIT_ROUGHNESS);
    vec3 F = FresnelSchlick(max(dot(viewDirection, halfVector), 0.0), vec3(RTGI_HIT_SPECULAR_F0));
    return D * G * F / max(4.0 * viewCosine * lightCosine, 1.0e-4);
}

// 命中面が光源から受けて viewDirection（命中面から光線の始点へ）へ返す放射輝度。specularWeight が 0 より大きければ
// 拡散に誘電体の鏡面を足す（日の低い砂の地面のように、色の濃い拡散に対して色の付かない鏡面の割合が大きい面がある）
vec3 ComputeDirectRadiance(vec3 worldPosition,
                           vec3 normal,
                           vec3 baseColor,
                           vec3 viewDirection,
                           float specularWeight)
{
    vec3 radiance = vec3(0.0);
    for (uint lightIndex = 0u;
         lightIndex < parameters.imageAndSceneCounts.w;
         ++lightIndex)
    {
        LightData light = lights.values[lightIndex];
        float lightType = light.position.w;
        vec3 lightDirection;
        float attenuation = 1.0;
        float shadowDistance = parameters.rayLimits.y;

        if (lightType < 0.5)
        {
            float directionLengthSquared = dot(light.direction.xyz,
                                               light.direction.xyz);
            if (!IsFiniteScalar(directionLengthSquared) || directionLengthSquared <= 1.0e-12)
            {
                continue;
            }
            lightDirection = -light.direction.xyz * inversesqrt(directionLengthSquared);
        }
        else if (lightType < 2.5)
        {
            vec3 toLight = light.position.xyz - worldPosition;
            float distanceToLight = length(toLight);
            if (!IsFiniteScalar(distanceToLight) || distanceToLight <= 1.0e-6)
            {
                continue;
            }
            lightDirection = toLight / distanceToLight;
            attenuation = CalculateInverseSquareAttenuation(distanceToLight) *
                          CalculateRangeWindow(distanceToLight, light.attenuation.x);
            shadowDistance = max(distanceToLight - RAY_ORIGIN_OFFSET * 2.0, 0.0);
            if (lightType >= 1.5)
            {
                float spotDirectionLengthSquared = dot(light.direction.xyz,
                                                       light.direction.xyz);
                if (!IsFiniteScalar(spotDirectionLengthSquared) ||
                    spotDirectionLengthSquared <= 1.0e-12)
                {
                    continue;
                }
                vec3 lightToSurfaceDirection =
                    -light.direction.xyz * inversesqrt(spotDirectionLengthSquared);
                float theta = dot(lightDirection, lightToSurfaceDirection);
                float coneWidth = max(light.direction.w - light.attenuation.y, 0.001);
                attenuation *= clamp((theta - light.attenuation.y) / coneWidth,
                                     0.0,
                                     1.0);
            }
        }
        else
        {
            continue;
        }

        float cosine = max(dot(normal, lightDirection), 0.0);
        if (cosine <= 0.0 || attenuation <= 0.0 ||
            IsOccluded(worldPosition, normal, lightDirection, shadowDistance))
        {
            continue;
        }

        vec3 lightRadiance = light.chromaticityAndIntensity.rgb *
                             light.chromaticityAndIntensity.w;
        if (!IsFiniteVector(lightRadiance))
        {
            continue;
        }
        vec3 brdf = EvaluateLambertDiffuseBRDF(baseColor);
        float viewCosine = dot(normal, viewDirection);
        if (specularWeight > 0.0 && viewCosine > 1.0e-4)
        {
            brdf *= 1.0 - specularWeight * TerrainHitSpecularAlbedo(viewCosine);
            brdf += specularWeight *
                    EvaluateTerrainHitSpecularBRDF(normal, viewDirection, lightDirection, viewCosine, cosine);
        }
        radiance += brdf * lightRadiance * (cosine * attenuation);
    }
    return SanitizeUnexposedRadiance(radiance);
}

// 今の画素の周りの8画素のうち同じ面（カメラからの距離の相対差が履歴の棄却と同じ範囲）のものとの、
// 法線の距離と材質の差の最大に余裕の倍率（RTGI_HISTORY_SURFACE_SPREAD_SCALE）を掛けて返す。TAAのジッタで
// 履歴は画素の中の別の点を写しているため、法線マップや材質textureの細かな模様の上では、同じ面でもこの程度は
// 違いうる（面の入れ替わりは距離の差で棄却する）。
void ComputeLocalSurfaceSpread(vec2 uv,
                               vec2 imageSize,
                               float viewDistance,
                               vec3 normal,
                               vec3 material,
                               out float normalSpread,
                               out float materialSpread)
{
    normalSpread = 0.0;
    materialSpread = 0.0;
    for (int index = 0; index < 9; ++index)
    {
        vec2 offset = vec2(float(index % 3 - 1), float(index / 3 - 1));
        if (index == 4)
        {
            continue;
        }
        vec2 neighborUV = uv + offset / imageSize;
        if (any(lessThan(neighborUV, vec2(0.0))) || any(greaterThanEqual(neighborUV, vec2(1.0))))
        {
            continue;
        }
        float neighborDepth = texture(gbufferDepth, neighborUV).r;
        vec3 neighborNormal = texture(gbufferNormal, neighborUV).xyz;
        vec3 neighborMaterial = texture(gbufferMaterial, neighborUV).rgb;
        float neighborNormalLengthSquared = dot(neighborNormal, neighborNormal);
        if (!IsFiniteScalar(neighborDepth) || neighborDepth >= 0.999999 ||
            !IsFiniteVector(neighborNormal) || !IsFiniteVector(neighborMaterial) ||
            !IsFiniteScalar(neighborNormalLengthSquared) || neighborNormalLengthSquared <= 1.0e-8)
        {
            continue;
        }
        vec3 neighborPosition = ReconstructWorldPosition(neighborUV, clamp(neighborDepth, 0.0, 1.0));
        float neighborDistance = length(neighborPosition - parameters.cameraPosition.xyz);
        float distanceThreshold = max(RTGI_HISTORY_DEPTH_REJECTION_THRESHOLD,
                                      0.05 * max(viewDistance, neighborDistance));
        if (!IsFiniteVector(neighborPosition) || !IsFiniteScalar(neighborDistance) ||
            abs(neighborDistance - viewDistance) > distanceThreshold)
        {
            continue;
        }
        neighborNormal *= inversesqrt(neighborNormalLengthSquared);
        normalSpread = max(normalSpread, length(neighborNormal - normal));
        vec3 materialDelta = abs(clamp(neighborMaterial, vec3(0.0), vec3(1.0)) - material);
        materialSpread = max(materialSpread, max(materialDelta.x, max(materialDelta.y, materialDelta.z)));
    }
    normalSpread *= RTGI_HISTORY_SURFACE_SPREAD_SCALE;
    materialSpread *= RTGI_HISTORY_SURFACE_SPREAD_SCALE;
}

bool TryReadReprojectedHistory(vec2 currentUV,
                               float currentDistance,
                               vec3 currentNormal,
                               vec3 currentMaterial,
                               float normalSpread,
                               float materialSpread,
                               out vec3 previousRadiance,
                               out float previousAge,
                               out float previousConfidence,
                               out float previousSkyVisibility,
                               out vec3 previousSpecularHit,
                               out float previousSpecularSky)
{
    previousSkyVisibility = 1.0;
    previousSpecularHit = vec3(0.0);
    previousSpecularSky = 1.0;
    if (parameters.temporalState.x == 0u)
    {
        return false;
    }

    vec2 velocity = texture(gbufferVelocity, currentUV).rg;
    if (!IsFiniteVector(vec3(velocity, 0.0)))
    {
        return false;
    }

    vec2 previousUV = currentUV - velocity;
    if (!IsFiniteVector(vec3(previousUV, 0.0)) ||
        any(lessThan(previousUV, vec2(0.0))) ||
        any(greaterThanEqual(previousUV, vec2(1.0))))
    {
        return false;
    }

    // 履歴には前フレームのカメラから表面までの線形距離を保存している。TAAのジッタで画素の中心が
    // フレームごとにずれるため、バイリニアの2×2の画素を1つずつ同じ表面か判定し、認めた画素だけを
    // 重みを正規化して混ぜる（石畳の目地や輪郭をまたいだ補間で、履歴全体を捨てないように）。
    ivec2 historySize = textureSize(historyRadiance, 0);
    vec2 texelPosition = previousUV * vec2(historySize) - vec2(0.5);
    ivec2 baseTexel = ivec2(floor(texelPosition));
    vec2 fraction = texelPosition - vec2(baseTexel);
    vec3 radianceSum = vec3(0.0);
    float skyVisibilitySum = 0.0;
    vec3 specularHitSum = vec3(0.0);
    float specularSkySum = 0.0;
    float ageSum = 0.0;
    float confidenceSum = 0.0;
    float weightSum = 0.0;
    // 静止が続いているフレームでは、同じ表面の法線・材質の差はTAAのジッタで画素の中の標本の位置が
    // 変わったことだけから来る（石畳の目地や法線マップの細かな模様の上では近傍のばらつきを超えうる）。
    // そこで棄却すると年齢が0へ戻り、止まった画面で疎らに明滅するため、距離と裏返りだけで判定する。
    bool bStaticView = parameters.temporalState.w > RTGI_HISTORY_DYNAMIC_MAXIMUM_AGE;
    for (int tap = 0; tap < 4; ++tap)
    {
        ivec2 offset = ivec2(tap & 1, tap >> 1);
        ivec2 texel = baseTexel + offset;
        if (any(lessThan(texel, ivec2(0))) || any(greaterThanEqual(texel, historySize)))
        {
            continue;
        }
        float bilinearWeight = (offset.x == 1 ? fraction.x : 1.0 - fraction.x) *
                               (offset.y == 1 ? fraction.y : 1.0 - fraction.y);
        if (!(bilinearWeight > 0.0))
        {
            continue;
        }

        // 距離の gba = 鏡面の光線の当たった面の光、法線の a = 鏡面の光線が空へ抜けた割合（StoreTemporalSample）
        vec4 sampledDepthSample = texelFetch(historyDepth, texel, 0);
        vec4 sampledNormalSample = texelFetch(historyNormal, texel, 0);
        float sampledDistance = sampledDepthSample.r;
        vec3 sampledNormal = sampledNormalSample.xyz;
        vec3 sampledMaterial = texelFetch(historyMaterial, texel, 0).rgb;
        vec4 sampledHistory = texelFetch(historyRadiance, texel, 0);
        vec3 sampledRadiance = sampledHistory.rgb;
        float sampledAge = texelFetch(historyAge, texel, 0).r;
        float sampledConfidence = texelFetch(historyConfidence, texel, 0).r;
        if (!IsFiniteScalar(sampledDistance) || !IsFiniteVector(sampledNormal) ||
            !IsFiniteVector(sampledMaterial) || !IsFiniteVector(sampledRadiance) ||
            !IsFiniteScalar(sampledAge) || !IsFiniteScalar(sampledConfidence))
        {
            continue;
        }

        float sampledNormalLengthSquared = dot(sampledNormal, sampledNormal);
        if (!IsFiniteScalar(sampledNormalLengthSquared) ||
            sampledNormalLengthSquared <= 1.0e-8)
        {
            continue;
        }
        sampledNormal *= inversesqrt(sampledNormalLengthSquared);
        // 非線形なNDC深度は遠景で差が潰れるため、線形距離の相対差で遮蔽の入れ替わりを棄却する。
        float depthThreshold = max(RTGI_HISTORY_DEPTH_REJECTION_THRESHOLD,
                                   0.05 * max(currentDistance, sampledDistance));
        if (abs(currentDistance - sampledDistance) > depthThreshold ||
            dot(currentNormal, sampledNormal) <= 0.0)
        {
            continue;
        }
        // 法線と材質は、固定の閾値か、近傍の同じ面のばらつき（ComputeLocalSurfaceSpread）の大きい方まで許す。
        if (!bStaticView)
        {
            if (dot(currentNormal, sampledNormal) < RTGI_HISTORY_NORMAL_REJECTION_DOT &&
                length(currentNormal - sampledNormal) > normalSpread)
            {
                continue;
            }
            vec3 materialDelta = abs(currentMaterial - sampledMaterial);
            if (max(materialDelta.x, max(materialDelta.y, materialDelta.z)) >
                max(RTGI_HISTORY_MATERIAL_REJECTION_THRESHOLD, materialSpread))
            {
                continue;
            }
        }

        radianceSum += sampledRadiance * bilinearWeight;
        skyVisibilitySum += (IsFiniteScalar(sampledHistory.a) ? clamp(sampledHistory.a, 0.0, 1.0) : 1.0) *
                            bilinearWeight;
        specularHitSum += (IsFiniteVector(sampledDepthSample.gba) ? max(sampledDepthSample.gba, vec3(0.0)) : vec3(0.0)) *
                          bilinearWeight;
        specularSkySum += (IsFiniteScalar(sampledNormalSample.a) ? clamp(sampledNormalSample.a, 0.0, 1.0) : 1.0) *
                          bilinearWeight;
        ageSum += sampledAge * bilinearWeight;
        confidenceSum += sampledConfidence * bilinearWeight;
        weightSum += bilinearWeight;
    }
    // 認めた画素の重みが小さすぎるときは、その画素へ寄せすぎないよう履歴を使わない。
    if (!(weightSum >= RTGI_HISTORY_MINIMUM_TAP_WEIGHT))
    {
        return false;
    }
    previousRadiance = radianceSum / weightSum;
    previousSkyVisibility = skyVisibilitySum / weightSum;
    previousSpecularHit = specularHitSum / weightSum;
    previousSpecularSky = specularSkySum / weightSum;
    previousAge = ageSum / weightSum;
    previousConfidence = confidenceSum / weightSum;

    previousAge = clamp(previousAge,
                        0.0,
                        min(float(parameters.temporalState.w),
                            float(RTGI_HISTORY_MAXIMUM_AGE)));
    previousConfidence = clamp(previousConfidence, 0.0, 1.0);
    // 履歴を書いたフレームの露出から今のフレームの露出へ掛け直す。
    float historyExposureScale = parameters.previousCameraPosition.w;
    if (IsFiniteScalar(historyExposureScale) && historyExposureScale > 0.0)
    {
        previousRadiance *= historyExposureScale;
        previousSpecularHit *= historyExposureScale;
    }
    previousRadiance = SanitizeRadiance(previousRadiance);
    previousSpecularHit = SanitizeRadiance(previousSpecularHit);
    return true;
}

// 0 以上の値を、上下の隣の半精度の値のどちらかへ、期待値が元の値になる確率で丸める（u は 0〜1 の一様乱数）。
// 静止時の履歴は 1 フレームに差の 1/257 しか動かず、その更新は半精度の刻み（値の 2.4〜4.9×10⁻⁴）と同じ桁なので、
// 最も近い値への丸めでは小さな更新が消えて大きな更新だけが残る。消え方は成分ごとの指数の位置で違うので、
// 履歴に成分ごとの偏り（照り返しの色のずれ）が積もる。確率的に丸めると、丸めの誤差は平均で 0 になる
float StochasticRoundToHalf(float value, float u)
{
    uint nearestBits = packHalf2x16(vec2(value, 0.0)) & 0xFFFFu;
    float nearest = unpackHalf2x16(nearestBits).x;
    if (nearest == value || !(value > 0.0) || nearestBits >= 0x7BFFu)
    {
        return nearest;
    }
    // packHalf2x16 の丸めの向きは実装で違うので、値を挟むもう一方の隣を値との大小から決める
    uint otherBits = nearest > value ? nearestBits - 1u : nearestBits + 1u;
    float other = unpackHalf2x16(otherBits).x;
    float lower = min(nearest, other);
    float upper = max(nearest, other);
    float upperProbability = (value - lower) / max(upper - lower, 1.0e-30);
    return u < upperProbability ? upper : lower;
}

void StoreTemporalSample(uvec2 pixel,
                         vec3 radiance,
                         float age,
                         float confidence,
                         float viewDistance,
                         vec3 normal,
                         vec4 material,
                         float skyVisibility,
                         float diagnosticCode,
                         vec3 specularHit,
                         float specularSky)
{
    vec3 safeRadiance = SanitizeRadiance(radiance);
    // 履歴の a = 時間の蓄積の後の空の分、出力の a = 2 × 符号 + 空の分（空間のフィルタが空の分を取り出して均し、照明が
    // 鏡面の環境光の遮りに使う）。符号は遮蔽の診断のときだけ生の空 + 2 × 読み飛ばしの分類で、診断しないときは 0
    float safeSkyVisibility = IsFiniteScalar(skyVisibility) ? clamp(skyVisibility, 0.0, 1.0) : 1.0;
    float outputAlpha = IsOcclusionDiagnosticEnabled() ? 2.0 * diagnosticCode + safeSkyVisibility : safeSkyVisibility;
    float historyAlpha = safeSkyVisibility;
    float safeAge = IsFiniteScalar(age)
        ? clamp(age,
                0.0,
                min(float(parameters.temporalState.w),
                    float(RTGI_HISTORY_MAXIMUM_AGE)))
        : 0.0;
    float safeConfidence = IsFiniteScalar(confidence)
        ? clamp(confidence, 0.0, 1.0)
        : 0.0;
    float safeDistance = IsFiniteScalar(viewDistance) ? clamp(viewDistance, 0.0, 65504.0) : 0.0;
    vec3 safeNormal = IsFiniteVector(normal) ? normal : vec3(0.0);
    vec4 safeMaterial = material;
    if (!IsFiniteVector(safeMaterial.rgb))
    {
        safeMaterial = vec4(0.0);
    }
    safeMaterial = clamp(safeMaterial, vec4(0.0), vec4(1.0));

    imageStore(diffuseIndirect, ivec2(pixel), vec4(safeRadiance, outputAlpha));
    // 次のフレームが読む履歴だけを確率的に丸める（この画の出力は最も近い値への 1 回の丸めのまま）
    uint frameIndex = parameters.sampleState.x;
    vec3 roundedHistoryRadiance = vec3(
        StochasticRoundToHalf(safeRadiance.r, EmitterRandom(pixel, frameIndex, 11u)),
        StochasticRoundToHalf(safeRadiance.g, EmitterRandom(pixel, frameIndex, 12u)),
        StochasticRoundToHalf(safeRadiance.b, EmitterRandom(pixel, frameIndex, 13u)));
    imageStore(historyRadianceOutput, ivec2(pixel), vec4(roundedHistoryRadiance, historyAlpha));
    imageStore(historyAgeOutput, ivec2(pixel), vec4(safeAge, 0.0, 0.0, 0.0));
    imageStore(historyConfidenceOutput,
               ivec2(pixel),
               vec4(safeConfidence, 0.0, 0.0, 0.0));
    // 鏡面の光線の蓄積は距離の gba と法線の a に置く（照明が鏡面の環境光に読む）。当たった面の光も確率的に丸める
    vec3 safeSpecularHit = SanitizeRadiance(specularHit);
    vec3 roundedSpecularHit = vec3(
        StochasticRoundToHalf(safeSpecularHit.r, EmitterRandom(pixel, frameIndex, 28u)),
        StochasticRoundToHalf(safeSpecularHit.g, EmitterRandom(pixel, frameIndex, 29u)),
        StochasticRoundToHalf(safeSpecularHit.b, EmitterRandom(pixel, frameIndex, 30u)));
    float safeSpecularSky = IsFiniteScalar(specularSky) ? clamp(specularSky, 0.0, 1.0) : 1.0;
    imageStore(historyDepthOutput,
               ivec2(pixel),
               vec4(safeDistance, roundedSpecularHit));
    imageStore(historyNormalOutput,
               ivec2(pixel),
               vec4(safeNormal, safeSpecularSky));
    imageStore(historyMaterialOutput, ivec2(pixel), safeMaterial);
}

// 地形の当たりの色: ラスタの 3 層の混ぜ合わせ（Common/TerrainLayerBlend.glsl）を、当たりの点の分類の重みと各層の
// 素材の平均の色で近似する。斑・凹凸の混ぜ・揺らぎ・地層は平均（被覆の割合）へ寄せる。値は TerrainLayerBlend.glsl と同じ
const float RTGI_TERRAIN_SAND_FLOOR = 0.02; // TERRAIN_SURFACE_MASK_SAND_FLOOR
// 細粒の地表のうち礫の舗石（土の枠）になる割合（TERRAIN_PAVEMENT_* の値ノイズの和が 0.56 ± 0.05 を越える平均の割合）
const float RTGI_TERRAIN_FINE_PAVEMENT_COVERAGE = 0.34;
const float RTGI_TERRAIN_CRUST_COVERAGE = 0.3; // TERRAIN_CRUST_MEAN_COVERAGE
const uint RTGI_TERRAIN_SAND_ALBEDO_SRGB_DECODE = 4u;
const uint RTGI_TERRAIN_DIRT_ALBEDO_SRGB_DECODE = 8u;
const uint RTGI_TERRAIN_ROCK_ALBEDO_SRGB_DECODE = 16u;

vec3 TerrainBounceSrgbToLinear(vec3 encoded)
{
    vec3 c = clamp(encoded, vec3(0.0), vec3(1.0));
    return mix(pow((c + 0.055) / 1.055, vec3(2.4)), c / 12.92, lessThanEqual(c, vec3(0.04045)));
}

bool IsTerrainAtlasPair(sampler2D albedo)
{
    ivec2 size = textureSize(albedo, 0);
    return size.x == size.y * 2 && textureQueryLevels(albedo) >= 2;
}

// 素材の平均の色（最も粗いミップ）。横 2 枚の並びなら atlasHalf の枠（0 = 左・1 = 右）の平均（1 つ手前の 2×1 のミップ）
vec3 TerrainLayerMeanAlbedo(sampler2D albedo, int atlasHalf, bool bDecode)
{
    int levels = textureQueryLevels(albedo);
    vec3 color = atlasHalf >= 0 && IsTerrainAtlasPair(albedo)
        ? texelFetch(albedo, ivec2(atlasHalf, 0), levels - 2).rgb
        : texelFetch(albedo, ivec2(0), max(levels - 1, 0)).rgb;
    return bDecode ? TerrainBounceSrgbToLinear(color) : color;
}

// 当たりの点の砂・土・岩肌の重み（合計 1）。sandShare は 1 層目のうち地図の砂（砂の枠の右）の割合
vec3 TerrainBounceWeights(vec3 position, vec3 normal, out float sandShare)
{
    sandShare = 0.0;
    // 傾斜の式（地図の外と外縁の帯。境目の揺らぎのノイズは平均の 0）
    float slope = acos(clamp(normal.y, -1.0, 1.0));
    float heightBias = smoothstep(parameters.terrainHeight.x, parameters.terrainHeight.y, position.y) *
                       parameters.terrainHeight.z;
    float dirt = smoothstep(parameters.terrainSlope.x, parameters.terrainSlope.y, slope + heightBias);
    float rock = smoothstep(parameters.terrainSlope.z, parameters.terrainSlope.w, slope);
    vec3 slopeWeights = vec3((1.0 - dirt) * (1.0 - rock), dirt * (1.0 - rock), rock);
    vec2 invSize = parameters.terrainMask.zw;
    if (invSize.x <= 0.0 || invSize.y <= 0.0)
    {
        return slopeWeights;
    }
    vec2 uv = (position.xz - parameters.terrainMask.xy) * invSize;
    vec2 edgeMeters = min(uv, vec2(1.0) - uv) / invSize;
    float coverage = clamp(min(edgeMeters.x, edgeMeters.y) / max(parameters.terrainMaskMix.y, 1.0e-3), 0.0, 1.0);
    if (coverage <= 0.0)
    {
        return slopeWeights;
    }
    vec4 classes = textureLod(terrainSurfaceMask, uv, 0.0);
    float total = classes.r + classes.g + classes.b + classes.a;
    float sand = max(1.0 - total - RTGI_TERRAIN_SAND_FLOOR, 0.0);
    if (total + sand < 1.0e-3)
    {
        return slopeWeights;
    }
    // 細粒と礫を、舗石の斑の平均の割合で砂の枠（土）と土の枠（礫の舗石）へ分ける
    float gravelToDirt = parameters.terrainMaskMix.x;
    float soil = classes.b * (1.0 - RTGI_TERRAIN_FINE_PAVEMENT_COVERAGE) + classes.a * (1.0 - gravelToDirt);
    vec3 maskWeights = vec3(soil + sand,
                            classes.g + classes.b * RTGI_TERRAIN_FINE_PAVEMENT_COVERAGE + classes.a * gravelToDirt,
                            classes.r) / (total + sand);
    vec3 weights = mix(slopeWeights, maskWeights, coverage);
    float sandWeight = soil + sand > 1.0e-6 ? maskWeights.x * (sand / (soil + sand)) * coverage : 0.0;
    sandShare = weights.x > 1.0e-4 ? clamp(sandWeight / weights.x, 0.0, 1.0) : 0.0;
    return weights;
}

// 地形の当たりの反射率（0〜1）
vec3 TerrainBounceAlbedo(vec3 position, vec3 normal)
{
    uint decodeBits = uint(parameters.terrainMaskMix.z + 0.5);
    bool bSandDecode = (decodeBits & RTGI_TERRAIN_SAND_ALBEDO_SRGB_DECODE) != 0u;
    bool bDirtDecode = (decodeBits & RTGI_TERRAIN_DIRT_ALBEDO_SRGB_DECODE) != 0u;
    float sandShare;
    vec3 weights = TerrainBounceWeights(position, normal, sandShare);
    // 1 層目: 砂の枠の左（赤茶の土）に、土の枠の右（皮膜）を平均の被覆で、砂の枠の右（地図の砂）を地図の割合で混ぜる
    vec3 firstLayer = TerrainLayerMeanAlbedo(terrainSandAlbedo, 0, bSandDecode);
    if (IsTerrainAtlasPair(terrainDirtAlbedo))
    {
        firstLayer = mix(firstLayer, TerrainLayerMeanAlbedo(terrainDirtAlbedo, 1, bDirtDecode),
                         RTGI_TERRAIN_CRUST_COVERAGE);
    }
    if (IsTerrainAtlasPair(terrainSandAlbedo))
    {
        firstLayer = mix(firstLayer, TerrainLayerMeanAlbedo(terrainSandAlbedo, 1, bSandDecode), sandShare);
    }
    vec3 dirt = TerrainLayerMeanAlbedo(terrainDirtAlbedo, 0, bDirtDecode);
    vec3 rock = TerrainLayerMeanAlbedo(terrainRockAlbedo, -1,
                                       (decodeBits & RTGI_TERRAIN_ROCK_ALBEDO_SRGB_DECODE) != 0u);
    return clamp(firstLayer * weights.x + dirt * weights.y + rock * weights.z, vec3(0.0), vec3(1.0));
}

// 拡散の散乱光線を1本たどり、始点へ入る放射輝度を返す。外れれば環境光、当たれば命中面の点・spot・
// 方向光と発光三角形の直接光（コサイン標本が発光面に当たっても発光は加えない）。命中面の位置・光線側の
// 法線・反射率を返し、呼び側がそこからさらに散乱をたどれるようにする。hitCustomIndexは当たった
// instanceのcustom index（外れればRTGI_NO_HIT）。
// proxyHeightLimit が 0 以上のとき、光線は法線 surfaceNormal の 1 次面から RAY_ORIGIN_OFFSET だけずらした始点から
// 出ている。当てた面の 1 次面からの高さが当てた instance の光線の形のずれ（rayProxy.x。proxyHeightLimit で頭打ち）
// より低ければ、粗い光線の形がラスタの面の上に出ている所への自分の面への当たりとみなし、その先から引き直す。
// 光線の形の面へ外から入る当たりは読み飛ばさない。
const uint RTGI_NO_HIT = 0xFFFFFFFFu;

// 株の画素から出る光線は冠で遮らない（株の見た目を変えない）。ShadeDiffuseIndirect が 1 次面ごとに置く
bool gFoliageCrownOcclusion = true;

// 始点 origin から向き direction（長さ 1）へ maxDistance までに通る株の冠の透過。冠の中の弦の長さを冠の直径に対する割合にし、
// 中心を通る光線の光学的な厚さに掛けて足す
float FoliageCrownTransmittance(vec3 origin, vec3 direction, float maxDistance)
{
    uint crownCount = uint(max(parameters.foliageOcclusion.x, 0.0) + 0.5);
    if (!gFoliageCrownOcclusion || crownCount == 0u)
    {
        return 1.0;
    }
    float opticalDepth = 0.0;
    for (uint index = 0u; index < crownCount; ++index)
    {
        vec4 centerAndDepth = foliageCrowns[2u * index];
        vec3 inverseRadii = foliageCrowns[2u * index + 1u].xyz;
        // 冠を単位球へ写した空間で光線と球の交わりを解く
        vec3 localOrigin = (origin - centerAndDepth.xyz) * inverseRadii;
        vec3 localDirection = direction * inverseRadii;
        float a = dot(localDirection, localDirection);
        float b = dot(localOrigin, localDirection);
        float c = dot(localOrigin, localOrigin) - 1.0;
        float discriminant = b * b - a * c;
        if (a <= 0.0 || discriminant <= 0.0)
        {
            continue;
        }
        float root = sqrt(discriminant);
        float entry = max((-b - root) / a, 0.0);
        float exit = min((-b + root) / a, maxDistance);
        if (exit <= entry)
        {
            continue;
        }
        // 単位球の中の弦の長さ ÷ 直径 2
        opticalDepth += centerAndDepth.w * (exit - entry) * sqrt(a) * 0.5;
    }
    return exp(-opticalDepth);
}

vec3 TraceDiffuseRay(vec3 rayOrigin,
                     vec3 rayDirection,
                     vec3 surfaceNormal,
                     float proxyHeightLimit,
                     uvec2 pixel,
                     uint emitterDimension,
                     out bool bSurfaceHit,
                     out vec3 hitPosition,
                     out vec3 hitNormal,
                     out vec3 hitBaseColor,
                     out float hitSpecularWeight,
                     out uint hitCustomIndex)
{
    bSurfaceHit = false;
    hitPosition = vec3(0.0);
    hitNormal = vec3(0.0);
    hitBaseColor = vec3(0.0);
    hitSpecularWeight = 0.0;
    hitCustomIndex = RTGI_NO_HIT;

    rayQueryEXT query;
    float rayMinimum = parameters.rayLimits.x;
    float hitDistance = 0.0;
    RTGIInstanceData hitInstance;
    vec3 triangleNormal;
    // 拡散の光線は影を落とす物体を調べ、シーンが頼めば影を落とさない不透明物体（散らした小物）にも当てて、その根元の空の光を遮る。
    // 光源への影の光線（IsOccluded・IsEmitterSegmentOccluded）は直接光の影と揃えるため影を落とす物体だけのまま
    uint diffuseRayMask = parameters.environmentParameters.w > 0.5
        ? (RayTracingInstanceMaskShadowCaster | RayTracingInstanceMaskNonShadowCaster)
        : RayTracingInstanceMaskShadowCaster;
    for (uint attempt = 0u; attempt <= RTGI_PROXY_SELF_HIT_SKIPS; ++attempt)
    {
        rayQueryInitializeEXT(query,
                              sceneTopLevel,
                              gl_RayFlagsOpaqueEXT,
                              diffuseRayMask,
                              rayOrigin,
                              rayMinimum,
                              rayDirection,
                              parameters.rayLimits.y);
        while (rayQueryProceedEXT(query))
        {
        }

        if (rayQueryGetIntersectionTypeEXT(query, true) !=
            gl_RayQueryCommittedIntersectionTriangleEXT)
        {
            hitCustomIndex = RTGI_NO_HIT;
            if (parameters.rayLimits.w > 0.0)
            {
                // 静的HDRの太陽のような極端に明るい画素は、少ない光線では確率的な粒になるので上限で縮める
                return LimitStaticEnvironmentRadiance(textureLod(environmentRadiance,
                                                                 EquirectangularUV(rayDirection),
                                                                 0.0).rgb) * parameters.rayLimits.w *
                       FoliageCrownTransmittance(rayOrigin, rayDirection, parameters.rayLimits.y);
            }
            return vec3(0.0);
        }

        hitDistance = rayQueryGetIntersectionTEXT(query, true);
        uint customIndex = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(query, true));
        hitCustomIndex = customIndex;
        uint primitiveIndex = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
        if (!IsFiniteScalar(hitDistance) || hitDistance < 0.0 ||
            !TryGetInstanceData(customIndex, hitInstance) ||
            !TryGetWorldTriangleNormal(query, primitiveIndex, hitInstance, triangleNormal))
        {
            return vec3(0.0);
        }
        // 影を落とさない物体（崖錐の岩）の光線の形は最も粗い段でラスタとのずれが大きく、その物体の 1 次面から出た光線は
        // すぐ近くで自分の光線の形に当たる（岩の面の黒い斑）。光線の形のずれ（rayProxy.x）と 1 次面の読み飛ばしの高さの
        // 上限（proxyHeightLimit）の大きい方より近い当たりは読み飛ばす。岩の根元の地面からの光線は岩までの道のりが長いので、遮りは残る
        if (hitInstance.rayProxy.z > 0.5 && hitDistance < max(hitInstance.rayProxy.x, proxyHeightLimit) &&
            attempt < RTGI_PROXY_SELF_HIT_SKIPS)
        {
            rayMinimum = hitDistance + RAY_ORIGIN_OFFSET;
            continue;
        }
        float hitHeight = RAY_ORIGIN_OFFSET + hitDistance * dot(rayDirection, surfaceNormal);
        // 光線の形の面を 1 次面の側へ向けた法線に対して光線が入っていく当たり（起伏の上の点から隣の地面へ向かう光線）は、
        // 細かい面でも隣の地面に当たるので読み飛ばさない。読み飛ばすのは光線の形の内側から外へ出る当たりだけ
        vec3 proxyOutward = dot(triangleNormal, surfaceNormal) < 0.0 ? -triangleNormal : triangleNormal;
        bool bEntersProxy = dot(rayDirection, proxyOutward) < 0.0;
        // 内側から出る当たりは、1 次面が光線の形の下に沈んでいる所。当てると裏から当たった点の散乱が地面の下の空を拾うので、
        // 近くの高さの上限を RTGI_PROXY_EXIT_HEIGHT_SCALE 倍まで広げて読み飛ばす
        float skipHeight = min(hitInstance.rayProxy.x, proxyHeightLimit * RTGI_PROXY_EXIT_HEIGHT_SCALE);
        if (proxyHeightLimit < 0.0 || attempt == RTGI_PROXY_SELF_HIT_SKIPS || bEntersProxy ||
            !(hitInstance.rayProxy.x > 0.0 && hitHeight < skipHeight))
        {
            break;
        }
        gOcclusionDiagSkippedHeight = max(gOcclusionDiagSkippedHeight, hitHeight);
        rayMinimum = hitDistance + RAY_ORIGIN_OFFSET;
    }
    if (dot(triangleNormal, rayDirection) > 0.0)
    {
        triangleNormal = -triangleNormal;
    }
    bSurfaceHit = true;
    hitPosition = rayOrigin + rayDirection * hitDistance;
    hitNormal = triangleNormal;
    hitBaseColor = hitInstance.baseColor.rgb;
    // 地形の 3 層の混ぜ合わせの材質は、当たりの点の分類と層の平均の色を instance の色に掛け、鏡面を足す
    if (hitInstance.rayProxy.y > 0.5 && parameters.terrainMaskMix.w > 0.5)
    {
        hitBaseColor *= TerrainBounceAlbedo(hitPosition, triangleNormal);
        hitSpecularWeight = 1.0;
    }
    // 照り返しを切る撮影（--rtgi-bounce=off）は当たりの色と鏡面を 0 にする（外れた光線の空の光だけが残る）
    hitBaseColor *= parameters.environmentParameters.y;
    hitSpecularWeight *= parameters.environmentParameters.y;
    return LimitRayRadiance(ComputeDirectRadiance(hitPosition, hitNormal, hitBaseColor, -rayDirection,
                                                  hitSpecularWeight) +
                           hitBaseColor * SampleEmitterIrradiance(hitPosition, hitNormal, pixel, emitterDimension)) *
           FoliageCrownTransmittance(rayOrigin, rayDirection, hitDistance);
}

// 1 本目の光線が当たった面が、空と周りの面からもう 1 本のコサイン標本で受けて光線の始点へ返す光（2 回目のバウンス）。
// rayDirection は 1 本目の光線の向き、directionDimension・emitterDimension は乱数の次元
vec3 TraceSecondBounce(vec3 rayDirection,
                       vec3 bounceHitPosition,
                       vec3 bounceHitNormal,
                       vec3 bounceHitBaseColor,
                       float bounceHitSpecularWeight,
                       uvec2 pixel,
                       uint directionDimension,
                       uint emitterDimension)
{
    // 方向の乱数は 1 本目の R2 列と独立にする（同じ列の位相だと画素ごとに 2 本の方向が固定の組になる）
    uint frameIndex = parameters.sampleState.x;
    vec3 secondDirection = CosineWeightedDirectionFromUnit(
        bounceHitNormal,
        vec2(EmitterRandom(pixel, frameIndex, directionDimension),
             EmitterRandom(pixel, frameIndex, directionDimension + 1u)));
    bool bSecondHit;
    vec3 secondHitPosition;
    vec3 secondHitNormal;
    vec3 secondHitBaseColor;
    float secondHitSpecularWeight;
    uint secondHitCustomIndex;
    vec3 secondIncoming = TraceDiffuseRay(
        bounceHitPosition + bounceHitNormal * RAY_ORIGIN_OFFSET,
        secondDirection, bounceHitNormal, -1.0, pixel, emitterDimension,
        bSecondHit, secondHitPosition, secondHitNormal, secondHitBaseColor,
        secondHitSpecularWeight, secondHitCustomIndex);
    // 拡散面の出る放射輝度は反射率/π×照度で、コサイン標本の照度の推定はπ×入射放射輝度。
    // 鏡面のある当たり（地形）は、同じ標本で鏡面の映り込み（空の光と周りの面の光）も返す。コサイン標本の
    // 重みは π×BRDF。拡散は命中面の直接光と同じく鏡面が返す分だけ減る。これが無いと、色の濃い砂の
    // 照り返しに混ざる色の付かない空の映り込みが抜け、照り返しが Cycles より赤くなる
    vec3 secondReflectance = bounceHitBaseColor;
    float bounceViewCosine = dot(bounceHitNormal, -rayDirection);
    if (bounceHitSpecularWeight > 0.0 && bounceViewCosine > 1.0e-4)
    {
        secondReflectance *= 1.0 - bounceHitSpecularWeight *
                                       TerrainHitSpecularAlbedo(bounceViewCosine);
        float secondCosine = dot(bounceHitNormal, secondDirection);
        if (secondCosine > 1.0e-4)
        {
            secondReflectance += bounceHitSpecularWeight * PI *
                EvaluateTerrainHitSpecularBRDF(bounceHitNormal, -rayDirection, secondDirection,
                                               bounceViewCosine, secondCosine);
        }
    }
    return secondReflectance * SanitizeUnexposedRadiance(secondIncoming);
}

// GGX の見える法線の分布（Heitz 2018）から半ベクトルを引く。viewTangent は接空間（z = 法線）の視線、alpha = ラフネスの 2 乗
vec3 SampleGGXVisibleNormal(vec3 viewTangent, float alpha, vec2 xi)
{
    vec3 stretchedView = normalize(vec3(alpha * viewTangent.x, alpha * viewTangent.y, viewTangent.z));
    float lengthSquared = dot(stretchedView.xy, stretchedView.xy);
    vec3 axis1 = lengthSquared > 1.0e-8 ? vec3(-stretchedView.y, stretchedView.x, 0.0) * inversesqrt(lengthSquared)
                                        : vec3(1.0, 0.0, 0.0);
    vec3 axis2 = cross(stretchedView, axis1);
    float radius = sqrt(xi.x);
    float angle = 2.0 * PI * xi.y;
    float t1 = radius * cos(angle);
    float t2 = radius * sin(angle);
    float blend = 0.5 * (1.0 + stretchedView.z);
    t2 = (1.0 - blend) * sqrt(max(0.0, 1.0 - t1 * t1)) + blend * t2;
    vec3 stretchedNormal = t1 * axis1 + t2 * axis2 +
                           sqrt(max(0.0, 1.0 - t1 * t1 - t2 * t2)) * stretchedView;
    return normalize(vec3(alpha * stretchedNormal.x, alpha * stretchedNormal.y, max(stretchedNormal.z, 0.0)));
}

// 鏡面の光線が当たった点が画面に見えている面なら、その面の拡散の照り返し（前フレームの履歴。露出前に戻す）を返す。
// 履歴はその面の GBuffer のアルベドで照り返しを数え、前のフレームまでの照り返しを含むので、光線の 2 回目のバウンスより
// 多くのバウンスを含む（室内の日陰の壁のように照り返しだけで照らされる面の映り込みが暗くならない）
bool TryReadScreenIndirect(vec3 hitPosition, out vec3 radiance)
{
    radiance = vec3(0.0);
    if (parameters.temporalState.x == 0u)
    {
        return false;
    }
    vec4 clipPosition = inverse(parameters.invViewProjection) * vec4(hitPosition, 1.0);
    if (!IsFiniteScalar(clipPosition.w) || clipPosition.w <= 1.0e-6)
    {
        return false;
    }
    vec2 uv = clipPosition.xy / clipPosition.w * 0.5 + 0.5;
    if (!IsFiniteVector(vec3(uv, 0.0)) || any(lessThan(uv, vec2(0.0))) || any(greaterThanEqual(uv, vec2(1.0))))
    {
        return false;
    }
    float visibleDepth = textureLod(gbufferDepth, uv, 0.0).r;
    if (!IsFiniteScalar(visibleDepth) || visibleDepth >= 0.999999)
    {
        return false;
    }
    // 画面に見えている面が当たった点と同じか（手前の物に隠れていないか）を位置の差で確かめる
    vec3 visiblePosition = ReconstructWorldPosition(uv, visibleDepth);
    float hitDistance = length(hitPosition - parameters.cameraPosition.xyz);
    if (!IsFiniteVector(visiblePosition) ||
        length(visiblePosition - hitPosition) > max(RTGI_SCREEN_INDIRECT_POSITION_TOLERANCE,
                                                    RTGI_SCREEN_INDIRECT_RELATIVE_TOLERANCE * hitDistance))
    {
        return false;
    }
    vec2 velocity = textureLod(gbufferVelocity, uv, 0.0).rg;
    vec2 previousUV = uv - velocity;
    if (!IsFiniteVector(vec3(previousUV, 0.0)) || any(lessThan(previousUV, vec2(0.0))) ||
        any(greaterThanEqual(previousUV, vec2(1.0))))
    {
        return false;
    }
    ivec2 historySize = textureSize(historyRadiance, 0);
    ivec2 historyTexel = clamp(ivec2(previousUV * vec2(historySize)), ivec2(0), historySize - ivec2(1));
    vec3 historyValue = texelFetch(historyRadiance, historyTexel, 0).rgb;
    float historyExposureScale = parameters.previousCameraPosition.w;
    float preExposure = IsFiniteScalar(parameters.rayLimits.z) && parameters.rayLimits.z > 0.0
        ? clamp(parameters.rayLimits.z, 1.0e-6, 1.0e6)
        : 1.0;
    if (!IsFiniteVector(historyValue) || !IsFiniteScalar(historyExposureScale) || !(historyExposureScale > 0.0))
    {
        return false;
    }
    radiance = SanitizeUnexposedRadiance(max(historyValue, vec3(0.0)) * historyExposureScale / preExposure);
    return true;
}

// 鏡面の光線: 反射の向きの周り（GGX のローブ）へ 1 本引き、空へ抜けたか（bSky）と当たった面が返す光（露出前、
// 直接光・発光・2 回目のバウンス）を返す。空へ抜けた向きの光は照明が空の前計算から足すので、ここでは数えない
vec3 TraceSpecularRay(vec3 worldPosition,
                      vec3 worldNormal,
                      float roughness,
                      float viewDistance,
                      uvec2 pixel,
                      out bool bSky)
{
    bSky = true;
    vec3 viewDirection = normalize(parameters.cameraPosition.xyz - worldPosition);
    vec3 tangent;
    vec3 bitangent;
    BuildOrthonormalBasis(worldNormal, tangent, bitangent);
    vec3 viewTangent = vec3(dot(viewDirection, tangent), dot(viewDirection, bitangent), dot(viewDirection, worldNormal));
    if (!(viewTangent.z > 1.0e-4))
    {
        return vec3(0.0);
    }
    uint frameIndex = parameters.sampleState.x;
    float alpha = max(roughness * roughness, 1.0e-3);
    vec3 halfTangent = SampleGGXVisibleNormal(viewTangent, alpha,
                                              vec2(EmitterRandom(pixel, frameIndex, 14u),
                                                   EmitterRandom(pixel, frameIndex, 15u)));
    vec3 halfVector = normalize(tangent * halfTangent.x + bitangent * halfTangent.y + worldNormal * halfTangent.z);
    vec3 rayDirection = reflect(-viewDirection, halfVector);
    if (!(dot(rayDirection, worldNormal) > 1.0e-4))
    {
        // 地平の下へ向いた標本は鏡の向きに寄せる
        rayDirection = reflect(-viewDirection, worldNormal);
    }
    bool bHit;
    vec3 hitPosition;
    vec3 hitNormal;
    vec3 hitBaseColor;
    float hitSpecularWeight;
    uint hitCustomIndex;
    vec3 hitRadiance = TraceDiffuseRay(worldPosition + worldNormal * RAY_ORIGIN_OFFSET, rayDirection, worldNormal,
                                       ProxySelfHitHeightLimit(viewDistance), pixel, 22u,
                                       bHit, hitPosition, hitNormal, hitBaseColor, hitSpecularWeight,
                                       hitCustomIndex);
    if (hitCustomIndex == RTGI_NO_HIT)
    {
        return vec3(0.0);
    }
    bSky = false;
    if (!bHit)
    {
        return vec3(0.0);
    }
    vec3 screenIndirect;
    hitRadiance = SanitizeUnexposedRadiance(hitRadiance) +
                  (TryReadScreenIndirect(hitPosition, screenIndirect)
                       ? screenIndirect
                       : TraceSecondBounce(rayDirection, hitPosition, hitNormal, hitBaseColor, hitSpecularWeight,
                                           pixel, 16u, 25u));
    return SanitizeUnexposedRadiance(hitRadiance);
}

// 1画素の拡散の間接光を求めて書く。firstHitCustomIndexは1回目の拡散光線が当たったinstanceのcustom index
// （光線を引かなければRTGI_NO_HIT、外れればRTGI_NO_HIT）で、bRayTracedは光線を引いたか。
void ShadeDiffuseIndirect(uvec2 pixel, out bool bRayTraced, out uint firstHitCustomIndex)
{
    bRayTraced = false;
    firstHitCustomIndex = RTGI_NO_HIT;
    uvec2 imageSize = parameters.imageAndSceneCounts.xy;
    if (pixel.x >= imageSize.x || pixel.y >= imageSize.y)
    {
        return;
    }

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(imageSize);
    float sampledDepth = texture(gbufferDepth, uv).r;
    PbrGBufferMaterialSamples surfaceSamples =
        SamplePbrMaterialTextures(gbufferAlbedo, gbufferNormal, gbufferMaterial, uv);
    vec4 sampledMaterial = surfaceSamples.Material;
    vec3 surfaceAlbedo = surfaceSamples.Albedo.rgb;
    vec3 normal = surfaceSamples.WorldNormal.xyz;
    float normalLengthSquared = dot(normal, normal);
    bool bSurfaceValid = IsFiniteScalar(sampledDepth) &&
        sampledDepth < 0.999999 && IsFiniteVector(surfaceAlbedo) &&
        IsFiniteVector(sampledMaterial.rgb) && IsFiniteVector(normal) &&
        IsFiniteScalar(normalLengthSquared) && normalLengthSquared > 1.0e-8;

    float depth = bSurfaceValid ? clamp(sampledDepth, 0.0, 1.0) : 1.0;
    vec4 material = bSurfaceValid ? clamp(sampledMaterial, vec4(0.0), vec4(1.0))
                                  : vec4(0.0);
    vec3 worldNormal = bSurfaceValid ? normal * inversesqrt(normalLengthSquared)
                                     : vec3(0.0);
    vec3 outputRadiance = vec3(0.0);
    // 履歴の棄却判定に使う線形距離。保存するのは現在のカメラから、比べるのは前フレームのカメラから
    // 同じ表面点までの距離で、履歴側と同じカメラを基準にする。無効画素は0とする。
    float previousViewDistance = 0.0;
    float viewDistance = 0.0;
    // 遮蔽の診断: この画の 1 本目の光線が空へ抜けたか（コサイン標本なので画素の平均が空の見える割合）と読み飛ばしの分類
    float rawSkyVisibility = 1.0;
    float diagnosticCode = 0.0;
    // 鏡面の光線: 空へ抜けたか（1 / 0）と、当たった面が返す光（露出後）。光線を引かない画素は空へ抜けた扱い
    float rawSpecularSky = 1.0;
    vec3 rawSpecularHit = vec3(0.0);

    if (bSurfaceValid)
    {
        surfaceAlbedo = clamp(surfaceAlbedo, vec3(0.0), vec3(65504.0));
        vec3 worldPosition = ReconstructWorldPosition(uv, depth);
        if (!IsFiniteVector(worldPosition))
        {
            bSurfaceValid = false;
            depth = 1.0;
            material = vec4(0.0);
            worldNormal = vec3(0.0);
        }
        else
        {
            viewDistance = length(worldPosition - parameters.cameraPosition.xyz);
            previousViewDistance = length(worldPosition - parameters.previousCameraPosition.xyz);
            float diffuseWeight = EvaluateDiffuseMaterialWeight(material.r);
            vec3 rayDirection = CosineWeightedDirection(worldNormal, pixel,
                                                          parameters.sampleState.x);
            vec3 rayOrigin = worldPosition + worldNormal * RAY_ORIGIN_OFFSET;
            // 草・低木の株（GBuffer の材質の A が 0.25。foliage.frag）の画素は冠で遮らない
            gFoliageCrownOcclusion = !(material.a > 0.125 && material.a < 0.375);

            // 発光三角形の光は1次面と命中点の光源標本で数えるため、コサイン標本が発光面に
            // 当たっても発光を加えない。
            bool bBounceHit;
            vec3 bounceHitPosition;
            vec3 bounceHitNormal;
            vec3 bounceHitBaseColor;
            float bounceHitSpecularWeight;
            bRayTraced = true;
            vec3 incomingRadiance = TraceDiffuseRay(rayOrigin, rayDirection, worldNormal,
                                                    ProxySelfHitHeightLimit(viewDistance), pixel, 3u,
                                                    bBounceHit, bounceHitPosition,
                                                    bounceHitNormal, bounceHitBaseColor,
                                                    bounceHitSpecularWeight, firstHitCustomIndex);
            rawSkyVisibility = firstHitCustomIndex == RTGI_NO_HIT ? 1.0 : 0.0;
            float skipClass = gOcclusionDiagSkippedHeight < 0.0                              ? 0.0
                              : gOcclusionDiagSkippedHeight < RTGI_OCCLUSION_DIAG_SMALL_HEIGHT ? 1.0
                              : gOcclusionDiagSkippedHeight < RTGI_OCCLUSION_DIAG_LARGE_HEIGHT ? 2.0
                                                                                               : 3.0;
            diagnosticCode = rawSkyVisibility + 2.0 * skipClass;
            if (bBounceHit)
            {
                // 2回目の拡散バウンス: 命中面が空と周りの面から受ける光（影の中の地面を照らす、物体の
                // 下側の光など）を、命中点からもう1本のコサイン標本でたどって加える。
                incomingRadiance += TraceSecondBounce(rayDirection, bounceHitPosition, bounceHitNormal,
                                                      bounceHitBaseColor, bounceHitSpecularWeight, pixel, 9u, 6u);
            }

            // 鏡面の光線（鏡面の無い材質は引かない。GBuffer の材質の a が 0.5 より大きい）
            if (material.a <= 0.5)
            {
                bool bSpecularSky;
                vec3 specularHit = TraceSpecularRay(worldPosition, worldNormal, material.g, viewDistance, pixel,
                                                    bSpecularSky);
                rawSpecularSky = bSpecularSky ? 1.0 : 0.0;
                float specularPreExposure = IsFiniteScalar(parameters.rayLimits.z) && parameters.rayLimits.z > 0.0
                    ? clamp(parameters.rayLimits.z, 1.0e-6, 1.0e6)
                    : 1.0;
                rawSpecularHit = SanitizeRadiance(specularHit * specularPreExposure);
            }

            // 1次面を照らす発光三角形の直接光（反射率を掛ける前の単位でコサイン標本に加える）。
            incomingRadiance = SanitizeUnexposedRadiance(incomingRadiance) +
                               SampleEmitterIrradiance(worldPosition, worldNormal, pixel, 0u);
            float preExposure = IsFiniteScalar(parameters.rayLimits.z) &&
                                        parameters.rayLimits.z > 0.0
                                    ? clamp(parameters.rayLimits.z, 1.0e-6, 1.0e6)
                                    : 1.0;
            outputRadiance = SanitizeRadiance(incomingRadiance *
                                               surfaceAlbedo *
                                               diffuseWeight *
                                               preExposure);
        }
    }

    vec3 previousRadiance = vec3(0.0);
    float previousAge = 0.0;
    float previousConfidence = 0.0;
    float previousSkyVisibility = 1.0;
    vec3 previousSpecularHit = vec3(0.0);
    float previousSpecularSky = 1.0;
    float normalSpread = 0.0;
    float materialSpread = 0.0;
    // 静止が続いているフレームの履歴は法線・材質で棄却しないため、近傍のばらつきは要らない。
    if (bSurfaceValid && parameters.temporalState.w <= RTGI_HISTORY_DYNAMIC_MAXIMUM_AGE)
    {
        ComputeLocalSurfaceSpread(uv, vec2(imageSize), viewDistance, worldNormal, material.rgb,
                                  normalSpread, materialSpread);
    }
    bool bHistoryAccepted = bSurfaceValid &&
        TryReadReprojectedHistory(uv,
                                  previousViewDistance,
                                  worldNormal,
                                  material.rgb,
                                  normalSpread,
                                  materialSpread,
                                  previousRadiance,
                                  previousAge,
                                  previousConfidence,
                                  previousSkyVisibility,
                                  previousSpecularHit,
                                  previousSpecularSky);
    float historyWeight = 0.0;
    float outputSkyVisibility = rawSkyVisibility;
    vec3 outputSpecularHit = rawSpecularHit;
    float outputSpecularSky = rawSpecularSky;
    float outputAge = 0.0;
    float outputConfidence = bSurfaceValid ? RTGI_HISTORY_INITIAL_CONFIDENCE : 0.0;
    if (bHistoryAccepted)
    {
        historyWeight = clamp(1.0 - 1.0 / (previousAge + 1.0),
                              0.0,
                              RTGI_HISTORY_MAXIMUM_WEIGHT);
        historyWeight *= previousConfidence;
        if (parameters.temporalState.y != 0u || parameters.temporalState.z != 0u)
        {
            historyWeight = min(historyWeight, RTGI_HISTORY_LIGHT_WEIGHT_LIMIT);
        }
        historyWeight = clamp(historyWeight, 0.0, RTGI_HISTORY_MAXIMUM_WEIGHT);
        outputRadiance = mix(outputRadiance, previousRadiance, historyWeight);
        outputSkyVisibility = mix(rawSkyVisibility, previousSkyVisibility, historyWeight);
        outputSpecularHit = mix(rawSpecularHit, previousSpecularHit, historyWeight);
        outputSpecularSky = mix(rawSpecularSky, previousSpecularSky, historyWeight);
        outputAge = min(previousAge + 1.0,
                        min(float(parameters.temporalState.w),
                            float(RTGI_HISTORY_MAXIMUM_AGE)));
        outputConfidence = clamp(previousConfidence + 0.125, 0.0, 1.0);
    }

    StoreTemporalSample(pixel,
                        outputRadiance,
                        outputAge,
                        outputConfidence,
                        viewDistance,
                        worldNormal,
                        material,
                        outputSkyVisibility,
                        diagnosticCode,
                        outputSpecularHit,
                        outputSpecularSky);
}

void main()
{
    // 当たりの統計を数えるかはdispatch全体で同じ（定数バッファの値）なので、barrierは一様な制御の中にある
    bool bCountHits = parameters.sampleState.w != 0u;
    if (bCountHits)
    {
        if (gl_LocalInvocationIndex < 3u)
        {
            sharedHitStats[gl_LocalInvocationIndex] = 0u;
        }
        barrier();
    }

    bool bRayTraced;
    uint firstHitCustomIndex;
    ShadeDiffuseIndirect(gl_GlobalInvocationID.xy, bRayTraced, firstHitCustomIndex);

    if (bCountHits)
    {
        // 作業グループの中で足してから、1つの呼び出しだけがバッファへ足す
        if (bRayTraced)
        {
            atomicAdd(sharedHitStats[0], 1u);
            if (firstHitCustomIndex != RTGI_NO_HIT)
            {
                atomicAdd(sharedHitStats[1], 1u);
                if (firstHitCustomIndex >= parameters.sampleState.w - 1u)
                {
                    atomicAdd(sharedHitStats[2], 1u);
                }
            }
        }
        barrier();
        if (gl_LocalInvocationIndex == 0u && sharedHitStats[0] != 0u)
        {
            atomicAdd(hitStats.values[0], sharedHitStats[0]);
            atomicAdd(hitStats.values[1], sharedHitStats[1]);
            atomicAdd(hitStats.values[2], sharedHitStats[2]);
        }
    }
}
