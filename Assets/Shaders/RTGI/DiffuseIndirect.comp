// 1 bounceのdiffuse indirect radianceをray queryで生成する。
#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT sceneTopLevel;

layout(set = 0, binding = 1, std140) uniform RTGIComputeParameters
{
    mat4 invViewProjection;
    vec4 cameraPosition;
    uvec4 imageAndSceneCounts; // xy=画像寸法、z=インスタンス数、w=ライト数
    vec4 rayLimits; // x=最小距離、y=最大距離、z=pre-exposure、w=環境強度
} parameters;

layout(set = 0, binding = 2) uniform sampler2D gbufferNormal;
layout(set = 0, binding = 3) uniform sampler2D gbufferDepth;
layout(set = 0, binding = 4) uniform sampler2D gbufferAlbedo;
layout(set = 0, binding = 5) uniform sampler2D gbufferMaterial;
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D diffuseIndirect;

struct RTGIInstanceData
{
    uint64_t vertexAddress;
    uint64_t indexAddress;
    vec4 baseColor;
    vec4 emissiveChromaticityAndLuminance;
    uvec4 geometry; // x=stride、y=vertex count、z=index count、w=custom index
    vec4 transform0;
    vec4 transform1;
    vec4 transform2;
};

struct LightData
{
    vec4 position;
    vec4 direction;
    vec4 chromaticityAndIntensity;
    vec4 attenuation;
};

layout(set = 0, binding = 7, std430) readonly buffer RTGIInstances
{
    RTGIInstanceData values[];
} instances;

layout(set = 0, binding = 8, std430) readonly buffer RTGILights
{
    LightData values[];
} lights;

layout(set = 0, binding = 9) uniform sampler2D environmentRadiance;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer RTGIVertexData
{
    float values[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer RTGIIndexData
{
    uint values[];
};

const float PI = 3.14159265358979323846;
const float RAY_ORIGIN_OFFSET = 0.002;

bool IsFiniteVector(vec3 value)
{
    return !any(isnan(value)) && !any(isinf(value));
}

bool IsFiniteScalar(float value)
{
    return !isnan(value) && !isinf(value);
}

vec3 SanitizeRadiance(vec3 value)
{
    if (!IsFiniteVector(value))
    {
        return vec3(0.0);
    }
    return clamp(value, vec3(0.0), vec3(65504.0));
}

vec2 EquirectangularUV(vec3 direction)
{
    vec2 uv = vec2(atan(direction.z, direction.x),
                   asin(clamp(-direction.y, -1.0, 1.0)));
    return uv * vec2(0.15915494, 0.31830989) + 0.5;
}

vec3 ReconstructWorldPosition(vec2 uv, float depth)
{
    vec4 clipPosition = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPosition = parameters.invViewProjection * clipPosition;
    if (!IsFiniteVector(worldPosition.xyz) ||
        !IsFiniteScalar(worldPosition.w) || abs(worldPosition.w) <= 1.0e-8)
    {
        return vec3(0.0);
    }
    return worldPosition.xyz / worldPosition.w;
}

uint Hash32(uvec2 value)
{
    uint result = value.x * 1664525u + value.y * 1013904223u + 374761393u;
    result = (result ^ (result >> 16u)) * 2246822519u;
    result = (result ^ (result >> 13u)) * 3266489917u;
    return result ^ (result >> 16u);
}

float HashToUnit(uint value)
{
    return (float(value & 0x00FFFFFFu) + 0.5) / 16777216.0;
}

void BuildOrthonormalBasis(vec3 normal, out vec3 tangent, out vec3 bitangent)
{
    vec3 helper = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0)
                                       : vec3(0.0, 1.0, 0.0);
    tangent = normalize(cross(helper, normal));
    bitangent = cross(normal, tangent);
}

vec3 CosineWeightedDirection(vec3 normal, uvec2 pixel)
{
    float xi0 = max(HashToUnit(Hash32(pixel)), 1.0e-6);
    float xi1 = HashToUnit(Hash32(pixel.yx + uvec2(17u, 43u)));
    float radius = sqrt(xi0);
    float angle = 2.0 * PI * xi1;
    vec3 tangent;
    vec3 bitangent;
    BuildOrthonormalBasis(normal, tangent, bitangent);
    return normalize(tangent * (radius * cos(angle)) +
                     bitangent * (radius * sin(angle)) +
                     normal * sqrt(max(0.0, 1.0 - xi0)));
}

bool TryGetInstanceData(uint customIndex, out RTGIInstanceData instanceData)
{
    uint low = 0u;
    uint high = parameters.imageAndSceneCounts.z;
    while (low < high)
    {
        uint middle = low + (high - low) / 2u;
        uint candidateIndex = instances.values[middle].geometry.w;
        if (candidateIndex < customIndex)
        {
            low = middle + 1u;
        }
        else
        {
            high = middle;
        }
    }

    if (low >= parameters.imageAndSceneCounts.z ||
        instances.values[low].geometry.w != customIndex)
    {
        return false;
    }
    instanceData = instances.values[low];
    return true;
}

bool TryGetWorldTriangleNormal(rayQueryEXT query,
                               uint primitiveIndex,
                               RTGIInstanceData instanceData,
                               out vec3 worldNormal)
{
    uint vertexStrideBytes = instanceData.geometry.x;
    uint vertexCount = instanceData.geometry.y;
    uint indexCount = instanceData.geometry.z;
    if (vertexStrideBytes < 12u || (vertexStrideBytes & 3u) != 0u ||
        primitiveIndex >= indexCount / 3u)
    {
        return false;
    }

    RTGIIndexData indexBuffer = RTGIIndexData(instanceData.indexAddress);
    uint primitiveOffset = primitiveIndex * 3u;
    uvec3 vertexIndices = uvec3(indexBuffer.values[primitiveOffset],
                                indexBuffer.values[primitiveOffset + 1u],
                                indexBuffer.values[primitiveOffset + 2u]);
    if (vertexIndices.x >= vertexCount || vertexIndices.y >= vertexCount ||
        vertexIndices.z >= vertexCount)
    {
        return false;
    }

    RTGIVertexData vertexBuffer = RTGIVertexData(instanceData.vertexAddress);
    uint stride = vertexStrideBytes / 4u;
    uint vertex0Offset = vertexIndices.x * stride;
    uint vertex1Offset = vertexIndices.y * stride;
    uint vertex2Offset = vertexIndices.z * stride;
    vec3 vertex0 = vec3(vertexBuffer.values[vertex0Offset],
                        vertexBuffer.values[vertex0Offset + 1u],
                        vertexBuffer.values[vertex0Offset + 2u]);
    vec3 vertex1 = vec3(vertexBuffer.values[vertex1Offset],
                        vertexBuffer.values[vertex1Offset + 1u],
                        vertexBuffer.values[vertex1Offset + 2u]);
    vec3 vertex2 = vec3(vertexBuffer.values[vertex2Offset],
                        vertexBuffer.values[vertex2Offset + 1u],
                        vertexBuffer.values[vertex2Offset + 2u]);
    if (!IsFiniteVector(vertex0) || !IsFiniteVector(vertex1) ||
        !IsFiniteVector(vertex2))
    {
        return false;
    }

    vec3 objectNormal = cross(vertex1 - vertex0, vertex2 - vertex0);
    float normalLengthSquared = dot(objectNormal, objectNormal);
    if (!IsFiniteScalar(normalLengthSquared) || normalLengthSquared <= 1.0e-12)
    {
        return false;
    }

    mat4x3 worldToObject = rayQueryGetIntersectionWorldToObjectEXT(query, true);
    worldNormal = normalize(transpose(mat3(worldToObject)) * normalize(objectNormal));
    return IsFiniteVector(worldNormal);
}

float CalculateInverseSquareAttenuation(float distanceToLight)
{
    return 1.0 / max(distanceToLight * distanceToLight, 0.0001);
}

float CalculateRangeWindow(float distanceToLight, float range)
{
    float safeRange = max(range, 0.0001);
    float window = max(1.0 - pow(distanceToLight / safeRange, 4.0), 0.0);
    return window * window;
}

bool IsOccluded(vec3 worldPosition,
                vec3 normal,
                vec3 lightDirection,
                float maximumDistance)
{
    if (maximumDistance <= parameters.rayLimits.x)
    {
        return false;
    }

    rayQueryEXT shadowQuery;
    rayQueryInitializeEXT(shadowQuery,
                          sceneTopLevel,
                          gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
                          0xFFu,
                          worldPosition + normal * RAY_ORIGIN_OFFSET,
                          parameters.rayLimits.x,
                          lightDirection,
                          maximumDistance);
    while (rayQueryProceedEXT(shadowQuery))
    {
    }
    return rayQueryGetIntersectionTypeEXT(shadowQuery, true) ==
           gl_RayQueryCommittedIntersectionTriangleEXT;
}

vec3 ComputeDirectRadiance(vec3 worldPosition,
                           vec3 normal,
                           vec3 baseColor)
{
    vec3 radiance = vec3(0.0);
    for (uint lightIndex = 0u;
         lightIndex < parameters.imageAndSceneCounts.w;
         ++lightIndex)
    {
        LightData light = lights.values[lightIndex];
        float lightType = light.position.w;
        vec3 lightDirection;
        float attenuation = 1.0;
        float shadowDistance = parameters.rayLimits.y;

        if (lightType < 0.5)
        {
            float directionLengthSquared = dot(light.direction.xyz,
                                               light.direction.xyz);
            if (!IsFiniteScalar(directionLengthSquared) || directionLengthSquared <= 1.0e-12)
            {
                continue;
            }
            lightDirection = -light.direction.xyz * inversesqrt(directionLengthSquared);
        }
        else if (lightType < 2.5)
        {
            vec3 toLight = light.position.xyz - worldPosition;
            float distanceToLight = length(toLight);
            if (!IsFiniteScalar(distanceToLight) || distanceToLight <= 1.0e-6)
            {
                continue;
            }
            lightDirection = toLight / distanceToLight;
            attenuation = CalculateInverseSquareAttenuation(distanceToLight) *
                          CalculateRangeWindow(distanceToLight, light.attenuation.x);
            shadowDistance = max(distanceToLight - RAY_ORIGIN_OFFSET * 2.0, 0.0);
            if (lightType >= 1.5)
            {
                float spotDirectionLengthSquared = dot(light.direction.xyz,
                                                       light.direction.xyz);
                if (!IsFiniteScalar(spotDirectionLengthSquared) ||
                    spotDirectionLengthSquared <= 1.0e-12)
                {
                    continue;
                }
                vec3 lightToSurfaceDirection =
                    -light.direction.xyz * inversesqrt(spotDirectionLengthSquared);
                float theta = dot(lightDirection, lightToSurfaceDirection);
                float coneWidth = max(light.direction.w - light.attenuation.y, 0.001);
                attenuation *= clamp((theta - light.attenuation.y) / coneWidth,
                                     0.0,
                                     1.0);
            }
        }
        else
        {
            continue;
        }

        float cosine = max(dot(normal, lightDirection), 0.0);
        if (cosine <= 0.0 || attenuation <= 0.0 ||
            IsOccluded(worldPosition, normal, lightDirection, shadowDistance))
        {
            continue;
        }

        vec3 lightRadiance = light.chromaticityAndIntensity.rgb *
                             light.chromaticityAndIntensity.w;
        if (!IsFiniteVector(lightRadiance))
        {
            continue;
        }
        radiance += (baseColor / PI) * lightRadiance * (cosine * attenuation);
    }
    return SanitizeRadiance(radiance);
}

void main()
{
    uvec2 pixel = gl_GlobalInvocationID.xy;
    uvec2 imageSize = parameters.imageAndSceneCounts.xy;
    if (pixel.x >= imageSize.x || pixel.y >= imageSize.y)
    {
        return;
    }

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(imageSize);
    float depth = texture(gbufferDepth, uv).r;
    if (!IsFiniteScalar(depth) || depth >= 0.999999)
    {
        imageStore(diffuseIndirect, ivec2(pixel), vec4(0.0));
        return;
    }

    vec3 normal = texture(gbufferNormal, uv).xyz;
    float normalLengthSquared = dot(normal, normal);
    if (!IsFiniteVector(normal) || !IsFiniteScalar(normalLengthSquared) ||
        normalLengthSquared <= 1.0e-8)
    {
        imageStore(diffuseIndirect, ivec2(pixel), vec4(0.0));
        return;
    }
    normal *= inversesqrt(normalLengthSquared);

    vec3 worldPosition = ReconstructWorldPosition(uv, depth);
    if (!IsFiniteVector(worldPosition))
    {
        imageStore(diffuseIndirect, ivec2(pixel), vec4(0.0));
        return;
    }

    vec3 surfaceAlbedo = max(texture(gbufferAlbedo, uv).rgb, vec3(0.0));
    vec3 material = texture(gbufferMaterial, uv).rgb;
    if (!IsFiniteVector(surfaceAlbedo) || !IsFiniteVector(material))
    {
        imageStore(diffuseIndirect, ivec2(pixel), vec4(0.0));
        return;
    }
    surfaceAlbedo = clamp(surfaceAlbedo, vec3(0.0), vec3(65504.0));
    float diffuseWeight = clamp(1.0 - material.r, 0.0, 1.0);
    vec3 rayDirection = CosineWeightedDirection(normal, pixel);
    vec3 rayOrigin = worldPosition + normal * RAY_ORIGIN_OFFSET;

    rayQueryEXT query;
    rayQueryInitializeEXT(query,
                          sceneTopLevel,
                          gl_RayFlagsOpaqueEXT,
                          0xFFu,
                          rayOrigin,
                          parameters.rayLimits.x,
                          rayDirection,
                          parameters.rayLimits.y);
    while (rayQueryProceedEXT(query))
    {
    }

    vec3 incomingRadiance = vec3(0.0);
    uint intersectionType = rayQueryGetIntersectionTypeEXT(query, true);
    bool bHit = intersectionType == gl_RayQueryCommittedIntersectionTriangleEXT;
    if (!bHit)
    {
        if (parameters.rayLimits.w > 0.0)
        {
            incomingRadiance = textureLod(environmentRadiance,
                                          EquirectangularUV(rayDirection),
                                          0.0).rgb * parameters.rayLimits.w;
        }
    }
    else
    {
        float hitDistance = rayQueryGetIntersectionTEXT(query, true);
        uint customIndex = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(query, true));
        uint primitiveIndex = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
        RTGIInstanceData hitInstance;
        vec3 hitNormal;
        if (IsFiniteScalar(hitDistance) && hitDistance >= 0.0 &&
            TryGetInstanceData(customIndex, hitInstance) &&
            TryGetWorldTriangleNormal(query, primitiveIndex, hitInstance, hitNormal))
        {
            if (dot(hitNormal, rayDirection) > 0.0)
            {
                hitNormal = -hitNormal;
            }
            vec3 hitPosition = rayOrigin + rayDirection * hitDistance;
            vec3 emissive = hitInstance.emissiveChromaticityAndLuminance.rgb *
                            hitInstance.emissiveChromaticityAndLuminance.a;
            incomingRadiance = emissive +
                               ComputeDirectRadiance(hitPosition,
                                                     hitNormal,
                                                     hitInstance.baseColor.rgb);
        }
    }

    incomingRadiance = SanitizeRadiance(incomingRadiance);
    float preExposure = IsFiniteScalar(parameters.rayLimits.z) &&
                                parameters.rayLimits.z > 0.0
                            ? clamp(parameters.rayLimits.z, 1.0e-6, 1.0e6)
                            : 1.0;
    vec3 outputRadiance = SanitizeRadiance(incomingRadiance *
                                           surfaceAlbedo *
                                           diffuseWeight *
                                           preExposure);
    imageStore(diffuseIndirect, ivec2(pixel), vec4(outputRadiance, 1.0));
}
