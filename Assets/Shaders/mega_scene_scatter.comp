#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

// ========================================
// MegaGeometry の常駐の表へ、このフレームの差分を書く（MegaGeometryPass::UpdateResidentSceneTables）
//
// 表はどれも device-local で、フレームをまたいで残る。ホストは変わった行だけを staging（記録の列）へ書き、
// このシェーダーが散在書き込みする。値は uvec4 のまま写す（浮動小数の変換をしない）。
//
// 段 0（header.y == 0）: 席の表（席ごと 128 B: 変換・前の変換）へ、変わった席の行を写す。
//   記録 1 件 = 9 語（uvec4）: [0].x = 席の番号, [1..4] = 変換, [5..8] = 前の変換
// 段 1（header.y == 1）: 描く順の表（Common/MegaInstanceTable.glsl の MegaInstanceRow。144 B）を席の表から組み、
//   影の表（48 B）とメッシュの表（80 B）の変わった行を写す。段 0 の書き込みの後（バリアを挟んで）に走る。
//   描く順の記録 1 件 = 2 語: [0] = (描く順の番号, 席の番号, メッシュの表の番号, 最初のワークグループ), [1] = 予約
//   影の記録 1 件 = 4 語: [0].x = 描く順の番号, [1..3] = 影の表の行
//   メッシュの記録 1 件 = 6 語: [0].x = メッシュの表の番号, [1..5] = メッシュの表の行
//   header.x = 描く順の記録の数, header.z = 影の記録の数, header.w = メッシュの記録の数。記録はこの順に続けて並ぶ
// 段 2（header.y == 2）: 範囲（描く順の行を 64 個ずつ区切ったもの）の境界（AABB）を、段 1 の書き込みの後（バリアを挟んで）に
//   描く順の表とメッシュの表から作り直す。1 ワークグループ = 1 範囲で、各スレッドが 1 行の締まった球（メッシュの球を変換し、
//   半径に拡大率を掛けたもの）の AABB を出し、ワークグループで合わせる。
//   記録 = 作り直す範囲の番号（1 語ずつ、uvec4 に 4 つ詰める）。header.x = 範囲の数, header.z = 描く順の表の行の数
//   範囲の境界の 1 要素 = vec4 × 2: [0] = (最小の xyz, 印), [1] = (最大の xyz, 0)。印は RANGE_FLAG_*（float で持つ）
// 段 3（header.y == 3）: メッシュの表の締まった境界球の半径を、そのメッシュの全段のクラスタの球を包むまで広げる。段 1 の
//   書き込みの後・段 2 の前（それぞれバリアを挟んで）に走る。ホストの球（MegaMeshGPUData::TotalBounds）は実行時の LOD では
//   最も細かい段だけから作るので、簡略化で外へ動いた頂点を包まない。中心はそのまま、半径を max(|c_i - 中心| + r_i) にする。
//   1 ワークグループ = 1 メッシュで、メッシュの表の番号はワークグループの通し番号。記録は持たない。header.x = メッシュの数
//   クラスタの球が有限でないメッシュは、半径を 0（締まった球が無い。判定は根の節の球を使う）にする。
// ========================================

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// 記録の列（staging。ホストが書く）。header.x = 件数, header.y = 段
layout(std430, set = 0, binding = 0) readonly buffer SceneScatterRecords
{
    uvec4 header;
    uvec4 recordWords[];
};

// 席の表（席ごと 8 語）
layout(std430, set = 0, binding = 1) buffer SceneSlotRows
{
    uvec4 slotWords[];
};

// 描く順の表（MegaInstanceRow。1 行 9 語）
layout(std430, set = 0, binding = 2) buffer SceneInstanceRows
{
    uvec4 instanceWords[];
};

// 影の表（MegaGeometryShadowInstance。1 行 3 語）
layout(std430, set = 0, binding = 3) buffer SceneShadowRows
{
    uvec4 shadowWords[];
};

// メッシュの表（MegaMeshEntry。1 行 5 語）
layout(std430, set = 0, binding = 4) buffer SceneMeshRows
{
    uvec4 meshWords[];
};

// 範囲の境界（範囲ごとに vec4 × 2。cluster_bvh_cull.comp の範囲の段が読む）
layout(std430, set = 0, binding = 5) buffer SceneRangeBounds
{
    vec4 rangeBounds[];
};

const uint SlotRowWords = 8u;
const uint InstanceRowWords = 9u;
const uint ShadowRowWords = 3u;
const uint MeshRowWords = 5u;
// メッシュの表の行の中の、締まった境界球の語（MegaMeshEntry::boundsSphere）
const uint MeshBoundsWord = 4u;
// 1 つの範囲の行の数（ワークグループの大きさと同じ。MegaGeometryPass.cpp の BvhRangeSeats と一致）
const uint RangeSeats = 64u;
// 範囲の印（cluster_bvh_cull.comp の RANGE_FLAG_* と一致）: 行を持つ・締まった球を持たない行がある（境界が無いので常に通す）
const uint RANGE_FLAG_HAS_ROWS = 1u;
const uint RANGE_FLAG_UNBOUNDED = 2u;

shared vec3 s_RangeMin[RangeSeats];
shared vec3 s_RangeMax[RangeSeats];
shared uint s_RangeFlags[RangeSeats];

// メッシュの表の行の中の、クラスタ配列の語（MegaMeshEntry::clusterInfo。x,y = デバイスアドレス, z = クラスタ数）
const uint MeshClusterWord = 1u;

// クラスタ配列（Common/MegaGeometryCull.glsl の GPUClusterData と同じ 112 B の並び。段 3 は先頭の境界球だけを読む）
struct ScatterClusterData
{
    vec4 boundsSphere; // center.xyz + radius
    vec4 unused0[6];
};

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer ScatterClusterArray
{
    ScatterClusterData clusters[];
};

shared float s_MeshReach[RangeSeats];
shared uint s_MeshInvalid[RangeSeats];

/**
 * @brief 段 3: このワークグループのメッシュの締まった境界球の半径を、全段のクラスタの球を包むまで広げる
 *
 * メッシュの番号はワークグループで共通なので、早く返る道もワークグループ全体で同じ（barrier の前で分かれない）。
 */
void GrowMeshBounds()
{
    const uint meshIndex = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    if (meshIndex >= header.x)
    {
        return;
    }
    const uint lane = gl_LocalInvocationID.x;
    const uint boundsWord = meshIndex * MeshRowWords + MeshBoundsWord;
    const vec4 sphere = uintBitsToFloat(meshWords[boundsWord]);
    // 締まった球を持たないメッシュ（判定は根の節の球を使う）はそのまま
    if (!(sphere.w > 0.0))
    {
        return;
    }
    const uvec4 clusterInfo = meshWords[meshIndex * MeshRowWords + MeshClusterWord];
    ScatterClusterArray clusterArray = ScatterClusterArray(clusterInfo.xy);

    float reach = 0.0;
    uint invalid = 0u;
    for (uint cluster = lane; cluster < clusterInfo.z; cluster += RangeSeats)
    {
        const vec4 bounds = clusterArray.clusters[cluster].boundsSphere;
        if (any(isnan(bounds)) || any(isinf(bounds)))
        {
            invalid = 1u;
            continue;
        }
        reach = max(reach, distance(bounds.xyz, sphere.xyz) + max(bounds.w, 0.0));
    }
    s_MeshReach[lane] = reach;
    s_MeshInvalid[lane] = invalid;
    barrier();
    for (uint stride = RangeSeats / 2u; stride > 0u; stride >>= 1u)
    {
        if (lane < stride)
        {
            s_MeshReach[lane] = max(s_MeshReach[lane], s_MeshReach[lane + stride]);
            s_MeshInvalid[lane] |= s_MeshInvalid[lane + stride];
        }
        barrier();
    }
    if (lane == 0u)
    {
        // 距離の丸めの分だけ少し広げる（半径は縮めない）
        const float radius = s_MeshInvalid[0] != 0u ? 0.0 : max(sphere.w, s_MeshReach[0] * 1.0001);
        meshWords[boundsWord] = uvec4(floatBitsToUint(sphere.xyz), floatBitsToUint(radius));
    }
}

/**
 * @brief 段 2: このワークグループの範囲の境界を、描く順の表とメッシュの表から作り直す
 *
 * 範囲の番号はワークグループで共通なので、早く返る道もワークグループ全体で同じ（barrier の前で分かれない）。
 */
void BuildRangeBounds()
{
    const uint flatGroup = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    if (flatGroup >= header.x)
    {
        return;
    }
    const uint range = recordWords[flatGroup >> 2u][flatGroup & 3u];
    const uint lane = gl_LocalInvocationID.x;
    const uint row = range * RangeSeats + lane;

    vec3 lo = vec3(3.0e38);
    vec3 hi = vec3(-3.0e38);
    uint flags = 0u;
    if (row < header.z)
    {
        flags = RANGE_FLAG_HAS_ROWS;
        const uint rowBase = row * InstanceRowWords;
        const uint meshIndex = instanceWords[rowBase + SlotRowWords].x;
        const vec4 sphere = uintBitsToFloat(meshWords[meshIndex * MeshRowWords + MeshBoundsWord]);
        // 変換の列 0〜3（列 3 が平行移動。Common/MegaGeometryCull.glsl の TransformClusterCenterToWorld・ComputeWorldRadiusScale と同じ）
        const vec3 axisX = uintBitsToFloat(instanceWords[rowBase + 0u]).xyz;
        const vec3 axisY = uintBitsToFloat(instanceWords[rowBase + 1u]).xyz;
        const vec3 axisZ = uintBitsToFloat(instanceWords[rowBase + 2u]).xyz;
        const vec3 origin = uintBitsToFloat(instanceWords[rowBase + 3u]).xyz;
        const vec3 center = origin + axisX * sphere.x + axisY * sphere.y + axisZ * sphere.z;
        const float radius = sphere.w * max(length(axisX), max(length(axisY), length(axisZ)));
        const bool bFinite = !any(isnan(center)) && !any(isinf(center)) && !isnan(radius) && !isinf(radius);
        if (sphere.w > 0.0 && bFinite)
        {
            lo = center - vec3(radius);
            hi = center + vec3(radius);
        }
        else
        {
            flags |= RANGE_FLAG_UNBOUNDED;
        }
    }
    s_RangeMin[lane] = lo;
    s_RangeMax[lane] = hi;
    s_RangeFlags[lane] = flags;
    barrier();
    for (uint stride = RangeSeats / 2u; stride > 0u; stride >>= 1u)
    {
        if (lane < stride)
        {
            s_RangeMin[lane] = min(s_RangeMin[lane], s_RangeMin[lane + stride]);
            s_RangeMax[lane] = max(s_RangeMax[lane], s_RangeMax[lane + stride]);
            s_RangeFlags[lane] |= s_RangeFlags[lane + stride];
        }
        barrier();
    }
    if (lane == 0u)
    {
        rangeBounds[range * 2u] = vec4(s_RangeMin[0], float(s_RangeFlags[0]));
        rangeBounds[range * 2u + 1u] = vec4(s_RangeMax[0], 0.0);
    }
}

void main()
{
    if (header.y == 2u)
    {
        BuildRangeBounds();
        return;
    }
    if (header.y == 3u)
    {
        GrowMeshBounds();
        return;
    }

    // 記録の通し番号（dispatch は x 方向の上限を避けて 2 次元で出す）
    const uint flatGroup = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint index = flatGroup * 64u + gl_LocalInvocationID.x;

    if (header.y == 0u)
    {
        if (index >= header.x)
        {
            return;
        }
        const uint base = index * (1u + SlotRowWords);
        const uint slot = recordWords[base].x;
        for (uint word = 0u; word < SlotRowWords; ++word)
        {
            slotWords[slot * SlotRowWords + word] = recordWords[base + 1u + word];
        }
        return;
    }

    const uint entryCount = header.x;
    const uint shadowCount = header.z;
    const uint meshCount = header.w;

    if (index < entryCount)
    {
        const uint base = index * 2u;
        const uvec4 entry = recordWords[base];
        const uint dense = entry.x;
        const uint slot = entry.y;
        for (uint word = 0u; word < SlotRowWords; ++word)
        {
            instanceWords[dense * InstanceRowWords + word] = slotWords[slot * SlotRowWords + word];
        }
        instanceWords[dense * InstanceRowWords + SlotRowWords] = uvec4(entry.z, entry.w, 0u, 0u);
        return;
    }
    index -= entryCount;

    const uint shadowBase = entryCount * 2u;
    if (index < shadowCount)
    {
        const uint base = shadowBase + index * (1u + ShadowRowWords);
        const uint dense = recordWords[base].x;
        for (uint word = 0u; word < ShadowRowWords; ++word)
        {
            shadowWords[dense * ShadowRowWords + word] = recordWords[base + 1u + word];
        }
        return;
    }
    index -= shadowCount;

    if (index < meshCount)
    {
        const uint base = shadowBase + shadowCount * (1u + ShadowRowWords) + index * (1u + MeshRowWords);
        const uint meshIndex = recordWords[base].x;
        for (uint word = 0u; word < MeshRowWords; ++word)
        {
            meshWords[meshIndex * MeshRowWords + word] = recordWords[base + 1u + word];
        }
    }
}
