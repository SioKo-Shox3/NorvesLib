#version 460

// ========================================
// 仮想シャドウマップ（VSM）の、MegaGeometry の投影物のカリングの事前の絞り込み
//
// vsm_mega_cull.comp は 1 ワークグループ = 1 つの（インスタンス、スライス）の 64 クラスタを受け持つ。インスタンスの境界で落ちる組が
// ほとんどの場面（点光源は 1 灯でも 36 スライスあり、インスタンスが多いほど組の数が増える）で、落ちる組のワークグループまで
// 全部出すと、ワークグループの数 × スライスの数だけ同じ判定を繰り返すことになる。ここで組ごとに 1 回だけ判定し、
// 通った組だけを一覧にして、vsm_mega_cull.comp を間接 dispatch で出す。
//
// 1 スレッド = 1 つの（インスタンス、スライス）の組。dispatch は (ceil(インスタンスの数 / 64), 1, スライスの数)。
// 1 ワークグループの 64 席は、描く順の表を 64 席ずつ区切った範囲（MegaGeometryPass の BvhRangeSeats）の 1 つに当たる。
// 太陽の段では、まず範囲の AABB（席の境界の球を包む）のライト空間の外接の箱を 1 回だけ判定し、外なら範囲の席は組を作らない。
// 受け手の領域は、受け手距離の内側の受け手が今のフレームに印を付けて要求したページ（dirty のページはどれもそう。
// vsm_allocate.comp の段階 2）を太陽の向きへ深度の範囲まで延ばした柱で、箱の XY の矩形が dirty のページに掛からず、
// または箱が深度の範囲の外なら外。受け手の印付けが画角に応じて選んだページそのものを使うので、カメラの画角・縦横比に依らない。
// 箱は範囲のどの席の境界の球の矩形も含むので、範囲の判定は席の判定（下）より多くは落とさない。
// 判定は vsm_mega_cull.comp の（1）と同じ: 影を落とすインスタンスで、ワークグループを持ち、境界が無いか、境界の球が
// スライスの範囲・深度の範囲に入り dirty のページを含む。使わないスライス（ページの一辺が 0）は何も通さない。
// 通った組は binding 21 の一覧へ (インスタンスの表の番号 << 8) | スライスの番号 で追加する。
//   メッシュがグループの BVH を持つ組（megaParams.bvh.x が 1 のとき。太陽の段・点光源の面のどちらも）は、BVH の経路（vsm_mega_bvh.comp）の根として
//   一覧の後ろ（組の一覧の容量 megaParams.bvh.w − 1 から前へ）に積み、数を pairBvhCount に数える。
//   それ以外の組（BVH を持たないメッシュ）は平らな経路（vsm_mega_cull.comp）の組として前から積み、組の最大のワークグループ数を持つ。
//   前と後ろの組の合計は（インスタンスの数 × スライスの数）を超えず、一覧の容量はそれ以上なので重ならない。
// 間接 dispatch の引数（平らな経路は組の数 × 最大のワークグループ数、BVH の経路は根の数）は、続けて呼ぶ vsm_mega_cull_args.comp が書く。
// 呼ぶ前に、一覧の頭の 12 語を 0 にしておくこと。
// 統計（binding 17）の語 8（と点光源の語 56）・出力の一覧（binding 15）の語 2 は、通った組の数をここで数える。
// ========================================

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// binding 20: スライスの表（ページの一辺・texel・範囲の原点・ページの表の先頭）
#define VSM_SLICE_BINDING 20
#include "Common/VirtualShadowMapMegaCull.glsl"
#include "Common/VirtualShadowMapMegaSphere.glsl"
// binding 1・22: インスタンスの表とメッシュの表（組のメッシュが BVH を持つかを見る）
#define MEGA_INSTANCE_BINDING 1
#define MEGA_MESH_BINDING 22
#include "Common/MegaInstanceTable.glsl"

// binding 15: 出力の一覧（語 2 = 通った組の数だけをここで書く）
layout(std430, set = 0, binding = 15) buffer VsmMegaList
{
    uint listSelected;
    uint listOverflow;
    uint listInstanceLevels;
    uint listReserved;
    uvec4 listEntries[];
};

// binding 17: VSM の統計
layout(std430, set = 0, binding = 17) buffer VsmStats
{
    uint vsmStats[];
};
const uint STAT_MEGA_INSTANCES = 8u;
// 透視のスライス（点光源の面）だけの数（STAT_MEGA_INSTANCES はこれを含む合計）
const uint STAT_MEGA_POINT_INSTANCES = 56u;

// binding 18: 影の表（インスタンスの表と同じ並び。構造は Common/VirtualShadowMapMegaCull.glsl の ShadowInstance）
layout(std430, set = 0, binding = 18) readonly buffer ShadowInstanceBuffer
{
    ShadowInstance shadowInstances[];
};

// binding 21: （インスタンス、スライス）の組の一覧。頭の 12 語は vsm_mega_cull_args.comp と同じ並び
// （pairArgs は平らな経路の選択、pairBvhArgs は BVH の経路の段 0 の間接 dispatch の引数）
layout(std430, set = 0, binding = 21) buffer VsmMegaPairs
{
    uint pairCount;
    uint pairMaxGroups;
    uint pairBvhCount;
    uint pairReserved1;
    uint pairArgs[4];
    uint pairBvhArgs[4];
    uint pairEntries[];
};

// 範囲の AABB の畳み込み（ワークグループの 64 席）。境界を持たない投影物が 1 つでもあれば、範囲の判定はしない
shared vec3 sRangeMin[64];
shared vec3 sRangeMax[64];
shared uint sRangeUnbounded;
shared uint sRangeOutside;

/**
 * @brief ワールドの AABB（中心・半分の大きさ）が、太陽の段 level の受け手の領域の外にあるか
 *
 * AABB のライト空間の外接の箱が深度の範囲の外か、箱の XY を包む正方形（半分の大きさは箱の XY の大きい方）が
 * 覆うページに dirty のページが 1 つも無ければ外。正方形は箱を含むので、どちらも席の判定（LevelOverlapsSphere・SphereHasDirtyPage）
 * より多くは落とさない（席の判定と浮動小数の丸めがずれても落とさないよう、箱を 1 mm 広げる）。
 */
/**
 * @brief インスタンスのメッシュが、BVH の経路でたどれるグループの BVH（節の配列のアドレスと 1 つ以上の節）を持つか
 */
bool InstanceHasBvh(uint instanceIndex)
{
    const uvec4 bvhInfo = megaMeshes[megaInstanceRows[instanceIndex].info.x].bvhInfo;
    return (bvhInfo.x | bvhInfo.y) != 0u && bvhInfo.z > 0u;
}

bool WorldBoxOutsideReceivers(uint level, vec3 center, vec3 halfExtent)
{
    const float lightDepth = dot(center, megaParams.lightDirection.xyz);
    const vec3 lightHalf = vec3(dot(abs(megaParams.lightRight.xyz), halfExtent),
                                dot(abs(megaParams.lightUp.xyz), halfExtent),
                                dot(abs(megaParams.lightDirection.xyz), halfExtent)) +
                           vec3(0.001);
    if (abs(lightDepth - megaParams.depth.x) > megaParams.depth.y + lightHalf.z)
    {
        return true;
    }
    return !SphereHasDirtyPage(level, center, max(lightHalf.x, lightHalf.y));
}

void main()
{
    const uint level = gl_WorkGroupID.z;
    const uint localIndex = gl_LocalInvocationID.x;
    const uint instanceIndex = gl_GlobalInvocationID.x;
    const uint instanceCount = megaParams.counts.w;

    bool bCandidate = false;
    bool bBounded = false;
    ShadowInstance shadow;
    uint groups = 0u;
    if (level < megaParams.counts.x && vsmSlices[level].info.x > 0.0 && instanceIndex < instanceCount)
    {
        shadow = shadowInstances[instanceIndex];
        // そのインスタンスのワークグループの数は、次のインスタンスの最初のワークグループの番号との差（最後のインスタンスは全体の数との差）
        const uint endGroup = instanceIndex + 1u < instanceCount ? shadowInstances[instanceIndex + 1u].info.x : megaParams.counts.z;
        groups = endGroup - shadow.info.x;
        bCandidate = groups > 0u && (shadow.info.y & SHADOW_FLAG_CASTER) != 0u;
        bBounded = (shadow.info.y & SHADOW_FLAG_BOUNDS) != 0u;
    }

    // 範囲の判定は太陽の段だけ（点光源の面は LevelOverlapsSphere が Range で絞る）。level はワークグループで同じなので、
    // 下の barrier はワークグループの全スレッドが同じ道で通る
    const bool bRangeTest = level < megaParams.counts.x && vsmSlices[level].info.x > 0.0 && !IsPerspectiveSlice(vsmSlices[level]);
    bool bPassed = bCandidate;
    if (bRangeTest)
    {
        // 範囲の AABB: 候補の席の境界の球を包む箱を畳み込む（候補でない席は空の箱）
        if (localIndex == 0u)
        {
            sRangeUnbounded = 0u;
            sRangeOutside = 0u;
        }
        sRangeMin[localIndex] = bCandidate && bBounded ? shadow.boundsSphere.xyz - vec3(shadow.boundsSphere.w) : vec3(3.0e38);
        sRangeMax[localIndex] = bCandidate && bBounded ? shadow.boundsSphere.xyz + vec3(shadow.boundsSphere.w) : vec3(-3.0e38);
        barrier();
        if (bCandidate && !bBounded)
        {
            atomicOr(sRangeUnbounded, 1u);
        }
        for (uint stride = 32u; stride > 0u; stride >>= 1u)
        {
            if (localIndex < stride)
            {
                sRangeMin[localIndex] = min(sRangeMin[localIndex], sRangeMin[localIndex + stride]);
                sRangeMax[localIndex] = max(sRangeMax[localIndex], sRangeMax[localIndex + stride]);
            }
            barrier();
        }
        // dirty の階層をたどるのは範囲につき 1 スレッドだけ。候補が 1 つも無い範囲は箱が空（どの席も下で落ちる）。
        // 境界の無い候補があれば範囲では落とさない
        if (localIndex == 0u)
        {
            const vec3 rangeMin = sRangeMin[0];
            const vec3 rangeMax = sRangeMax[0];
            if (sRangeUnbounded == 0u && all(lessThanEqual(rangeMin, rangeMax)) &&
                WorldBoxOutsideReceivers(level, (rangeMin + rangeMax) * 0.5, (rangeMax - rangeMin) * 0.5))
            {
                sRangeOutside = 1u;
            }
        }
        barrier();
        if (sRangeOutside != 0u)
        {
            bPassed = false;
        }
    }
    if (bPassed && bBounded)
    {
        bPassed = LevelOverlapsSphere(level, shadow.boundsSphere.xyz, shadow.boundsSphere.w) &&
                  SphereHasDirtyPage(level, shadow.boundsSphere.xyz, shadow.boundsSphere.w);
    }
    if (bPassed)
    {
        // BVH を持つメッシュの組は BVH の経路の根（一覧の後ろから）、それ以外は平らな経路の組（前から）。
        // 通った組はどれも使うスライスの組（bCandidate がスライスの範囲を確かめた）
        if (megaParams.bvh.x != 0u && InstanceHasBvh(instanceIndex))
        {
            const uint slot = atomicAdd(pairBvhCount, 1u);
            pairEntries[megaParams.bvh.w - 1u - slot] = (instanceIndex << 8u) | level;
        }
        else
        {
            const uint slot = atomicAdd(pairCount, 1u);
            pairEntries[slot] = (instanceIndex << 8u) | level;
            atomicMax(pairMaxGroups, groups);
        }
        atomicAdd(listInstanceLevels, 1u);
        atomicAdd(vsmStats[STAT_MEGA_INSTANCES], 1u);
        if (IsPerspectiveSlice(vsmSlices[level]))
        {
            atomicAdd(vsmStats[STAT_MEGA_POINT_INSTANCES], 1u);
        }
    }
}
