#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

// ========================================
// Mega Geometry クラスタカリング コンピュートシェーダー（グループの BVH をたどる経路）
//
// グループの BVH（NVMESH v1.1 の焼き込み、または読み込み時に実行時に作ったもの）を持つメッシュのインスタンスを、BVH の
// 段ごとの dispatch でたどる（1パスにつき、範囲の段（1パス目と1回の判定だけ）+ 段の数 + 葉のクラスタの判定の1回。2パス目は
// さらに、1パス目が回した範囲・節・クラスタを読む dispatch）。BVH を持たないメッシュ（実行時に作れなかったもの）と、
// --mega-flat-path のときの全インスタンスは cluster_cull.comp が受け持つ。
//
// 範囲の段（bvhStage = BVH_STAGE_RANGES。1パス目と1回の判定だけ）:
//   BVH を持つインスタンス（インスタンスの表の先頭 bvhRootCount 個）を描く順に 64 席ずつ区切った範囲を1スレッドが1つ受け持ち、
//   範囲の AABB（mega_scene_scatter.comp の段 2 が、行の変わった範囲だけ作り直す常駐の表。binding 15）で視錐台・距離の判定を
//   する。通った範囲を節の列 0 へ積み（カウンタ 0）、席の段の間接 dispatch の引数（1 範囲 = 1 ワークグループ）を書く。
// 席の段（bvhStage = 0）:
//   1席1スレッド。入力は、1パス目と1回の判定では範囲の段が積んだ範囲の席、2パス目は1パス目が2パス目へ回した範囲の席
//   （回した列のどれかが溢れたフレームだけ、別の dispatch で全部の根）。
//   締まった球（メッシュの球 × 拡大率。メッシュの球が無ければ根の節の球）で視錐台・距離・画素の大きさ・根の節の LOD・
//   遮蔽（2パス目は今のフレームの HZB、1パス目は前のフレームの HZB を使えるフレームだけ）の判定をし、通った席の根の子を
//   段1の列へ（根が葉なら葉の列へ）積む。
// 節の判定の段（bvhStage = 段の番号。1以上）:
//   前の段が積んだ列の各要素（インスタンス・節）を1スレッドが受け持ち、節の球で遮蔽の判定をする。落ちれば、その下の
//   クラスタは選ばれないので枝ごと切る。残った内部の節は子の節を次の段の列へ積み、葉は葉の列へ積む。遮蔽は、2パス目は
//   今のフレームの HZB で枝を切り、1パス目は前のフレームの HZB に隠れた節を2パス目へ回す（枝の下をたどらない）。
//   視錐台と LOD（節の球から投影した親の誤差の最大が許容以下）の判定は、親が子を列へ積む前に子ごとに済ませ、通った子だけを
//   積む（PushPassedNode）。遠くて画面の上で粗い段で足りるインスタンスは、粗いクラスタの組を持つ枝だけが列に残るので、
//   列の長さはインスタンスの数 × 子の数でなく、画面の細かさが求める節の数で決まる。
// 葉のクラスタの判定（bvhStage = BVH_STAGE_CLUSTERS）:
//   葉の列の1要素を BVH_LEAF_SLOTS 個のスレッドが1クラスタずつ受け持ち（実行時に作った BVH の葉は、節の配列の直後の
//   並べ替えの表でクラスタの番号を引く）、cluster_cull.comp と同じ判定（ProcessCluster）にかけて描画コマンドを積む。
//   1パス目で前のフレームの HZB に隠れたクラスタは描かずに2パス目へ回す。
//
// 列の容量は固定（本数やメッシュによらない）。節の列は 2 本で、段 s（1以上）は列 s & 1 を読み、次の段の列 (s + 1) & 1 へ書く。
// 積む前に容量を確かめ、超えた要素は積まずに統計（STAT_BVH_OVERFLOW）へ数える。カウンタは積もうとした数なので、読む側は
// 容量で頭打ちにする。段1以降と葉の段は、積んだ段が書いた引数（積めた数から求めたワークグループ数）で間接 dispatch する。
// 節の列・葉の列の要素の y の最上位ビット（BVH_ENTRY_PASS1_REACHED）は、2パス目が全部の根を見直すときに「1パス目もこの節へ
// たどり着いた」ことを運ぶ（それ以外は 0）。
//
// 2パス目へ回す列（binding 14。前のフレームの HZB を使う1パス目が積み、2パス目が読む。各パスの頭で 0 にするカウンタとは別のバッファ）:
//   範囲の列: 1パス目の範囲の段が、範囲の AABB を包む球が前の HZB に隠れた範囲を（範囲, 全部の席の印）で積み、席の段が、
//            遮蔽以外の判定と根の LOD を通って前の HZB に隠れた席の印をワークグループでまとめて（範囲, 席の 64 ビットの印）で積む。
//            2パス目の段0は、この列の 1 要素を 1 ワークグループで受け持ち、印の立った席を今のフレームの HZB で判定する。
//   節の列: 1パス目の節の段が、視錐台と LOD を通って前の HZB に隠れた節を（インスタンス, 節）で積む。2パス目は段0の後に、
//            1 要素 1 スレッドで節を今のフレームの HZB で判定し、通った節の子を段1の列へ（葉なら葉の列へ）積む
//            （深さの違う節が段1から並ぶが、どの節も残りの段の数より浅いので、段の数は変わらない）。
//   クラスタの列: 1パス目の葉の段が、前の HZB に隠れたクラスタを（インスタンス, クラスタの番号）で積む。2パス目は葉の段の後に、
//            1 要素 1 スレッドで ProcessCluster にかける。
// どれかの列が容量を超えたら、2パス目は3つの列を使わず、全部の根を席の遮蔽の判定なしで判定し直す（溢れて積めなかったものを
// 取りこぼさない。節・クラスタの遮蔽の判定は今のフレームの HZB で続ける）。1パス目が描いたクラスタを重ねて描かないよう、
// 見直しは1パス目が前の HZB でたどった道を判定し直して BVH_ENTRY_PASS1_REACHED で運び、葉のクラスタで1パス目が描いたかを決める。
//
// 段の間は CPU が UAV と間接引数のバリアを入れ、段ごとのカウンタ（bvhCounters）は各パスの先頭で0にする。
// ========================================

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// 1パス目の葉のクラスタの判定が、前のフレームの HZB に隠れたクラスタを2パス目へ回す（AppendDeferredCluster をこのファイルで定める）
#define MEGA_CULL_DEFER_CLUSTERS 1
#include "Common/MegaGeometryCull.glsl"

// set 0, binding 14: 2パス目へ回す列と間接 dispatch の引数。頭（BVH_PASS2_HEADER_WORDS 語）:
// [0..2] = 全部の根を見直す dispatch の引数（VkDispatchIndirectCommand。列が溢れたときだけ 0 でなくなる）、[3] = 予約、
// [4] = どれかの列の容量を超えた数（1 以上なら全部の根を見直す）、[5..7] = 予約、
// [8..10]・[11] = 範囲の列の dispatch の引数・積もうとした数、[12..14]・[15] = 節の列の同じもの、[16..18]・[19] = クラスタの列の同じもの、
// [20..31] = 予約。頭の後ろに、範囲の列（1 要素 BVH_DEFER_ENTRY_WORDS 語: 範囲, 席 0〜31 の印, 席 32〜63 の印, 予約。容量 bvhDeferCapacity）、
// 節の列（1 要素 2 語: インスタンス, 節。容量 bvhDeferNodeCapacity）、クラスタの列（1 要素 2 語: インスタンス, クラスタの番号。
// 容量 bvhDeferClusterCapacity）が並ぶ。MegaGeometryPass.cpp の BvhPass2HeaderWords・BvhDefer* と一致
layout(std430, set = 0, binding = 14) buffer BvhPass2InputBuffer
{
    uint bvhPass2[];
};
const uint BVH_PASS2_FALLBACK = 4u;
const uint BVH_DEFER_ARGS = 8u;
const uint BVH_DEFER_COUNT = 11u;
const uint BVH_DEFER_NODE_ARGS = 12u;
const uint BVH_DEFER_NODE_COUNT = 15u;
const uint BVH_DEFER_CLUSTER_ARGS = 16u;
const uint BVH_DEFER_CLUSTER_COUNT = 19u;
const uint BVH_PASS2_HEADER_WORDS = 32u;
const uint BVH_DEFER_ENTRY_WORDS = 4u;
const uint BVH_DEFER_PAIR_WORDS = 2u;

// 節の列・葉の列の要素の y: 下位 31 ビットが節の番号、最上位ビットが「1パス目もこの節へたどり着いた」（全部の根を見直す2パス目だけ）
const uint BVH_ENTRY_PASS1_REACHED = 0x80000000u;
const uint BVH_ENTRY_NODE_MASK = 0x7FFFFFFFu;

// 席の段（段0）の入力（bvhSeatsFromRanges。MegaGeometryPass.cpp の BvhSeatsFrom* と一致）:
// 全部の根（2パス目で列が溢れたときだけ）・範囲の段が積んだ範囲の一覧（1パス目と1回の判定）・2パス目へ回した範囲の列（2パス目）
const uint SEATS_FROM_ROOTS = 0u;
const uint SEATS_FROM_RANGES = 1u;
const uint SEATS_FROM_DEFERRED = 2u;

// set 0, binding 15: 範囲の境界（範囲ごとに vec4 × 2: [0] = (最小の xyz, 印), [1] = (最大の xyz, 0)。mega_scene_scatter.comp の段 2 が書く）
layout(std430, set = 0, binding = 15) readonly buffer RangeBoundsBuffer
{
    vec4 rangeBounds[];
};
// 1 つの範囲の席の数（席の段の 1 ワークグループ。MegaGeometryPass.cpp の BvhRangeSeats と一致）
const uint RANGE_SEATS = 64u;
// 範囲の印（mega_scene_scatter.comp と一致）: 行を持つ・締まった球を持たない行がある（境界が無いので常に通す）
const uint RANGE_FLAG_HAS_ROWS = 1u;
const uint RANGE_FLAG_UNBOUNDED = 2u;
// 範囲の段・2パス目へ回した節の段・2パス目へ回したクラスタの段の印（MegaGeometryPass.cpp の BvhStageRanges・BvhStageDeferred* と一致）
const uint BVH_STAGE_RANGES = 0xFFFFFFFEu;
const uint BVH_STAGE_DEFERRED_CLUSTERS = 0xFFFFFFFDu;
const uint BVH_STAGE_DEFERRED_NODES = 0xFFFFFFFCu;
// 画素の大きさの判定の余裕（画素）。頂点はラスタで 1/256 画素へ丸まるので、それより十分に大きく取る
const float PIXEL_CULL_MARGIN = 1.0 / 32.0;

// 間接 dispatch の x 方向の上限（超える分は y へ折り返す）
const uint BVH_DISPATCH_LIMIT_X = 65535u;
// 1 ワークグループが受け持つ列の要素の数（節の段は 1 スレッド 1 要素、葉の段は BVH_LEAF_SLOTS スレッドで 1 要素）
const uint BVH_NODE_ENTRIES_PER_GROUP = 64u;
const uint BVH_LEAF_ENTRIES_PER_GROUP = 64u / BVH_LEAF_SLOTS;

/**
 * @brief 列の位置 [first, end) へ積んだ後、その列を読む段の間接 dispatch の引数（ワークグループ数）を引き上げる
 *
 * end は容量で頭打ちにした位置。ワークグループ数は ceil(end / entriesPerGroup) で、x = min(数, 上限)、y = ceil(数 / 上限)。
 * どちらも end について単調なので atomicMax で書けば、スレッドの順序によらず最後は積めた数に対する値になる。
 * ワークグループの先頭の要素を含む範囲を積んだスレッドだけが書く（最後のワークグループの先頭を積んだスレッドが最大を書く）。
 * z は位置 0 を積んだスレッドだけが 1 を書く（同じ番地へ複数のスレッドが非アトミックに書かない）。
 * 同じスレッドが、その列へ積もうとした数（attempted。容量を超えた分も含む）の最大を統計 peakStat へ書く。
 */
void RaiseStageArgs(uint argsWord, uint peakStat, uint first, uint end, uint attempted, uint entriesPerGroup)
{
    uint groupsBefore = (first + entriesPerGroup - 1u) / entriesPerGroup;
    uint groups = (end + entriesPerGroup - 1u) / entriesPerGroup;
    if (groups == groupsBefore)
    {
        return;
    }
    atomicMax(stats[peakStat], attempted);
    atomicMax(bvhCounters[argsWord], min(groups, BVH_DISPATCH_LIMIT_X));
    atomicMax(bvhCounters[argsWord + 1u], (groups + BVH_DISPATCH_LIMIT_X - 1u) / BVH_DISPATCH_LIMIT_X);
    if (first == 0u)
    {
        bvhCounters[argsWord + 2u] = 1u;
    }
}

/**
 * @brief 2パス目へ回す列の位置 slot（容量の内側）へ積んだ後、その列を読む dispatch の引数を引き上げる
 *
 * groupsPerEntry が 1 なら 1 要素 1 ワークグループ（範囲の列）、0 なら 64 要素で 1 ワークグループ（節・クラスタの列）。
 * ワークグループ数は積めた数について単調なので atomicMax で、スレッドの順序によらず最後は積めた数に対する値になる。
 */
void RaiseDeferArgs(uint argsWord, uint slot, bool bGroupPerEntry)
{
    uint groups = bGroupPerEntry ? slot + 1u : (slot + BVH_NODE_ENTRIES_PER_GROUP) / BVH_NODE_ENTRIES_PER_GROUP;
    uint groupsBefore = bGroupPerEntry ? slot : (slot + BVH_NODE_ENTRIES_PER_GROUP - 1u) / BVH_NODE_ENTRIES_PER_GROUP;
    if (groups == groupsBefore)
    {
        return;
    }
    atomicMax(bvhPass2[argsWord], min(groups, BVH_DISPATCH_LIMIT_X));
    atomicMax(bvhPass2[argsWord + 1u], (groups + BVH_DISPATCH_LIMIT_X - 1u) / BVH_DISPATCH_LIMIT_X);
    atomicMax(bvhPass2[argsWord + 2u], 1u);
}

/**
 * @brief 2パス目に全部の根を判定し直させる（2パス目へ回す列のどれかが溢れたとき）
 *
 * 溢れた印を立て、全部の根を見直す dispatch の引数を全部の根（bvhRootCount）の数まで引き上げる。回した列を読む dispatch は
 * 何もしない（同じ席・節・クラスタを2回判定しない）。
 */
void RequestPass2Rescan()
{
    if (atomicAdd(bvhPass2[BVH_PASS2_FALLBACK], 1u) == 0u)
    {
        atomicAdd(stats[STAT_BVH_PASS2_FALLBACK], 1u);
    }
    uint groups = (cullData.bvhRootCount + BVH_NODE_ENTRIES_PER_GROUP - 1u) / BVH_NODE_ENTRIES_PER_GROUP;
    if (groups > 0u)
    {
        atomicMax(bvhPass2[0], min(groups, BVH_DISPATCH_LIMIT_X));
        atomicMax(bvhPass2[1], (groups + BVH_DISPATCH_LIMIT_X - 1u) / BVH_DISPATCH_LIMIT_X);
        atomicMax(bvhPass2[2], 1u);
    }
}

// 2パス目へ回した節の列・クラスタの列の先頭（語）
uint DeferNodeBase()
{
    return BVH_PASS2_HEADER_WORDS + cullData.bvhDeferCapacity * BVH_DEFER_ENTRY_WORDS;
}

uint DeferClusterBase()
{
    return DeferNodeBase() + cullData.bvhDeferNodeCapacity * BVH_DEFER_PAIR_WORDS;
}

// 2パス目が全部の根を見直すフレームか（2パス目へ回す列のどれかが溢れた）
bool IsPass2Rescan()
{
    return cullData.cullPass == CULL_PASS_SECOND && bvhPass2[BVH_PASS2_FALLBACK] != 0u;
}

/**
 * @brief 1パス目で前のフレームの HZB に隠れた範囲の席（印の立った席）を、2パス目へ回した範囲の列へ 1 要素として積む
 *
 * 1 要素 = 2パス目の 1 ワークグループ。容量を超えたら積まずに数え、2パス目に全部の根を遮蔽なしで判定し直させる
 * （積めなかった範囲の席は1パス目でたどっていないので、見直さないと描かれない）。
 */
void AppendDeferredRange(uint range, uint seatMaskLow, uint seatMaskHigh)
{
    CountStat(STAT_TWOPASS_DEFER_ENTRIES);
    uint slot = atomicAdd(bvhPass2[BVH_DEFER_COUNT], 1u);
    if (slot >= cullData.bvhDeferCapacity)
    {
        CountStat(STAT_TWOPASS_DEFER_OVERFLOW);
        RequestPass2Rescan();
        return;
    }
    uint base = BVH_PASS2_HEADER_WORDS + slot * BVH_DEFER_ENTRY_WORDS;
    bvhPass2[base] = range;
    bvhPass2[base + 1u] = seatMaskLow;
    bvhPass2[base + 2u] = seatMaskHigh;
    RaiseDeferArgs(BVH_DEFER_ARGS, slot, true);
}

/**
 * @brief 1パス目で前のフレームの HZB に隠れた節を、2パス目へ回した節の列へ積む（容量を超えたら全部の根を見直させる）
 */
void AppendDeferredNode(uint instanceIndex, uint nodeIndex)
{
    CountStat(STAT_TWOPASS_DEFER_NODES);
    uint slot = atomicAdd(bvhPass2[BVH_DEFER_NODE_COUNT], 1u);
    if (slot >= cullData.bvhDeferNodeCapacity)
    {
        CountStat(STAT_TWOPASS_NODE_OVERFLOW);
        RequestPass2Rescan();
        return;
    }
    uint base = DeferNodeBase() + slot * BVH_DEFER_PAIR_WORDS;
    bvhPass2[base] = instanceIndex;
    bvhPass2[base + 1u] = nodeIndex;
    RaiseDeferArgs(BVH_DEFER_NODE_ARGS, slot, false);
}

/**
 * @brief 1パス目で前のフレームの HZB に隠れたクラスタを、2パス目へ回したクラスタの列へ積む（Common/MegaGeometryCull.glsl の
 * ProcessCluster が呼ぶ。容量を超えたら全部の根を見直させる）
 */
void AppendDeferredCluster(uint instanceIndex, uint clusterIndex)
{
    uint slot = atomicAdd(bvhPass2[BVH_DEFER_CLUSTER_COUNT], 1u);
    if (slot >= cullData.bvhDeferClusterCapacity)
    {
        CountStat(STAT_TWOPASS_CLUSTER_OVERFLOW);
        RequestPass2Rescan();
        return;
    }
    uint base = DeferClusterBase() + slot * BVH_DEFER_PAIR_WORDS;
    bvhPass2[base] = instanceIndex;
    bvhPass2[base + 1u] = clusterIndex;
    RaiseDeferArgs(BVH_DEFER_CLUSTER_ARGS, slot, false);
}

/**
 * @brief 節の LOD の判定: 節の球から投影した親の誤差の最大が許容以下なら true（下のどのクラスタも描かれない）
 *
 * 親が十分に細かいので、下のクラスタは「親の誤差が許容を超える」条件を満たさない。節の球は下の球を包み、誤差は下の最大
 * 以上なので、投影した値は下の値以上（単調）。丸めで下の値より僅かに小さく出ても葉で描かれるクラスタを切らないよう、
 * BVH_LOD_PRUNE_MARGIN を掛けて比べる。NaN は切らない側。MegaGeometryBvhSelection.h の CanPruneBvhNodeByLOD と同じ。
 */
bool CanPruneBvhNodeByLOD(BvhNode node)
{
    return ProjectBakedError(node.sphere.xyz, node.sphere.w, uintBitsToFloat(node.info.x)) * BVH_LOD_PRUNE_MARGIN
           <= cullData.lodBias;
}

// 判定を通った節の子を積む段の番号（2パス目へ回した節の段は、席の段と同じく段1の列へ積む）
uint NextNodeStage()
{
    return cullData.bvhStage == BVH_STAGE_DEFERRED_NODES ? 1u : cullData.bvhStage + 1u;
}

/**
 * @brief 子の節を列へ積む前の判定: 節の球が視錐台の外か、LOD で枝を切れるなら true（積まない）
 *
 * どちらもフレームの中で変わらない値（視錐台・lodBias・インスタンスの変換）だけで決まるので、1パス目・2パス目・全部の根の
 * 見直しのどこで判定しても同じ答えになる。g_WorldMatrix はこの節のインスタンスの変換であること。
 */
bool IsBvhChildCulled(BvhNode node)
{
    vec3 center = TransformClusterCenterToWorld(node.sphere.xyz);
    float radius = node.sphere.w * ComputeWorldRadiusScale();
    return FrustumCullSphere(center, radius) || CanPruneBvhNodeByLOD(node);
}

/**
 * @brief 判定を通った節（インスタンス・節の番号）を次へ渡す: 葉は葉の列へ、内部の節は子を次の段の列へ積む
 *
 * 内部の節は、子を積む前に子ごとに視錐台と LOD の判定（IsBvhChildCulled）をし、通った子だけを詰めて積む。
 * bPass1Reached は、2パス目が全部の根を見直すときに「1パス目もこの節の下へたどった」ことを要素へ載せる（それ以外は false）。
 */
void PushPassedNode(uint instanceIndex, uint nodeIndex, BvhNode node, BvhNodeArray bvh, bool bPass1Reached)
{
    uint reachedBit = bPass1Reached ? BVH_ENTRY_PASS1_REACHED : 0u;
    if ((node.info.w & BVH_NODE_FLAG_LEAF) != 0u)
    {
        uint slot = atomicAdd(bvhCounters[BVH_LEAF_COUNTER], 1u);
        if (slot >= cullData.bvhLeafCapacity)
        {
            atomicAdd(stats[STAT_BVH_OVERFLOW], 1u);
            atomicMax(stats[STAT_BVH_LEAF_PEAK], slot + 1u);
            return;
        }
        bvhQueue[cullData.bvhLeafBase + slot] = uvec2(instanceIndex, nodeIndex | reachedBit);
        RaiseStageArgs(BVH_ARGS_BASE + BVH_LEAF_COUNTER * BVH_ARGS_STRIDE, STAT_BVH_LEAF_PEAK, slot, slot + 1u, slot + 1u,
                       BVH_LEAF_ENTRIES_PER_GROUP);
    }
    else
    {
        // 子の数は GROUP_BVH_MAX_CHILDREN（8）以下。通った子をビットの印に集める
        uint passedMask = 0u;
        for (uint child = 0u; child < node.info.z; ++child)
        {
            if (!IsBvhChildCulled(bvh.nodes[node.info.y + child]))
            {
                passedMask |= 1u << child;
            }
        }
        uint childCount = uint(bitCount(passedMask));
        if (childCount == 0u)
        {
            return;
        }
        uint nextStage = NextNodeStage();
        uint firstSlot = atomicAdd(bvhCounters[nextStage], childCount);
        uint stored = firstSlot >= cullData.bvhNodeCapacity ? 0u : min(childCount, cullData.bvhNodeCapacity - firstSlot);
        uint remaining = passedMask;
        for (uint written = 0u; written < stored; ++written)
        {
            uint child = uint(findLSB(remaining));
            remaining &= remaining - 1u;
            bvhQueue[cullData.bvhNextBase + firstSlot + written] = uvec2(instanceIndex, (node.info.y + child) | reachedBit);
        }
        if (stored < childCount)
        {
            atomicAdd(stats[STAT_BVH_OVERFLOW], childCount - stored);
            atomicMax(stats[STAT_BVH_NODE_PEAK], firstSlot + childCount);
        }
        if (stored > 0u)
        {
            RaiseStageArgs(BVH_ARGS_BASE + nextStage * BVH_ARGS_STRIDE, STAT_BVH_NODE_PEAK, firstSlot, firstSlot + stored,
                           firstSlot + childCount, BVH_NODE_ENTRIES_PER_GROUP);
        }
    }
}

/**
 * @brief AABB が視錐台の外か（どれかの平面について、平面の内側の向きに最も進んだ頂点が外側にある）
 * @return true = カリング（不可視）
 */
bool FrustumCullBox(vec3 boxMin, vec3 boxMax)
{
    for (int i = 0; i < 6; ++i)
    {
        vec3 normal = cullData.frustumPlanes[i].xyz;
        vec3 farthest = mix(boxMin, boxMax, greaterThanEqual(normal, vec3(0.0)));
        if (dot(normal, farthest) + cullData.frustumPlanes[i].w < 0.0)
        {
            return true;
        }
    }
    return false;
}

/**
 * @brief 距離の判定: instanceCullDistance が 0 より大きく、最も近い点までの距離（nearest）がそれより遠ければ true
 */
bool DistanceCull(float nearest)
{
    return cullData.instanceCullDistance > 0.0 && nearest > cullData.instanceCullDistance;
}

/**
 * @brief 画素の大きさの判定: 球を包む AABB の8点を画面へ投影した矩形が、画素の中心を1つも含まなければ true
 *
 * 三角形が画素を覆うのは画素の中心が三角形の中にあるときだけ（ハードもソフトのラスタも同じ規則）で、三角形は球の中、
 * 球の投影は8点の矩形の中にあるので、矩形に中心が無ければどの画素も描かれない。8点のどれかがカメラの後ろにかかるときは
 * 判定しない。画素の中心は (k + 0.5) で、描く範囲の原点が整数なら上下の反転でも中心は中心へ移るので、反転の向きによらない。
 */
bool PixelCullSphere(vec3 center, float radius)
{
    if (cullData.pixelCullWidth <= 0.0 || cullData.pixelCullHeight <= 0.0)
    {
        return false;
    }
    mat4 viewProjection = cullData.projectionMatrix * cullData.viewMatrix;
    vec2 ndcMin = vec2(1.0e30);
    vec2 ndcMax = vec2(-1.0e30);
    for (int corner = 0; corner < 8; ++corner)
    {
        vec3 offset = vec3((corner & 1) != 0 ? radius : -radius,
                           (corner & 2) != 0 ? radius : -radius,
                           (corner & 4) != 0 ? radius : -radius);
        vec4 clip = viewProjection * vec4(center + offset, 1.0);
        if (!(clip.w > 1.0e-6))
        {
            return false;
        }
        vec2 ndc = clip.xy / clip.w;
        ndcMin = min(ndcMin, ndc);
        ndcMax = max(ndcMax, ndc);
    }
    vec2 size = vec2(cullData.pixelCullWidth, cullData.pixelCullHeight);
    vec2 pixelMin = (ndcMin * 0.5 + 0.5) * size - PIXEL_CULL_MARGIN;
    vec2 pixelMax = (ndcMax * 0.5 + 0.5) * size + PIXEL_CULL_MARGIN;
    // 矩形に入る画素の中心 k + 0.5 の最初と最後。どちらかの軸で最後が最初より前なら、中心は無い
    vec2 firstCenter = ceil(pixelMin - 0.5);
    vec2 lastCenter = floor(pixelMax - 0.5);
    return any(lessThan(lastCenter, firstCenter));
}

/**
 * @brief 範囲の段の視錐台・距離の判定（範囲の印・AABB）。通れば true
 */
bool PassesRangeBasicTests(uint range, out vec3 boxMin, out vec3 boxMax, out bool bBounded)
{
    vec4 minWord = rangeBounds[range * 2u];
    vec4 maxWord = rangeBounds[range * 2u + 1u];
    boxMin = minWord.xyz;
    boxMax = maxWord.xyz;
    uint flags = uint(minWord.w);
    bBounded = (flags & RANGE_FLAG_UNBOUNDED) == 0u;
    if ((flags & RANGE_FLAG_HAS_ROWS) == 0u)
    {
        return false;
    }
    if (!bBounded)
    {
        return true;
    }
    if (FrustumCullBox(boxMin, boxMax))
    {
        return false;
    }
    vec3 camera = cullData.cameraPosition.xyz;
    return !DistanceCull(distance(camera, clamp(camera, boxMin, boxMax)));
}

// 範囲の AABB を包む球が前のフレームの HZB に隠れているか（1パス目の範囲の段の判定）
bool PrevOcclusionCullRange(vec3 boxMin, vec3 boxMax)
{
    return PrevOcclusionCullSphere((boxMin + boxMax) * 0.5, 0.5 * length(boxMax - boxMin));
}

/**
 * @brief 範囲の段: 1スレッドが1つの範囲の AABB を視錐台・距離で判定し、通った範囲を節の列 0 へ積む
 *
 * 席の段の間接 dispatch の引数（段0の位置。1 範囲 = 1 ワークグループ）を積めた数から書く。範囲の一覧は節の列 0 を使うので、
 * 積もうとした数は節の列の最大（STAT_BVH_NODE_PEAK）に含める。
 */
void RangeStage()
{
    uint flatGroup = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint range = flatGroup * 64u + gl_LocalInvocationID.x;
    if (range >= cullData.bvhRangeCount)
    {
        return;
    }
    vec3 boxMin;
    vec3 boxMax;
    bool bBounded;
    if (!PassesRangeBasicTests(range, boxMin, boxMax, bBounded))
    {
        return;
    }
    // 1パス目: AABB を包む球が前のフレームの HZB に隠れていれば、範囲ごと2パス目へ回す（席は2パス目が判定する）
    if (bBounded && cullData.cullPass == CULL_PASS_FIRST && PrevOcclusionCullRange(boxMin, boxMax))
    {
        CountStat(STAT_TWOPASS_DEFER_RANGES);
        AppendDeferredRange(range, 0xFFFFFFFFu, 0xFFFFFFFFu);
        return;
    }

    uint slot = atomicAdd(bvhCounters[0], 1u);
    if (slot >= cullData.bvhNodeCapacity)
    {
        atomicAdd(stats[STAT_BVH_OVERFLOW], 1u);
        atomicMax(stats[STAT_BVH_NODE_PEAK], slot + 1u);
        return;
    }
    bvhQueue[cullData.bvhNextBase + slot] = uvec2(range, 0u);
    RaiseStageArgs(BVH_ARGS_BASE, STAT_BVH_NODE_PEAK, slot, slot + 1u, slot + 1u, 1u);
}

/**
 * @brief 1パス目の範囲の段が、この範囲を席の段へ渡したか（2パス目が全部の根を見直すときに、1パス目の道を判定し直す）
 */
bool RangeReachedInFirstPass(uint range)
{
    vec3 boxMin;
    vec3 boxMax;
    bool bBounded;
    if (!PassesRangeBasicTests(range, boxMin, boxMax, bBounded))
    {
        return false;
    }
    return !bBounded || !PrevOcclusionCullRange(boxMin, boxMax);
}

/**
 * @brief 席の遮蔽以外の判定: 締まった球の視錐台・距離・画素の大きさと、根の節の LOD
 *
 * 通れば true で、根の節と締まった球（ワールド）と BVH の節の配列のアドレスを返す（g_WorldMatrix はこの席の変換になる）。
 * 両パスで同じ値になる。
 */
bool PassesSeatBasicTests(uint instanceIndex, out BvhNode root, out vec3 center, out float radius, out uvec2 bvhAddress)
{
    MegaInstance instance = LoadMegaInstance(instanceIndex);

    g_WorldMatrix = instance.world;
    bvhAddress = uvec2(instance.bvhInfo.x, instance.bvhInfo.y);
    BvhNodeArray bvh = BvhNodeArray(bvhAddress);
    root = bvh.nodes[0];

    // 締まった球: メッシュ全体の球 × 拡大率。メッシュの球が無ければ根の節の球（下のクラスタと親の球を包むので大きい）
    vec4 localSphere = instance.boundsSphere.w > 0.0 ? instance.boundsSphere : root.sphere;
    center = TransformClusterCenterToWorld(localSphere.xyz);
    radius = localSphere.w * ComputeWorldRadiusScale();
    if (FrustumCullSphere(center, radius))
    {
        return false;
    }
    if (DistanceCull(distance(center, cullData.cameraPosition.xyz) - radius))
    {
        return false;
    }
    if (PixelCullSphere(center, radius))
    {
        return false;
    }
    return !CanPruneBvhNodeByLOD(root);
}

// 1パス目の席の段で、前のフレームの HZB に隠れた席の印（ワークグループ = 1 つの範囲の 64 席）
shared uint s_DeferredSeats[2];

/**
 * @brief 前のフレームの HZB を使う1パス目の席の段: 1 ワークグループ = 範囲の段が積んだ 1 つの範囲（64 席）
 *
 * 遮蔽以外の判定と根の LOD を通った席を前の HZB で判定し、見える席は1パス目でたどり、隠れた席は
 * ワークグループで印をまとめて、範囲ごとに 1 要素として2パス目へ回す（barrier を通るので、席ごとに途中で抜けない）。
 */
void SeatStageWithPrevHiZ()
{
    uint flatGroup = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    // ワークグループ全体で同じ判断（barrier の前に抜けるのはワークグループごと）
    if (flatGroup >= min(bvhCounters[0], cullData.bvhNodeCapacity))
    {
        return;
    }
    uint lane = gl_LocalInvocationID.x;
    uint range = bvhQueue[cullData.bvhInputBase + flatGroup].x;
    uint instanceIndex = range * RANGE_SEATS + lane;
    if (lane < 2u)
    {
        s_DeferredSeats[lane] = 0u;
    }
    memoryBarrierShared();
    barrier();

    bool bTraverse = false;
    BvhNode root;
    uvec2 bvhAddress = uvec2(0u);
    if (instanceIndex < cullData.bvhRootCount)
    {
        vec3 center;
        float radius;
        if (PassesSeatBasicTests(instanceIndex, root, center, radius, bvhAddress))
        {
            if (PrevOcclusionCullSphere(center, radius))
            {
                atomicOr(s_DeferredSeats[lane >> 5u], 1u << (lane & 31u));
                CountStat(STAT_TWOPASS_DEFER_SEATS);
            }
            else
            {
                bTraverse = true;
            }
        }
    }
    memoryBarrierShared();
    barrier();

    if (lane == 0u && (s_DeferredSeats[0] | s_DeferredSeats[1]) != 0u)
    {
        AppendDeferredRange(range, s_DeferredSeats[0], s_DeferredSeats[1]);
    }
    if (bTraverse)
    {
        CountStat(STAT_TWOPASS_PASS1_SEATS);
        PushPassedNode(instanceIndex, 0u, root, BvhNodeArray(bvhAddress), false);
    }
}

/**
 * @brief 席の段（段0）: 1席1スレッドで締まった球の判定をし、通った席の根の節を判定して子を段1の列へ積む
 */
void SeatStage()
{
    uint flatGroup = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint thread = flatGroup * 64u + gl_LocalInvocationID.x;
    // 2パス目に全部の根を判定し直すか（2パス目へ回す列のどれかが溢れた）
    bool bRescan = IsPass2Rescan();
    bool bDeferredSeat = false;

    uint instanceIndex = thread;
    if (cullData.bvhSeatsFromRanges == SEATS_FROM_RANGES)
    {
        // 1 ワークグループ = 範囲の段が積んだ 1 つの範囲（64 席）
        if (flatGroup >= min(bvhCounters[0], cullData.bvhNodeCapacity))
        {
            return;
        }
        instanceIndex = bvhQueue[cullData.bvhInputBase + flatGroup].x * RANGE_SEATS + gl_LocalInvocationID.x;
        if (instanceIndex >= cullData.bvhRootCount)
        {
            return;
        }
    }
    else if (cullData.bvhSeatsFromRanges == SEATS_FROM_DEFERRED)
    {
        // 2パス目: 1 ワークグループ = 1パス目が回した範囲の列の 1 要素。印の立った席だけを判定する。
        // 全部の根を判定し直すときは、全部の根の dispatch がこの席も受け持つ
        if (bRescan || flatGroup >= min(bvhPass2[BVH_DEFER_COUNT], cullData.bvhDeferCapacity))
        {
            return;
        }
        uint lane = gl_LocalInvocationID.x;
        uint base = BVH_PASS2_HEADER_WORDS + flatGroup * BVH_DEFER_ENTRY_WORDS;
        uint seatMask = bvhPass2[base + 1u + (lane >> 5u)];
        if ((seatMask & (1u << (lane & 31u))) == 0u)
        {
            return;
        }
        instanceIndex = bvhPass2[base] * RANGE_SEATS + lane;
        if (instanceIndex >= cullData.bvhRootCount)
        {
            return;
        }
        bDeferredSeat = true;
        CountStat(STAT_TWOPASS_PASS2_TESTED);
    }
    else if (cullData.cullPass == CULL_PASS_SECOND)
    {
        // 2パス目の全部の根: 回した列が溢れたフレームだけ引数が 0 でなくなる
        if (!bRescan || thread >= cullData.bvhRootCount)
        {
            return;
        }
    }
    else if (thread >= cullData.bvhRootCount)
    {
        return;
    }

    BvhNode root;
    vec3 center;
    float radius;
    uvec2 bvhAddress;
    if (!PassesSeatBasicTests(instanceIndex, root, center, radius, bvhAddress))
    {
        return;
    }
    // 遮蔽の判定は2パス目だけ（1パス目の前のフレームの HZB の判定は SeatStageWithPrevHiZ）。
    // 全部の根を判定し直すときは、溢れて積めなかった範囲の席を取りこぼさないよう席の遮蔽の判定をしない
    if (cullData.cullPass == CULL_PASS_SECOND && !bRescan && OcclusionCullSphere(center, radius))
    {
        return;
    }
    if (bDeferredSeat)
    {
        CountStat(STAT_TWOPASS_PASS2_PASSED);
    }
    // 全部の根を見直すときは、1パス目がこの席をたどったか（範囲も席も前の HZB に隠れなかった）を判定し直して子へ運ぶ
    bool bPass1Reached = bRescan && RangeReachedInFirstPass(instanceIndex / RANGE_SEATS) &&
                         !PrevOcclusionCullSphere(center, radius);
    PushPassedNode(instanceIndex, 0u, root, BvhNodeArray(bvhAddress), bPass1Reached);
}

/**
 * @brief 1つの節を節の球で判定し、通れば子を次へ渡す（節の段と、2パス目へ回した節の段が使う）
 *
 * 列の節は、積んだ親が視錐台と LOD の判定（IsBvhChildCulled）を済ませている（2パス目へ回した節も、1パス目に同じ親が
 * 積んだもの）ので、ここでは遮蔽だけを判定する。2パス目は今のフレームの HZB で枝を切り、1パス目は前のフレームの HZB に
 * 隠れていれば2パス目へ回す。bPass1Reached は全部の根を見直す2パス目だけが true にし、
 * 1パス目もこの節が前の HZB に隠れずに子をたどったかを判定し直して子へ運ぶ。
 */
void TestNode(uint instanceIndex, uint nodeIndex, bool bPass1Reached)
{
    MegaInstance instance = LoadMegaInstance(instanceIndex);

    g_WorldMatrix = instance.world;
    BvhNodeArray bvh = BvhNodeArray(uvec2(instance.bvhInfo.x, instance.bvhInfo.y));
    BvhNode node = bvh.nodes[nodeIndex];

    vec3 center = TransformClusterCenterToWorld(node.sphere.xyz);
    float radius = node.sphere.w * ComputeWorldRadiusScale();
    // 節の球が完全に隠れていれば、下のクラスタも隠れている
    if (cullData.cullPass == CULL_PASS_SECOND && OcclusionCullSphere(center, radius))
    {
        return;
    }
    if (cullData.cullPass == CULL_PASS_FIRST && PrevOcclusionCullSphere(center, radius))
    {
        AppendDeferredNode(instanceIndex, nodeIndex);
        return;
    }
    bool bChildReached = bPass1Reached && !PrevOcclusionCullSphere(center, radius);
    PushPassedNode(instanceIndex, nodeIndex, node, bvh, bChildReached);
}

/**
 * @brief 節の判定の段（段1以上）: 前の段が積んだ節を節の球で判定し、通った節の子を次へ渡す
 */
void NodeStage()
{
    uint flatGroup = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint thread = flatGroup * 64u + gl_LocalInvocationID.x;

    // この段の入力（容量で頭打ちにした数）と、受け持つ要素
    if (thread >= min(bvhCounters[cullData.bvhStage], cullData.bvhNodeCapacity))
    {
        return;
    }
    uvec2 entry = bvhQueue[cullData.bvhInputBase + thread];
    TestNode(entry.x, entry.y & BVH_ENTRY_NODE_MASK, (entry.y & BVH_ENTRY_PASS1_REACHED) != 0u);
}

/**
 * @brief 2パス目へ回した節の段: 1パス目が回した節を 1 要素 1 スレッドで今のフレームの HZB で判定し、子を段1の列へ積む
 *
 * 全部の根を見直すフレームは何もしない（全部の根の dispatch が受け持つ）。
 */
void DeferredNodeStage()
{
    uint flatGroup = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint thread = flatGroup * 64u + gl_LocalInvocationID.x;
    if (IsPass2Rescan() || thread >= min(bvhPass2[BVH_DEFER_NODE_COUNT], cullData.bvhDeferNodeCapacity))
    {
        return;
    }
    uint base = DeferNodeBase() + thread * BVH_DEFER_PAIR_WORDS;
    TestNode(bvhPass2[base], bvhPass2[base + 1u], false);
}

// このスレッドが受け持つクラスタのインスタンスの変換・LOD の球・クラスタ配列を決める
MegaInstance BindClusterInstance(uint instanceIndex)
{
    MegaInstance instance = LoadMegaInstance(instanceIndex);
    g_WorldMatrix = instance.world;
    g_LODSphere = instance.lodSphere;
    g_Clusters = ClusterArray(uvec2(instance.clusterInfo.x, instance.clusterInfo.y));
    return instance;
}

void ClusterStage()
{
    uint flatGroup = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint thread = flatGroup * 64u + gl_LocalInvocationID.x;
    uint leafSlot = thread / BVH_LEAF_SLOTS;
    uint memberSlot = thread % BVH_LEAF_SLOTS;

    if (leafSlot >= min(bvhCounters[BVH_LEAF_COUNTER], cullData.bvhLeafCapacity))
    {
        return;
    }
    uvec2 entry = bvhQueue[cullData.bvhLeafBase + leafSlot];
    uint instanceIndex = entry.x;
    MegaInstance instance = BindClusterInstance(instanceIndex);

    BvhNodeArray bvh = BvhNodeArray(uvec2(instance.bvhInfo.x, instance.bvhInfo.y));
    BvhNode node = bvh.nodes[entry.y & BVH_ENTRY_NODE_MASK];
    if (memberSlot >= node.info.z)
    {
        return;
    }

    // 焼き込みの BVH の葉はクラスタの連続した範囲。実行時に作った BVH の葉は並べ替えの表の範囲なので、表でクラスタの番号を引く
    uint clusterIndex = node.info.y + memberSlot;
    if ((node.info.w & BVH_NODE_FLAG_CLUSTER_ORDER) != 0u)
    {
        uint carry;
        uint orderLow = uaddCarry(instance.bvhInfo.x, instance.bvhInfo.z * 32u, carry);
        BvhClusterOrderArray order = BvhClusterOrderArray(uvec2(orderLow, instance.bvhInfo.y + carry));
        clusterIndex = order.clusters[clusterIndex];
    }

    ProcessCluster(instanceIndex, instance, clusterIndex, (entry.y & BVH_ENTRY_PASS1_REACHED) != 0u);
}

/**
 * @brief 2パス目へ回したクラスタの段: 1パス目が回したクラスタを 1 要素 1 スレッドで ProcessCluster にかける
 *
 * 全部の根を見直すフレームは何もしない（全部の根の dispatch がたどった葉で受け持つ）。
 */
void DeferredClusterStage()
{
    uint flatGroup = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint thread = flatGroup * 64u + gl_LocalInvocationID.x;
    if (IsPass2Rescan() || thread >= min(bvhPass2[BVH_DEFER_CLUSTER_COUNT], cullData.bvhDeferClusterCapacity))
    {
        return;
    }
    uint base = DeferClusterBase() + thread * BVH_DEFER_PAIR_WORDS;
    uint instanceIndex = bvhPass2[base];
    MegaInstance instance = BindClusterInstance(instanceIndex);
    ProcessCluster(instanceIndex, instance, bvhPass2[base + 1u], false);
}

void main()
{
    if (cullData.bvhStage == BVH_STAGE_CLUSTERS)
    {
        ClusterStage();
    }
    else if (cullData.bvhStage == BVH_STAGE_RANGES)
    {
        RangeStage();
    }
    else if (cullData.bvhStage == BVH_STAGE_DEFERRED_NODES)
    {
        DeferredNodeStage();
    }
    else if (cullData.bvhStage == BVH_STAGE_DEFERRED_CLUSTERS)
    {
        DeferredClusterStage();
    }
    else if (cullData.bvhStage == 0u)
    {
        // 前のフレームの HZB を使う1パス目は、範囲の一覧から席を引く（dispatch 全体で同じ分岐）
        if (cullData.cullPass == CULL_PASS_FIRST && cullData.bPrevHiZEnabled != 0u &&
            cullData.bvhSeatsFromRanges == SEATS_FROM_RANGES)
        {
            SeatStageWithPrevHiZ();
        }
        else
        {
            SeatStage();
        }
    }
    else
    {
        NodeStage();
    }
}
