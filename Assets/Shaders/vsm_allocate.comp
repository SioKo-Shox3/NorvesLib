#version 450

// ========================================
// 太陽の仮想シャドウマップ（VSM）の物理ページの割り当て（ページの表を前フレームから引き継ぐ）
//
// 11 回の dispatch で作る（params.control.x が段階）。いずれも 256 スレッドのワークグループ。
// ページの表の欄は「割り当て済み・dirty・物理ページの番号」。dirty は「今フレームに消去して描き直す」印で、毎フレームの最初に全部外す。
// 物理ページごとの年齢（要求されなかった連続のフレーム数）は、空きページの一覧のバッファの後ろの領域（freeList の語 1 + 2 × ページ数 〜）に持つ。
//
//   段階 0（引き継ぎ）: ページの表の割り当て済みの欄ごとに 1 スレッド。dirty を外す。キャッシュを使わない、または段の範囲が
//     動いて欄のトーラスの番地が指す絶対のページが変わった（範囲の外へ出た）欄は、空きへ戻す（欄を 0 にする）。
//     全ページを無効にする指定（太陽の向き・深度の原点が変わった）なら、残った欄に dirty を付ける。
//   段階 1（無効化）: 無効化の矩形（ライト空間。動いた投影物の前フレームと今フレームの境界）× 段ごとに 1 スレッド。
//     矩形が覆う、範囲の中の割り当て済みのページに dirty を付ける。
//   段階 2（年齢）: 欄ごとに 1 スレッド。要求のあるページは年齢を 0 にする。要求の無いページは、dirty なら（描き直しても使われないので）
//     空きへ戻し、そうでなければ年齢を 1 足して、持ち越しの上限を超えたら空きへ戻す。要求があるのに割り当ての無い欄の数（新しく要るページの数）と、
//     使用中のページの数、年齢ごとの数を数える。
//   段階 3（古い順の計画）: 1 スレッド。新しく要るページが空きより多いとき、足りない数を、要求の無いページの古いほうから戻す計画にする
//     （しきい値の年齢と、その年齢から戻す数）。
//   段階 4（古い順に戻す）: 欄ごとに 1 スレッド。計画に従って、要求の無いページを空きへ戻す。
//   段階 5〜7（空きの一覧）: 使用中の印を 0 にし（5）、ページの表の割り当て済みの欄の物理ページに印を付け（6）、印の無い物理ページを一覧へ詰める（7）。
//   段階 8（割り当てる）: 要求のビット列の語ごとに 1 スレッド。立っているビットのうち割り当ての無い欄ごとに、空きの一覧の後ろから 1 つ取って、
//     「割り当て済み・dirty・物理ページの番号」を書き、年齢を 0 にする。空きが尽きたら割り当てない（溢れ）。
//   段階 9（消去の一覧）: 欄ごとに 1 スレッド。dirty の物理ページを消去する一覧へ足し、要求があって dirty でない欄を持ち越しとして数える。
//   段階 10（締める）: 1 スレッド。統計（割り当て・溢れ・描いたページ）と空きの数・間接 dispatch の引数を決める。
//
// ページの表と要求のビット列の欄は、スライス（太陽では段）の表（binding 8。Common/VirtualShadowMapSlice.glsl）の先頭から並ぶ。
// 欄の全体を走査する段階は、同じ大きさ（ENTRIES_PER_LEVEL 欄）のスライスが先頭から詰まっている前提で欄の番号からスライスを求める。
// ページの一辺・範囲の原点・前フレームの原点はスライスの表から引く。
//
// 統計（stats）の語は VirtualShadowMapPass.h の StatWord と同じ。
// 消去するページの一覧（dirtyList）: 0〜2 = 間接 dispatch の引数（x, y, 1）、3 = 数、4 以降 = 物理ページの番号。
// ========================================

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std140, set = 0, binding = 0) uniform VsmParams
{
    mat4 invViewProjection;
    vec4 cameraPosition;
    vec4 lightRight;
    vec4 lightUp;
    // x: 幅、y: 高さ、z: スライス（段）の数、w: 1 段の一辺のページ数
    uvec4 screen;
    vec4 tuning;
    // x: 段階、y: 物理ページの数、z: 間接 dispatch の x の上限
    uvec4 control;
    vec4 thresholds[4];
    // vsm_mark.comp だけが読む（xyz: カメラの前方、w: 影の範囲の手前の端）
    vec4 view;
    // x: 印（1 = キャッシュを使う、2 = 全ページを無効にする）、y: 持ち越すフレーム数、z: 無効化の矩形の数
    uvec4 cache;
    // 無効化の矩形（ライト空間。x, y = 最小、z, w = 最大）
    vec4 rects[256];
} params;

layout(std430, set = 0, binding = 2) buffer VsmRequestBits
{
    uint requestBits[];
};

layout(std430, set = 0, binding = 3) buffer VsmPageTable
{
    uint pageTable[];
};

layout(std430, set = 0, binding = 4) buffer VsmFreeList
{
    uint freeList[];
};

layout(std430, set = 0, binding = 5) buffer VsmStats
{
    uint stats[];
};

layout(std430, set = 0, binding = 6) buffer VsmDirtyList
{
    uint dirtyList[];
};

// スライスの表
#define VSM_SLICE_BINDING 8
#include "Common/VirtualShadowMapSlice.glsl"

const uint STAGE_SCROLL = 0u;
const uint STAGE_RECTS = 1u;
const uint STAGE_AGE = 2u;
const uint STAGE_EVICT_PLAN = 3u;
const uint STAGE_EVICT = 4u;
const uint STAGE_FREE_RESET = 5u;
const uint STAGE_FREE_MARK = 6u;
const uint STAGE_FREE_COMPACT = 7u;
const uint STAGE_ALLOCATE = 8u;
const uint STAGE_DIRTY_LIST = 9u;
const uint STAGE_FINALIZE = 10u;

const uint STAT_REQUESTED = 0u;
const uint STAT_ALLOCATED = 1u;
const uint STAT_OVERFLOW = 2u;
const uint STAT_LEVELS_USED = 4u;
const uint STAT_CACHED = 11u;
const uint STAT_RENDERED = 12u;
const uint STAT_INVALIDATED = 13u;
const uint STAT_RELEASED = 14u;
const uint STAT_NEED = 15u;
const uint STAT_USED = 16u;
const uint STAT_EVICT_AGE = 17u;
const uint STAT_EVICT_QUOTA = 18u;
const uint STAT_EVICT_TAKEN = 19u;
const uint STAT_ALLOC_CURSOR = 20u;
const uint STAT_AGE_HISTOGRAM = 21u;
const uint AGE_BINS = 32u;

const uint CACHE_FLAG_ENABLED = 1u;
const uint CACHE_FLAG_INVALIDATE_ALL = 2u;

const uint PAGE_ENTRY_ALLOCATED = 1u << 31;
const uint PAGE_ENTRY_DIRTY = 1u << 30;
const uint PAGE_ENTRY_RETRY = 1u << 29;
const uint PAGE_INDEX_MASK = (1u << 20) - 1u;

const uint DIRTY_COUNT = 3u;
const uint DIRTY_FIRST_PAGE = 4u;

// 1 スライス（太陽では段）の欄の数（128 × 128）。語（32 ビット）で数えた数
const uint ENTRIES_PER_LEVEL = 128u * 128u;
const uint WORDS_PER_LEVEL = ENTRIES_PER_LEVEL / 32u;

// 空きページの一覧のバッファの領域: [0] = 空きの数、[1 〜 ページ数] = 空きの物理ページ、続いて使用中の印・年齢（物理ページごと）
uint UsedFlagIndex(uint physical)
{
    return 1u + params.control.y + physical;
}

uint AgeIndex(uint physical)
{
    return 1u + 2u * params.control.y + physical;
}

uint TotalEntries()
{
    return params.screen.z * ENTRIES_PER_LEVEL;
}

bool IsRequested(uint entryIndex)
{
    return ((requestBits[entryIndex >> 5u] >> (entryIndex & 31u)) & 1u) != 0u;
}

// 欄を空きへ戻す（その欄だけが持つ物理ページなので、ほかのスレッドと競合しない）
void ReleaseEntry(uint entryIndex)
{
    pageTable[entryIndex] = 0u;
    atomicAdd(stats[STAT_RELEASED], 1u);
}

void Scroll()
{
    const uint entryIndex = gl_GlobalInvocationID.x;
    if (entryIndex >= TotalEntries())
    {
        return;
    }
    uint entry = pageTable[entryIndex];
    if ((entry & PAGE_ENTRY_ALLOCATED) == 0u)
    {
        return;
    }
    if ((params.cache.x & CACHE_FLAG_ENABLED) == 0u)
    {
        ReleaseEntry(entryIndex);
        return;
    }

    // 欄のトーラスの番地が、前フレームの範囲・今フレームの範囲で指す絶対のページ。違えば範囲の外へ出た（同じ番地が新しいページになった）
    const uint level = entryIndex / ENTRIES_PER_LEVEL;
    const VsmSlice slice = vsmSlices[level];
    const uint dimension = uint(slice.origin.w);
    const uint local = entryIndex - uint(slice.origin.z);
    const ivec2 address = ivec2(int(local % dimension), int(local / dimension));
    const ivec2 mask = ivec2(int(dimension) - 1);
    const ivec2 oldOrigin = slice.extra.xy;
    const ivec2 newOrigin = slice.origin.xy;
    const ivec2 oldPage = oldOrigin + ((address - oldOrigin) & mask);
    const ivec2 newPage = newOrigin + ((address - newOrigin) & mask);
    if (oldPage != newPage)
    {
        ReleaseEntry(entryIndex);
        return;
    }

    // 前フレームに消去して描いたので、dirty は外す。全ページを無効にする指定なら付け直す。
    // 前フレームの展開が容量の溢れで描けなかった塊の範囲のページ（再描画の印）は、欠けたまま持ち越さないよう dirty を付け直す
    const bool bRetry = (entry & PAGE_ENTRY_RETRY) != 0u;
    entry &= ~(PAGE_ENTRY_DIRTY | PAGE_ENTRY_RETRY);
    if ((params.cache.x & CACHE_FLAG_INVALIDATE_ALL) != 0u)
    {
        entry |= PAGE_ENTRY_DIRTY;
        atomicAdd(stats[STAT_INVALIDATED], 1u);
    }
    else if (bRetry)
    {
        entry |= PAGE_ENTRY_DIRTY;
        atomicAdd(stats[STAT_INVALIDATED], 1u);
    }
    pageTable[entryIndex] = entry;
}

void InvalidateRects()
{
    const uint levels = max(params.screen.z, 1u);
    const uint id = gl_GlobalInvocationID.x;
    const uint rectIndex = id / levels;
    const uint level = id % levels;
    if (rectIndex >= params.cache.z)
    {
        return;
    }
    const vec4 rect = params.rects[rectIndex];
    const VsmSlice slice = vsmSlices[level];
    const float pageMeters = slice.info.x;
    if (!(pageMeters > 0.0))
    {
        return;
    }
    const ivec2 origin = slice.origin.xy;
    const vec2 lowPage = clamp(floor(rect.xy / pageMeters), vec2(-1.0e9), vec2(1.0e9));
    const vec2 highPage = clamp(floor(rect.zw / pageMeters), vec2(-1.0e9), vec2(1.0e9));
    const ivec2 low = max(ivec2(lowPage), origin);
    const ivec2 high = min(ivec2(highPage), origin + ivec2(slice.origin.w - 1));
    for (int pageY = low.y; pageY <= high.y; ++pageY)
    {
        for (int pageX = low.x; pageX <= high.x; ++pageX)
        {
            const uint entryIndex = VsmSliceEntryIndex(slice, pageX, pageY);
            // 重なる矩形のスレッドが同じ語へ dirty を atomicOr するので、割り当ての判定の読み取りも原子的にする（通常の読み取りはデータ競合になる）。
            // 割り当て済みのビットはこの dispatch では変わらないので、atomicOr の戻り値（変更前の値）だけで判定できる
            const uint previous = atomicOr(pageTable[entryIndex], 0u);
            if ((previous & PAGE_ENTRY_ALLOCATED) == 0u)
            {
                continue;
            }
            const uint before = atomicOr(pageTable[entryIndex], PAGE_ENTRY_DIRTY);
            if ((before & PAGE_ENTRY_DIRTY) == 0u)
            {
                atomicAdd(stats[STAT_INVALIDATED], 1u);
            }
        }
    }
}

void Age()
{
    const uint entryIndex = gl_GlobalInvocationID.x;
    if (entryIndex >= TotalEntries())
    {
        return;
    }
    const uint entry = pageTable[entryIndex];
    const bool requested = IsRequested(entryIndex);
    if ((entry & PAGE_ENTRY_ALLOCATED) == 0u)
    {
        if (requested)
        {
            atomicAdd(stats[STAT_NEED], 1u);
        }
        return;
    }

    const uint physical = entry & PAGE_INDEX_MASK;
    if (requested)
    {
        freeList[AgeIndex(physical)] = 0u;
        atomicAdd(stats[STAT_USED], 1u);
        return;
    }
    // 要求が無く dirty の欄は、描き直しても使われないので戻す（古い内容のまま残して、後で消さずに使うことはしない）
    if ((entry & PAGE_ENTRY_DIRTY) != 0u)
    {
        ReleaseEntry(entryIndex);
        return;
    }
    const uint age = freeList[AgeIndex(physical)] + 1u;
    if (age > params.cache.y)
    {
        ReleaseEntry(entryIndex);
        return;
    }
    freeList[AgeIndex(physical)] = age;
    atomicAdd(stats[STAT_AGE_HISTOGRAM + min(age, AGE_BINS - 1u)], 1u);
    atomicAdd(stats[STAT_USED], 1u);
}

void EvictPlan()
{
    if (gl_GlobalInvocationID.x != 0u)
    {
        return;
    }
    const uint need = stats[STAT_NEED];
    const uint freePages = params.control.y - min(stats[STAT_USED], params.control.y);
    const uint deficit = need > freePages ? need - freePages : 0u;

    // 年齢の大きいほうから数えて、足りない数に届く年齢をしきい値にする。その年齢より古いものは全部、その年齢からは残りの数を戻す。
    // 戻せるものを全部戻しても足りないときは、年齢 1（要求の無いページはどれも 1 以上）から全部を戻す
    uint evictAge = AGE_BINS;
    uint quota = 0u;
    if (deficit != 0u)
    {
        uint accumulated = 0u;
        bool found = false;
        for (uint age = AGE_BINS - 1u; age >= 1u; --age)
        {
            const uint count = stats[STAT_AGE_HISTOGRAM + age];
            if (accumulated + count >= deficit)
            {
                evictAge = age;
                quota = deficit - accumulated;
                found = true;
                break;
            }
            accumulated += count;
        }
        if (!found)
        {
            evictAge = 1u;
            quota = stats[STAT_AGE_HISTOGRAM + 1u];
        }
    }
    stats[STAT_EVICT_AGE] = evictAge;
    stats[STAT_EVICT_QUOTA] = quota;
}

void Evict()
{
    const uint entryIndex = gl_GlobalInvocationID.x;
    if (entryIndex >= TotalEntries())
    {
        return;
    }
    const uint evictAge = stats[STAT_EVICT_AGE];
    if (evictAge >= AGE_BINS)
    {
        return;
    }
    const uint entry = pageTable[entryIndex];
    if ((entry & PAGE_ENTRY_ALLOCATED) == 0u || IsRequested(entryIndex))
    {
        return;
    }
    const uint age = freeList[AgeIndex(entry & PAGE_INDEX_MASK)];
    if (age > evictAge)
    {
        ReleaseEntry(entryIndex);
    }
    else if (age == evictAge && atomicAdd(stats[STAT_EVICT_TAKEN], 1u) < stats[STAT_EVICT_QUOTA])
    {
        ReleaseEntry(entryIndex);
    }
}

void FreeReset()
{
    const uint index = gl_GlobalInvocationID.x;
    const uint pages = params.control.y;
    if (index < pages)
    {
        freeList[UsedFlagIndex(index)] = 0u;
    }
    if (index == 0u)
    {
        freeList[0] = 0u;
        dirtyList[DIRTY_COUNT] = 0u;
    }
}

void FreeMark()
{
    const uint entryIndex = gl_GlobalInvocationID.x;
    if (entryIndex >= TotalEntries())
    {
        return;
    }
    const uint entry = pageTable[entryIndex];
    if ((entry & PAGE_ENTRY_ALLOCATED) == 0u)
    {
        return;
    }
    const uint physical = entry & PAGE_INDEX_MASK;
    if (physical < params.control.y)
    {
        freeList[UsedFlagIndex(physical)] = 1u;
    }
}

void FreeCompact()
{
    const uint index = gl_GlobalInvocationID.x;
    if (index >= params.control.y || freeList[UsedFlagIndex(index)] != 0u)
    {
        return;
    }
    const uint slot = atomicAdd(freeList[0], 1u);
    freeList[1u + slot] = index;
}

void Allocate()
{
    const uint wordIndex = gl_GlobalInvocationID.x;
    if (wordIndex >= params.screen.z * WORDS_PER_LEVEL)
    {
        return;
    }
    const uint bits = requestBits[wordIndex];
    if (bits == 0u)
    {
        return;
    }

    atomicOr(stats[STAT_LEVELS_USED], 1u << (wordIndex / WORDS_PER_LEVEL));
    atomicAdd(stats[STAT_REQUESTED], uint(bitCount(bits)));

    // この語の、まだ割り当ての無い欄の数。その数ぶんの通し番号を取り、空きの一覧の後ろから順に割り当てる
    uint unallocated = 0u;
    for (uint remaining = bits; remaining != 0u; remaining &= remaining - 1u)
    {
        const uint bit = uint(findLSB(remaining));
        if ((pageTable[wordIndex * 32u + bit] & PAGE_ENTRY_ALLOCATED) == 0u)
        {
            ++unallocated;
        }
    }
    if (unallocated == 0u)
    {
        return;
    }
    const uint base = atomicAdd(stats[STAT_ALLOC_CURSOR], unallocated);
    const uint freeCount = freeList[0];

    uint ordinal = base;
    for (uint remaining = bits; remaining != 0u; remaining &= remaining - 1u)
    {
        const uint bit = uint(findLSB(remaining));
        const uint entryIndex = wordIndex * 32u + bit;
        if ((pageTable[entryIndex] & PAGE_ENTRY_ALLOCATED) != 0u)
        {
            continue;
        }
        if (ordinal < freeCount)
        {
            // 空きの一覧の後ろから ordinal 番目（一覧の語は 1 から始まるので、最後の語は freeCount）
            const uint physical = freeList[freeCount - ordinal];
            pageTable[entryIndex] = PAGE_ENTRY_ALLOCATED | PAGE_ENTRY_DIRTY | physical;
            freeList[AgeIndex(physical)] = 0u;
        }
        ++ordinal;
    }
}

void DirtyList()
{
    const uint entryIndex = gl_GlobalInvocationID.x;
    if (entryIndex >= TotalEntries())
    {
        return;
    }
    const uint entry = pageTable[entryIndex];
    if ((entry & PAGE_ENTRY_ALLOCATED) == 0u)
    {
        return;
    }
    if ((entry & PAGE_ENTRY_DIRTY) != 0u)
    {
        const uint slot = atomicAdd(dirtyList[DIRTY_COUNT], 1u);
        dirtyList[DIRTY_FIRST_PAGE + slot] = entry & PAGE_INDEX_MASK;
    }
    else if (IsRequested(entryIndex))
    {
        atomicAdd(stats[STAT_CACHED], 1u);
    }
}

void Finalize()
{
    if (gl_GlobalInvocationID.x != 0u)
    {
        return;
    }
    const uint requested = stats[STAT_REQUESTED];
    const uint need = stats[STAT_NEED];
    const uint freeCount = freeList[0];
    const uint newlyAllocated = min(need, freeCount);
    const uint overflow = need - newlyAllocated;
    stats[STAT_ALLOCATED] = requested - overflow;
    stats[STAT_OVERFLOW] = overflow;
    freeList[0] = freeCount - newlyAllocated;

    const uint rendered = dirtyList[DIRTY_COUNT];
    stats[STAT_RENDERED] = rendered;
    const uint groupLimit = max(params.control.z, 1u);
    dirtyList[0] = min(rendered, groupLimit);
    dirtyList[1] = rendered == 0u ? 1u : (rendered + groupLimit - 1u) / groupLimit;
    dirtyList[2] = 1u;
}

void main()
{
    const uint stage = params.control.x;
    if (stage == STAGE_SCROLL)
    {
        Scroll();
    }
    else if (stage == STAGE_RECTS)
    {
        InvalidateRects();
    }
    else if (stage == STAGE_AGE)
    {
        Age();
    }
    else if (stage == STAGE_EVICT_PLAN)
    {
        EvictPlan();
    }
    else if (stage == STAGE_EVICT)
    {
        Evict();
    }
    else if (stage == STAGE_FREE_RESET)
    {
        FreeReset();
    }
    else if (stage == STAGE_FREE_MARK)
    {
        FreeMark();
    }
    else if (stage == STAGE_FREE_COMPACT)
    {
        FreeCompact();
    }
    else if (stage == STAGE_ALLOCATE)
    {
        Allocate();
    }
    else if (stage == STAGE_DIRTY_LIST)
    {
        DirtyList();
    }
    else if (stage == STAGE_FINALIZE)
    {
        Finalize();
    }
}
