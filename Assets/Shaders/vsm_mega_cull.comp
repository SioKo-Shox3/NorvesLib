#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

// ========================================
// 仮想シャドウマップ（VSM）の、MegaGeometry の投影物（bCastShadow のインスタンス）のスライス（太陽の段・点光源の面）ごとのカリング
//
// 主の経路（cluster_cull.comp・cluster_bvh_cull.comp）のインスタンスの表（binding 1）とページの表（binding 11）を読み、
// （インスタンス、段、クラスタ）の一覧（binding 15）を作る。主の経路の間接描画・見えた印・ページの要求・統計には何も書かない
// （同じ判定の本体 Common/MegaGeometryCull.glsl の LOD の判定を、cullData.orthoLod = 1 の正射影で使う）。
//
// 事前の絞り込み（vsm_mega_cull_pairs.comp）が、(1) のインスタンスの判定を通した（インスタンス、スライス）の組の一覧（binding 21）を作る。
// このシェーダーは通った組だけを間接 dispatch で受け持つ。1 ワークグループ（64 スレッド）= 1 つの組の連続した 64 クラスタ。
// dispatch は（組の数 × 通った組の最大のワークグループ数を 2 次元に折った x, y）。通し番号を最大のワークグループ数で割って組の番号と組の中の
// ワークグループの番号を求め、影の表（binding 18）の firstGroup（そのインスタンスの最初のワークグループの通し番号）の差から組の
// ワークグループの数を求めて、足りない分は何もしない。影を落とさないインスタンスは組に入らない。
// スライスの投影の種類（extra.z）で判定が変わる。太陽の段（正射影）は下の「判定」、点光源の面（透視）は下の「点光源の面」。
// BVH を持つメッシュも、ここでは平らなクラスタの列として全部見る（BVH をたどる影の判定は後の項目）。
//
// 判定:
//   (1) インスタンス（事前の絞り込み）: 境界（WorldBounds）のライト空間の矩形が、その段の範囲・深度の範囲に入り、dirty のページを 1 つでも含む
//       （dirty の階層 = ページの mip。vsm_dirty_mips.comp が作る）。境界が無いインスタンスはこの判定を通す。
//   (2) クラスタ: 境界の球が、その段の範囲・深度の範囲に入り、dirty のページを含み、LOD の判定（ShouldDrawShadowCluster）を通る。
//       LOD は正射影: 自分の誤差 ÷ その段の texel の一辺 ≤ 1 texel（lodBias）かつ親の誤差 ÷ texel > 1 texel。
//       子のページが非常駐なら自分を描き、ページの要求は出さない。HZB・法線の円錐・ソフトウェアラスタの振り分けは使わない。
//
// 点光源の面（透視のスライス）:
//   (1)(2) の「段の範囲・深度の範囲に入る」は、球が光源の Range の内側で面の錐台（近い平面・遠い平面・4 つの側面）と交わること、
//       「dirty のページを含む」は、球を面へ透視で写した矩形（展開と同じ VsmPerspectivePageRange）が覆うページに
//       dirty のページがあること（面は 128 × 128 のうち一辺 origin.w ページだけを使う。階層は相対の座標 = 面のページの座標）。
//   LOD は透視: 自分の誤差 ÷ texel ≤ 1 texel かつ親の誤差 ÷ texel > 1 texel。texel は球の最も近い点の面の軸の向きの距離 z での
//       2z ÷ 段の解像度（光源から遠いほど粗いクラスタを選ぶ）。影のためのページの要求はしない。
//
// 一覧の容量を超えて書けなかったクラスタは、そのクラスタの境界が覆う、その段の割り当て済みで dirty のページへ再描画の印
// （VSM_MEGA_PAGE_ENTRY_RETRY。binding 19 の VSM のページの表へ atomicOr する）を付ける。次フレームの引き継ぎ（vsm_allocate.comp）が
// 印のあるページへ dirty を付け直すので、欠けた影が静止した場面で持ち越されず、描き直される。
//
// 出力（binding 15）の並び: [0] = 選んだクラスタの数（容量を超えた分を含む。書いた件数は min(値, 容量)）、[1] = 容量を超えて
// 書かなかった数、[2] = 判定（1）を通った（インスタンス、段）の数、[3] = 予約。続いて uvec4（x = インスタンスの表の番号、
// y = 段、z = クラスタの番号、w = 0）が並ぶ。呼ぶ前に、頭の 4 語を 0 にしておくこと。
// 統計（binding 17）の語 8 = 判定（1）を通った（インスタンス、段）の数（事前の絞り込みが数える。[2] も同じ）、9 = 書いたクラスタの数、
// 10 = 溢れて書かなかった数。
// ========================================

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "Common/MegaGeometryCull.glsl"
// binding 20: スライスの表（ページの一辺・texel・範囲の原点・ページの表の先頭）
#define VSM_SLICE_BINDING 20
#include "Common/VirtualShadowMapMegaCull.glsl"
#include "Common/VirtualShadowMapMegaSphere.glsl"

// binding 15: 出力の一覧
layout(std430, set = 0, binding = 15) buffer VsmMegaList
{
    uint listSelected;
    uint listOverflow;
    uint listInstanceLevels;
    uint listReserved;
    uvec4 listEntries[];
};

// binding 21: 事前の絞り込み（vsm_mega_cull_pairs.comp）が作った（インスタンス、スライス）の組の一覧。
// 組 = (インスタンスの表の番号 << 8) | スライスの番号。pairMaxGroups = 通った組のワークグループ数の最大。
layout(std430, set = 0, binding = 21) readonly buffer VsmMegaPairs
{
    uint pairCount;
    uint pairMaxGroups;
    uint pairReserved0;
    uint pairReserved1;
    uint pairArgs[4];
    uint pairEntries[];
};

// binding 17: VSM の統計
layout(std430, set = 0, binding = 17) buffer VsmStats
{
    uint vsmStats[];
};
const uint STAT_MEGA_INSTANCES = 8u;
const uint STAT_MEGA_CLUSTERS = 9u;
const uint STAT_MEGA_OVERFLOW = 10u;
// 透視のスライス（点光源の面）だけの数（STAT_MEGA_INSTANCES・STAT_MEGA_CLUSTERS はこれを含む合計）
const uint STAT_MEGA_POINT_INSTANCES = 56u;
const uint STAT_MEGA_POINT_CLUSTERS = 57u;

// binding 18: 影の表（インスタンスの表と同じ並び。構造は Common/VirtualShadowMapMegaCull.glsl の ShadowInstance）
layout(std430, set = 0, binding = 18) readonly buffer ShadowInstanceBuffer
{
    ShadowInstance shadowInstances[];
};

// binding 19: VSM のページの表。溢れて書けなかったクラスタの範囲のページへ再描画の印を atomicOr で書く
// （割り当て済み・dirty・物理ページの番号の欄は変えない。MegaGeometryCull.glsl の pageTable（binding 11。ジオメトリのページの表）とは別のバッファ）
layout(std430, set = 0, binding = 19) buffer VsmPageTable
{
    uint vsmPageTable[];
};

/**
 * @brief 溢れて一覧に書けなかったクラスタの球が覆う、割り当て済みで dirty のページへ再描画の印を付ける
 *
 * 覆うページの範囲は SphereHasDirtyPage と同じ（範囲の外へはみ出す分は切り捨てる）。ほかのスレッドも同じ欄へ印を書くので、
 * 判定の読み取りも atomicOr で行う。溢れたときだけ通る経路なので、範囲を 1 スレッドで走査する。
 */
void MarkRetryPages(uint level, vec3 center, float radius)
{
    const VsmSlice slice = vsmSlices[level];
    const ivec2 origin = slice.origin.xy;
    ivec2 low;
    ivec2 high;
    if (!SphereRelativePageRange(slice, center, radius, low, high))
    {
        return;
    }
    for (int y = low.y; y <= high.y; ++y)
    {
        for (int x = low.x; x <= high.x; ++x)
        {
            // 範囲の最小のページからの相対の座標を、絶対のページを経てページの表の番地（スライスの先頭 + トーラスの番地）へ直す
            const uint entryIndex = VsmSliceEntryIndex(slice, origin.x + x, origin.y + y);
            const uint entry = atomicOr(vsmPageTable[entryIndex], 0u);
            if ((entry & VSM_MEGA_PAGE_ENTRY_ALLOCATED) != 0u && (entry & VSM_MEGA_PAGE_ENTRY_DIRTY) != 0u)
            {
                atomicOr(vsmPageTable[entryIndex], VSM_MEGA_PAGE_ENTRY_RETRY);
            }
        }
    }
}

void main()
{
    // 事前の絞り込み（vsm_mega_cull_pairs.comp）が通した（インスタンス、スライス）の組ごとに、組の最大のワークグループ数 pairMaxGroups
    // ぶんを並べて出している。通し番号 = 組の番号 × pairMaxGroups + 組の中のワークグループの番号
    // （dispatch は x 方向の上限を避けて 2 次元の間接 dispatch）
    const uint flatGroup = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    const uint maxGroups = pairMaxGroups;
    if (maxGroups == 0u)
    {
        return;
    }
    const uint pairIndex = flatGroup / maxGroups;
    const uint groupInInstance = flatGroup - pairIndex * maxGroups;
    if (pairIndex >= pairCount)
    {
        return;
    }
    const uint pair = pairEntries[pairIndex];
    const uint instanceIndex = pair >> 8u;
    const uint level = pair & 0xFFu;
    const VsmSlice levelSlice = vsmSlices[level];
    const bool bPerspective = IsPerspectiveSlice(levelSlice);

    // 組のワークグループの数は、次のインスタンスの最初のワークグループの番号との差（最後のインスタンスは全体の数との差）
    const uint firstGroup = shadowInstances[instanceIndex].info.x;
    const uint endGroup = instanceIndex + 1u < cullData.instanceCount ? shadowInstances[instanceIndex + 1u].info.x : megaParams.counts.z;
    if (groupInInstance >= endGroup - firstGroup)
    {
        return;
    }
    const MegaInstance instance = instances[instanceIndex];

    // (2) クラスタの判定
    const uint clusterIndex = groupInInstance * 64u + gl_LocalInvocationID.x;
    if (clusterIndex >= instance.clusterInfo.z)
    {
        return;
    }
    g_WorldMatrix = instance.world;
    g_LODSphere = instance.lodSphere;
    g_Clusters = ClusterArray(uvec2(instance.clusterInfo.x, instance.clusterInfo.y));
    g_OrthoTexelMeters = levelSlice.info.y;
    g_ShadowPerspective = bPerspective;
    g_ShadowAxisZ = levelSlice.axisZ;
    g_ShadowTexelNdc = levelSlice.info.y;
    g_ShadowNearPlane = levelSlice.info.w;

    const GPUClusterData cluster = g_Clusters.clusters[clusterIndex];
    const vec3 center = TransformClusterCenterToWorld(cluster.boundsSphere.xyz);
    const float radius = cluster.boundsSphere.w * ComputeWorldRadiusScale();
    if (!LevelOverlapsSphere(level, center, radius) || !SphereHasDirtyPage(level, center, radius) ||
        !ShouldDrawShadowCluster(cluster, center, instance.bvhInfo.w))
    {
        return;
    }

    const uint slot = atomicAdd(listSelected, 1u);
    if (slot < megaParams.counts.y)
    {
        listEntries[slot] = uvec4(instanceIndex, level, clusterIndex, 0u);
        atomicAdd(vsmStats[STAT_MEGA_CLUSTERS], 1u);
        if (bPerspective)
        {
            atomicAdd(vsmStats[STAT_MEGA_POINT_CLUSTERS], 1u);
        }
    }
    else
    {
        atomicAdd(listOverflow, 1u);
        atomicAdd(vsmStats[STAT_MEGA_OVERFLOW], 1u);
        MarkRetryPages(level, center, radius);
    }
}
