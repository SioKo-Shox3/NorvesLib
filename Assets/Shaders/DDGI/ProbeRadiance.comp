// DDGIプローブrayのhit材質・直接光とmiss環境からscene-linear radianceを計算する。
// radianceのalphaは面の表に当たったrayとmissで1、面の裏に当たったrayで0（probeの分類に使う）。
#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "Common/RayTracingInstanceMask.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT sceneTopLevel;

layout(set = 0, binding = 1, std140) uniform ProbeRayQueryParameters
{
    vec4 volumeOrigin;
    vec4 probeSpacing;
    uvec4 probeCounts;
    vec4 rayLimits;
    uvec4 sceneCounts;
    vec4 environmentParameters;
} parameters;

struct ProbeRayQueryResult
{
    float distance;
    uint hit;
    uint instanceCustomIndex;
    uint primitiveIndex;
    vec4 radiance;
};

struct ProbeRayInstanceData
{
    uint64_t vertexAddress;
    uint64_t indexAddress;
    vec4 baseColor;
    vec4 emissiveChromaticityAndLuminance;
    uvec4 geometry;
    vec4 transform0;
    vec4 transform1;
    vec4 transform2;
};

struct LightData
{
    vec4 position;
    vec4 direction;
    vec4 chromaticityAndIntensity;
    vec4 attenuation;
};

layout(set = 0, binding = 2, std430) buffer ProbeRayQueryResults
{
    ProbeRayQueryResult values[];
} results;

layout(set = 0, binding = 3, std430) readonly buffer ProbeRayInstances
{
    ProbeRayInstanceData values[];
} instances;

layout(set = 0, binding = 4, std430) readonly buffer ProbeRayLights
{
    LightData values[];
} lights;

layout(set = 0, binding = 5) uniform sampler2D environmentRadiance;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer ProbeRayVertexData
{
    float values[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer ProbeRayIndexData
{
    uint values[];
};

const float GoldenAngleRadians = 2.39996322972865332;
const float Pi = 3.14159265358979323846;
// hit面の発光面の直接光で三角形を分ける数（辺ごと）。
const uint HitEmitterSubdivision = 1u;
const uint InvalidHitAttribute = 0xFFFFFFFFu;

vec3 GetProbeRayDirection(uint directionIndex)
{
    float sampleValue = (float(directionIndex) + 0.5) / float(parameters.probeCounts.w);
    float z = 1.0 - 2.0 * sampleValue;
    float radius = sqrt(max(0.0, 1.0 - z * z));
    float angle = GoldenAngleRadians * float(directionIndex);
    return vec3(radius * cos(angle), radius * sin(angle), z);
}

vec2 EquirectangularUV(vec3 direction)
{
    vec2 uv = vec2(atan(direction.z, direction.x),
                   asin(clamp(-direction.y, -1.0, 1.0)));
    return uv * vec2(0.15915494, 0.31830989) + 0.5;
}

bool TryGetInstanceData(uint customIndex, out ProbeRayInstanceData instanceData)
{
    uint low = 0u;
    uint high = parameters.sceneCounts.x;
    while (low < high)
    {
        uint middle = low + (high - low) / 2u;
        uint candidateIndex = instances.values[middle].geometry.w;
        if (candidateIndex < customIndex)
        {
            low = middle + 1u;
        }
        else
        {
            high = middle;
        }
    }

    if (low >= parameters.sceneCounts.x ||
        instances.values[low].geometry.w != customIndex)
    {
        return false;
    }
    instanceData = instances.values[low];
    return true;
}

bool TryGetWorldTriangleNormal(rayQueryEXT query,
                               uint primitiveIndex,
                               ProbeRayInstanceData instanceData,
                               out vec3 worldNormal)
{
    uint vertexStrideBytes = instanceData.geometry.x;
    uint vertexCount = instanceData.geometry.y;
    uint indexCount = instanceData.geometry.z;
    if (vertexStrideBytes < 12u || (vertexStrideBytes & 3u) != 0u ||
        primitiveIndex >= indexCount / 3u)
    {
        return false;
    }

    ProbeRayIndexData indexBuffer = ProbeRayIndexData(instanceData.indexAddress);
    uint primitiveOffset = primitiveIndex * 3u;
    uvec3 vertexIndices = uvec3(indexBuffer.values[primitiveOffset],
                                indexBuffer.values[primitiveOffset + 1u],
                                indexBuffer.values[primitiveOffset + 2u]);
    if (vertexIndices.x >= vertexCount || vertexIndices.y >= vertexCount ||
        vertexIndices.z >= vertexCount)
    {
        return false;
    }

    ProbeRayVertexData vertexBuffer = ProbeRayVertexData(instanceData.vertexAddress);
    uint stride = vertexStrideBytes / 4u;
    uint vertex0Offset = vertexIndices.x * stride;
    uint vertex1Offset = vertexIndices.y * stride;
    uint vertex2Offset = vertexIndices.z * stride;
    vec3 vertex0 = vec3(vertexBuffer.values[vertex0Offset],
                        vertexBuffer.values[vertex0Offset + 1u],
                        vertexBuffer.values[vertex0Offset + 2u]);
    vec3 vertex1 = vec3(vertexBuffer.values[vertex1Offset],
                        vertexBuffer.values[vertex1Offset + 1u],
                        vertexBuffer.values[vertex1Offset + 2u]);
    vec3 vertex2 = vec3(vertexBuffer.values[vertex2Offset],
                        vertexBuffer.values[vertex2Offset + 1u],
                        vertexBuffer.values[vertex2Offset + 2u]);
    vec3 objectNormal = cross(vertex1 - vertex0, vertex2 - vertex0);
    float normalLengthSquared = dot(objectNormal, objectNormal);
    if (isnan(normalLengthSquared) || isinf(normalLengthSquared) ||
        normalLengthSquared <= 1.0e-12)
    {
        return false;
    }

    mat4x3 worldToObject = rayQueryGetIntersectionWorldToObjectEXT(query, true);
    worldNormal = normalize(transpose(mat3(worldToObject)) * normalize(objectNormal));
    return !any(isnan(worldNormal)) && !any(isinf(worldNormal));
}

#include "DDGI/ProbeEmitterSampling.glsl"

float CalculateInverseSquareAttenuation(float distanceToLight)
{
    return 1.0 / max(distanceToLight * distanceToLight, 0.0001);
}

float CalculateRangeWindow(float distanceToLight, float range)
{
    float safeRange = max(range, 0.0001);
    float window = max(1.0 - pow(distanceToLight / safeRange, 4.0), 0.0);
    return window * window;
}

bool IsOccluded(vec3 worldPosition, vec3 normal, vec3 lightDirection, float maxDistance)
{
    if (maxDistance <= parameters.rayLimits.x)
    {
        return false;
    }

    vec3 rayOrigin = worldPosition + normal * parameters.rayLimits.z;
    rayQueryEXT shadowQuery;
    rayQueryInitializeEXT(shadowQuery,
                          sceneTopLevel,
                          gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
                          RayTracingInstanceMaskShadowCaster,
                          rayOrigin,
                          parameters.rayLimits.x,
                          lightDirection,
                          maxDistance);
    while (rayQueryProceedEXT(shadowQuery))
    {
    }
    return rayQueryGetIntersectionTypeEXT(shadowQuery, true) ==
           gl_RayQueryCommittedIntersectionTriangleEXT;
}

vec3 ComputeDirectRadiance(vec3 worldPosition,
                           vec3 normal,
                           vec3 baseColor,
                           uint receiverCustomIndex,
                           uint lightCount)
{
    vec3 diffuseRadiance = vec3(0.0);
    for (uint lightIndex = 0u; lightIndex < lightCount; ++lightIndex)
    {
        LightData light = lights.values[lightIndex];
        float lightType = light.position.w;
        vec3 lightDirection;
        float attenuation = 1.0;
        float shadowRayDistance = parameters.rayLimits.w;

        if (lightType < 0.5)
        {
            float directionLengthSquared = dot(light.direction.xyz, light.direction.xyz);
            if (directionLengthSquared <= 1.0e-12)
            {
                continue;
            }
            lightDirection = -light.direction.xyz * inversesqrt(directionLengthSquared);
        }
        else if (lightType < 2.5)
        {
            vec3 toLight = light.position.xyz - worldPosition;
            float distanceToLight = length(toLight);
            if (distanceToLight <= 1.0e-6)
            {
                continue;
            }
            lightDirection = toLight / distanceToLight;
            attenuation = CalculateInverseSquareAttenuation(distanceToLight) *
                          CalculateRangeWindow(distanceToLight, light.attenuation.x);
            shadowRayDistance = max(distanceToLight - parameters.rayLimits.z * 2.0, 0.0);

            if (lightType >= 1.5)
            {
                float spotDirectionLengthSquared = dot(light.direction.xyz, light.direction.xyz);
                if (spotDirectionLengthSquared <= 1.0e-12)
                {
                    continue;
                }
                vec3 lightToSurfaceDirection =
                    -light.direction.xyz * inversesqrt(spotDirectionLengthSquared);
                float theta = dot(lightDirection, lightToSurfaceDirection);
                float coneWidth = max(light.direction.w - light.attenuation.y, 0.001);
                attenuation *= clamp((theta - light.attenuation.y) / coneWidth, 0.0, 1.0);
            }
        }
        else
        {
            continue;
        }

        float cosine = max(dot(normal, lightDirection), 0.0);
        if (cosine <= 0.0 || attenuation <= 0.0 ||
            IsOccluded(worldPosition, normal, lightDirection, shadowRayDistance))
        {
            continue;
        }

        vec3 lightRadiance = light.chromaticityAndIntensity.rgb *
                             light.chromaticityAndIntensity.w;
        diffuseRadiance += (baseColor / Pi) * lightRadiance * (cosine * attenuation);
    }
    // 発光面の直接光（hit面の直下の1バウンス）。三角形の重心1点で見積もる。
    diffuseRadiance += (baseColor / Pi) *
                       ComputeEmitterIrradiance(worldPosition,
                                                worldPosition + normal * parameters.rayLimits.z,
                                                normal,
                                                receiverCustomIndex,
                                                parameters.sceneCounts.x,
                                                HitEmitterSubdivision);
    return diffuseRadiance;
}

void main()
{
    uint rayIndex = gl_GlobalInvocationID.x;
    uint rayCount = parameters.probeCounts.x * parameters.probeCounts.y *
                    parameters.probeCounts.z * parameters.probeCounts.w;
    if (rayIndex >= rayCount)
    {
        return;
    }

    uint directionIndex = rayIndex % parameters.probeCounts.w;
    uint probeIndex = rayIndex / parameters.probeCounts.w;
    uint probePlaneSize = parameters.probeCounts.x * parameters.probeCounts.y;
    uvec3 probeCoordinates = uvec3(
        probeIndex % parameters.probeCounts.x,
        (probeIndex / parameters.probeCounts.x) % parameters.probeCounts.y,
        probeIndex / probePlaneSize);
    vec3 rayOrigin = parameters.volumeOrigin.xyz +
                     parameters.probeSpacing.xyz * vec3(probeCoordinates);
    vec3 rayDirection = GetProbeRayDirection(directionIndex);

    rayQueryEXT query;
    rayQueryInitializeEXT(query,
                          sceneTopLevel,
                          gl_RayFlagsOpaqueEXT,
                          RayTracingInstanceMaskShadowCaster,
                          rayOrigin,
                          parameters.rayLimits.x,
                          rayDirection,
                          parameters.rayLimits.y);
    while (rayQueryProceedEXT(query))
    {
    }

    uint intersectionType = rayQueryGetIntersectionTypeEXT(query, true);
    bool bHit = intersectionType == gl_RayQueryCommittedIntersectionTriangleEXT;
    results.values[rayIndex].distance = bHit
        ? rayQueryGetIntersectionTEXT(query, true)
        : -1.0;
    results.values[rayIndex].hit = bHit ? 1u : 0u;
    results.values[rayIndex].instanceCustomIndex = bHit
        ? uint(rayQueryGetIntersectionInstanceCustomIndexEXT(query, true))
        : InvalidHitAttribute;
    results.values[rayIndex].primitiveIndex = bHit
        ? rayQueryGetIntersectionPrimitiveIndexEXT(query, true)
        : InvalidHitAttribute;

    if (!bHit)
    {
        vec3 missRadiance = vec3(0.0);
        if (parameters.sceneCounts.z != 0u)
        {
            missRadiance = textureLod(environmentRadiance,
                                      EquirectangularUV(rayDirection),
                                      0.0).rgb * parameters.environmentParameters.x;
        }
        results.values[rayIndex].radiance = vec4(max(missRadiance, vec3(0.0)), 1.0);
        return;
    }

    ProbeRayInstanceData instanceData;
    vec3 worldNormal;
    uint customIndex = results.values[rayIndex].instanceCustomIndex;
    uint primitiveIndex = results.values[rayIndex].primitiveIndex;
    vec3 hitRadiance = vec3(0.0);
    bool bBackfaceHit = false;
    if (TryGetInstanceData(customIndex, instanceData) &&
        TryGetWorldTriangleNormal(query, primitiveIndex, instanceData, worldNormal))
    {
        // 面の表はラスタの裏面カリング（時計回りが表）と同じで、頂点順の外積の向きへ進むrayが表に当たる。
        // 逆向きのrayは面の裏（閉じた物体の内側や壁の外）に当たる。
        bBackfaceHit = dot(worldNormal, rayDirection) < 0.0;
        if (dot(worldNormal, rayDirection) > 0.0)
        {
            worldNormal = -worldNormal;
        }
        vec3 worldPosition = rayOrigin + rayDirection * results.values[rayIndex].distance;
        vec3 emissiveRadiance = instanceData.emissiveChromaticityAndLuminance.rgb *
                                instanceData.emissiveChromaticityAndLuminance.a;
        hitRadiance = emissiveRadiance +
                      ComputeDirectRadiance(worldPosition,
                                            worldNormal,
                                            instanceData.baseColor.rgb,
                                            customIndex,
                                            parameters.sceneCounts.y);
    }
    results.values[rayIndex].radiance = vec4(max(hitRadiance, vec3(0.0)),
                                             bBackfaceHit ? 0.0 : 1.0);
}
