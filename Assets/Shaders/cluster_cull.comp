#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

// ========================================
// Mega Geometry クラスタカリング コンピュートシェーダー（平らなクラスタの列を判定する経路）
//
// グループの BVH を持たないメッシュ（NVMESH v1.0・v0・実行時に構築した階層・手続きの球）のインスタンスを、
// 1回の dispatch で全部処理する（1パスにつき1回）。BVH を持つメッシュは cluster_bvh_cull.comp が受け持つので、
// そのインスタンスはワークグループを持たない（インスタンスの表の clusterInfo.w が次のインスタンスと同じ）。
// 入力: インスタンスの表SSBO（変換・メッシュのクラスタ配列のアドレス・材質の区間の番号など）+ カメラ情報UBO
//       （+ 2パス時は「前のフレームで見えた」印とHi-Z）
// 出力: 材質の区間ごとの IndirectDraw コマンド + 区間ごとの可視クラスタ数カウンタ + コマンドごとの描画情報
//
// ワークグループ（64スレッド）は1つのインスタンスの連続した64クラスタを受け持つ。ワークグループの通し番号から、
// インスタンスの表の firstGroup（そのインスタンスの最初のワークグループの通し番号）を二分探索して、
// 受け持つインスタンスとクラスタの番号を求める。判定の本体は Common/MegaGeometryCull.glsl の ProcessCluster。
// ========================================

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "Common/MegaGeometryCull.glsl"

void main()
{
    // ワークグループの通し番号（dispatch は x 方向の上限を避けて 2 次元で出す）
    uint flatGroup = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    if (flatGroup >= cullData.totalGroupCount || cullData.instanceCount == 0u)
    {
        return;
    }

    // firstGroup が flatGroup 以下の最後のインスタンスを二分探索で求める（表は firstGroup の昇順）。
    // ワークグループを持たない（BVH の）インスタンスは次のインスタンスと firstGroup が同じなので、最後のものが選ばれて飛ばされる
    uint low = 0u;
    uint high = cullData.instanceCount - 1u;
    while (low < high)
    {
        uint mid = (low + high + 1u) >> 1u;
        if (instances[mid].clusterInfo.w <= flatGroup)
        {
            low = mid;
        }
        else
        {
            high = mid - 1u;
        }
    }

    uint instanceIndex = low;
    MegaInstance instance = instances[instanceIndex];
    uint clusterIndex = (flatGroup - instance.clusterInfo.w) * 64u + gl_LocalInvocationID.x;
    if (clusterIndex >= instance.clusterInfo.z)
    {
        return;
    }

    g_WorldMatrix = instance.world;
    g_LODSphere = instance.lodSphere;
    g_Clusters = ClusterArray(uvec2(instance.clusterInfo.x, instance.clusterInfo.y));

    ProcessCluster(instanceIndex, instance, clusterIndex);
}
